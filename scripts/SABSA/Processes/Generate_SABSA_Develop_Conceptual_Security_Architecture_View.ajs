var File = Java.type("java.io.File");
var Files = Java.type("java.nio.file.Files");
var Paths = Java.type("java.nio.file.Paths");
var StandardCharsets = Java.type("java.nio.charset.StandardCharsets");

load(new File(__DIR__ + "../../lib/logging/Logger.js").getCanonicalPath());
load(new File(__DIR__ + "../../lib/ui/DialogHelpers.js").getCanonicalPath());

var SCRIPT_NAME = "Generate_SABSA_Develop_Conceptual_Security_Architecture_View";
var LOG_LEVEL = "WARN";
var logger = ArchiLogging.createLogger(SCRIPT_NAME, {
    clearConsole: true,
    minimumLevel: LOG_LEVEL
});
var dialogs = ArchiDialogs.createDialogService(logger, {
    title: "SABSA Develop Conceptual Security Architecture"
});

var CONST = {
    SourceJsonPath: new File(__DIR__ + "../../../data/sabsa/sabsa-develop-conceptual-security-architecture-data.json").getCanonicalPath(),
    SourceMarkdownPath: new File(__DIR__ + "../../../../analyse/sabsa/develop-conceptual-security-architecture/SABSA_Develop_Conceptual_Security_Architecture.md").getCanonicalPath(),
    ViewName: "SABSA - Develop Conceptual Security Architecture",
    Folder: {
        Root: "SABSA",
        Processes: "Processes",
        ProcessName: "Develop Conceptual Security Architecture",
        Main: "Main Process",
        Steps: "Steps",
        Subprocesses: "Subprocesses",
        Artifacts: "Artifacts",
        Inputs: "Inputs",
        Outputs: "Outputs",
        Relations: {
            Composition: "Composition",
            Triggering: "Triggering",
            Inputs: "Inputs",
            Outputs: "Outputs"
        }
    },
    Layout: {
        ViewMarginX: 40,
        ViewMarginY: 40,
        InputX: 40,
        StepInputX: 270,
        MainX: 520,
        StepOutputX: 1320,
        OutputX: 1580,
        MainY: 40,
        MainWidth: 760,
        MainMinHeight: 120,
        MainInnerX: 16,
        MainInnerY: 44,
        MainInnerRight: 16,
        MainInnerBottom: 16,
        InputWidth: 240,
        OutputWidth: 300,
        ArtifactMinHeight: 58,
        ArtifactGap: 18,
        StepArtifactWidth: 220,
        StepArtifactMinHeight: 42,
        StepArtifactGap: 8,
        StepWidth: 360,
        StepMinHeight: 58,
        StepGap: 12,
        StepInnerX: 12,
        StepInnerY: 28,
        StepInnerRight: 12,
        StepInnerBottom: 10,
        SubprocessStartGap: 6,
        SubprocessMinHeight: 32,
        SubprocessGap: 6
    },
    Style: {
        MainProcessFill: "#ffcc64",
        StepFill: "#ffff9a",
        SubprocessFill: "#fff6bf",
        InputFill: "#ccffff",
        OutputFill: "#ffff64",
        StepInputFill: "#dff7ff",
        StepOutputFill: "#fff0a6",
        NoteFill: "#f3f3f3",
        LineColor: "#111111",
        FontColor: "#111111"
    }
};

function loadSourceData() {
    var jsonText = String(new java.lang.String(
        Files.readAllBytes(Paths.get(CONST.SourceJsonPath)),
        StandardCharsets.UTF_8
    ));
    var data = JSON.parse(jsonText);

    if (!data || !data.process) {
        throw new Error("Invalid SABSA process data file: missing process object");
    }

    if (!data.steps || !data.steps.length) {
        throw new Error("Invalid SABSA process data file: missing steps");
    }

    if (!data.inputs) {
        data.inputs = [];
    }

    if (!data.outputs) {
        data.outputs = [];
    }

    return data;
}

var DATA = loadSourceData();

var stats = {
    processes: 0,
    artifacts: 0,
    views: 0,
    relationships: 0,
    conceptsCreated: 0,
    conceptsReused: 0,
    relationshipsCreated: 0,
    relationshipsReused: 0
};

function safeString(value) {
    return value === null || typeof value === "undefined" ? "" : String(value);
}

function trim(value) {
    return safeString(value).replace(/^\s+|\s+$/g, "");
}

function slugify(value) {
    return trim(value)
        .toLowerCase()
        .replace(/&/g, "and")
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/^-+|-+$/g, "");
}

function normalizeFolderName(folderName) {
    return safeString(folderName)
        .toLowerCase()
        .replace(/&/g, "and")
        .replace(/[^a-z0-9]+/g, " ")
        .replace(/\s+/g, " ")
        .trim();
}

function getTopLevelFolder(rootName) {
    var aliasesByFolderName = {
        "Business": ["Business"],
        "Views": ["Views"],
        "Relations": ["Relations", "Relations/Connectors", "Connectors"],
        "Implementation & Migration": ["Implementation & Migration", "Implementation and Migration"]
    };
    var candidateNames = aliasesByFolderName[rootName] || [rootName];
    var wantedNames = candidateNames.map(normalizeFolderName);
    var foundFolder = null;

    $(model).children("folder").each(function (folder) {
        if (foundFolder) {
            return;
        }

        if (wantedNames.indexOf(normalizeFolderName(folder.name)) >= 0) {
            foundFolder = folder;
        }
    });

    return foundFolder;
}

function ensureChildFolder(parentFolder, childName) {
    var childFolder = $(parentFolder).children("folder").filter(function (folder) {
        return safeString(folder.name) === safeString(childName);
    }).first();

    if (childFolder) {
        return childFolder;
    }

    return parentFolder.createFolder(childName);
}

function ensureFolderPath(rootName, pathSegments) {
    var currentFolder = getTopLevelFolder(rootName);

    if (!currentFolder) {
        throw new Error("Top-level folder not found: " + rootName);
    }

    (pathSegments || []).forEach(function (segment) {
        currentFolder = ensureChildFolder(currentFolder, segment);
    });

    return currentFolder;
}

function moveObjectToFolder(rootName, pathSegments, objectToMove) {
    var targetFolder;

    if (!objectToMove) {
        return null;
    }

    targetFolder = ensureFolderPath(rootName, pathSegments);
    targetFolder.add(objectToMove);
    return targetFolder;
}

function getProcessFolderSegments(extraSegments) {
    var segments = [CONST.Folder.Root, CONST.Folder.Processes, CONST.Folder.ProcessName];

    (extraSegments || []).forEach(function (segment) {
        segments.push(segment);
    });

    return segments;
}

function resolveConceptPlacement(conceptType, properties) {
    var role = safeString(properties && properties.ProcessViewRole);

    if (conceptType === "business-process") {
        if (role === "MainProcess") {
            return { rootName: "Business", pathSegments: getProcessFolderSegments([CONST.Folder.Main]) };
        }

        if (role === "StepProcess") {
            return { rootName: "Business", pathSegments: getProcessFolderSegments([CONST.Folder.Steps]) };
        }

        return { rootName: "Business", pathSegments: getProcessFolderSegments([CONST.Folder.Subprocesses]) };
    }

    if (conceptType === "business-object") {
        if (role === "Artifact") {
            return { rootName: "Business", pathSegments: getProcessFolderSegments([CONST.Folder.Artifacts]) };
        }

        if (role === "InputArtifact") {
            return { rootName: "Business", pathSegments: getProcessFolderSegments([CONST.Folder.Inputs]) };
        }

        if (role === "OutputArtifact") {
            return { rootName: "Business", pathSegments: getProcessFolderSegments([CONST.Folder.Outputs]) };
        }
    }

    if (conceptType === "work-package" && role === "OutputArtifact") {
        return { rootName: "Implementation & Migration", pathSegments: getProcessFolderSegments([CONST.Folder.Outputs]) };
    }

    return null;
}

function moveConceptToFolder(concept, conceptType, properties) {
    var placement = resolveConceptPlacement(conceptType, properties);

    if (!placement) {
        return null;
    }

    return moveObjectToFolder(placement.rootName, placement.pathSegments, concept);
}

function moveViewToFolder(viewObject) {
    return moveObjectToFolder("Views", [CONST.Folder.Root, CONST.Folder.Processes], viewObject);
}

function resolveRelationshipPlacement(properties) {
    var role = safeString(properties && properties.ProcessViewRelationRole);
    var relationFolderName;

    if (role === "Composition") {
        relationFolderName = CONST.Folder.Relations.Composition;
    } else if (role === "Triggering") {
        relationFolderName = CONST.Folder.Relations.Triggering;
    } else if (role === "InputAccess") {
        relationFolderName = CONST.Folder.Relations.Inputs;
    } else if (role === "OutputAccess") {
        relationFolderName = CONST.Folder.Relations.Outputs;
    } else {
        return null;
    }

    return {
        rootName: "Relations",
        pathSegments: getProcessFolderSegments([relationFolderName])
    };
}

function moveRelationshipToFolder(relationship, properties) {
    var placement = resolveRelationshipPlacement(properties);

    if (!placement) {
        return null;
    }

    return moveObjectToFolder(placement.rootName, placement.pathSegments, relationship);
}

function buildUniqueViewName(baseName) {
    var candidate = baseName;
    var suffix = 2;

    while ($("view").filter(function (viewObject) {
        return safeString(viewObject.name) === candidate;
    }).first()) {
        candidate = baseName + " (" + suffix + ")";
        suffix++;
    }

    return candidate;
}

function findConceptByKey(conceptType, key) {
    return $(conceptType).filter(function (concept) {
        return safeString(concept.prop("SabsaProcessKey")) === safeString(key);
    }).first();
}

function findConceptById(conceptType, id) {
    return $(conceptType).filter(function (concept) {
        return safeString(concept.prop("id")) === safeString(id);
    }).first();
}

function ensureConcept(conceptType, name, key, properties, documentation) {
    var concept = findConceptByKey(conceptType, key);
    var placement = resolveConceptPlacement(conceptType, properties);
    var conceptCreated = false;

    if (!concept) {
        concept = findConceptById(conceptType, safeString(properties && properties.id));
    }

    if (!concept) {
        if (placement) {
            concept = model.createElement(conceptType, name, ensureFolderPath(placement.rootName, placement.pathSegments));
        } else {
            concept = model.createElement(conceptType, name);
        }
        conceptCreated = true;
        stats.conceptsCreated++;
    } else {
        stats.conceptsReused++;
    }

    concept.name = name;
    concept.documentation = documentation || "";
    concept.prop("SabsaProcessKey", key);

    Object.keys(properties || {}).forEach(function (propertyName) {
        concept.prop(propertyName, safeString(properties[propertyName]));
    });

    if (conceptCreated) {
        moveConceptToFolder(concept, conceptType, properties);
    }

    return concept;
}

function ensureRelationship(relationshipType, sourceConcept, targetConcept, key, properties) {
    var relationship = $("relationship").filter(function (candidate) {
        return safeString(candidate.prop("SabsaProcessKey")) === safeString(key);
    }).first();
    var relationshipCreated = false;

    if (!relationship) {
        try {
            relationship = model.createRelationship(relationshipType, "", sourceConcept, targetConcept);
            relationshipCreated = true;
            stats.relationshipsCreated++;
        } catch (error) {
            relationship = model.createRelationship("association-relationship", "", sourceConcept, targetConcept);
            relationshipCreated = true;
            stats.relationshipsCreated++;
            logger.debug("Preferred relationship type is not valid. Falling back.", {
                preferred_type: relationshipType,
                fallback_type: "association-relationship",
                key: key,
                source_name: safeString(sourceConcept && sourceConcept.name),
                target_name: safeString(targetConcept && targetConcept.name),
                error: String(error)
            }, "sabsa.process.relationship.fallback");
        }
    } else {
        stats.relationshipsReused++;
    }

    relationship.name = "";
    relationship.prop("SabsaProcessKey", key);

    if (relationshipType === "access-relationship" && properties && properties.AccessMode) {
        try {
            relationship.accessType = safeString(properties.AccessMode).toLowerCase();
        } catch (error) {
            logger.debug("Could not apply access type on relationship.", {
                key: key,
                access_mode: safeString(properties.AccessMode),
                error: String(error)
            }, "sabsa.process.relationship.access_type.skipped");
        }
    }

    Object.keys(properties || {}).forEach(function (propertyName) {
        relationship.prop(propertyName, safeString(properties[propertyName]));
    });

    if (relationshipCreated) {
        moveRelationshipToFolder(relationship, properties);
    }

    return relationship;
}

function styleVisual(visual, fillColor) {
    visual.fillColor = fillColor;
    visual.lineColor = CONST.Style.LineColor;
    visual.fontColor = CONST.Style.FontColor;
    visual.opacity = 255;
    visual.outlineOpacity = 255;
}

function addStyledVisual(container, concept, x, y, width, height, fillColor) {
    var visual = container.add(concept, x, y, width, height);
    styleVisual(visual, fillColor);
    return visual;
}

function addConnection(view, relationship, sourceVisual, targetVisual) {
    var connection = view.add(relationship, sourceVisual, targetVisual);
    connection.lineColor = CONST.Style.LineColor;
    connection.fontColor = CONST.Style.FontColor;
    return connection;
}

function tryApplyLabelExpression(visual, expression) {
    try {
        visual.labelExpression = expression;
    } catch (error) {
        logger.debug("Could not apply label expression.", {
            expression: expression,
            error: String(error)
        }, "sabsa.process.label_expression.skipped");
    }
}

function tryApplyTextPosition(visual, position) {
    try {
        visual.textPosition = position;
    } catch (error) {
        logger.debug("Could not apply text position.", {
            position: position,
            error: String(error)
        }, "sabsa.process.text_position.skipped");
    }
}

function setVisualBounds(visual, x, y, width, height) {
    var bounds = visual.bounds;

    if (typeof x !== "undefined" && x !== null) {
        bounds.x = x;
    }

    if (typeof y !== "undefined" && y !== null) {
        bounds.y = y;
    }

    if (typeof width !== "undefined" && width !== null) {
        bounds.width = width;
    }

    if (typeof height !== "undefined" && height !== null) {
        bounds.height = height;
    }

    visual.bounds = bounds;
}

function estimateTextHeight(text, width, minHeight) {
    var cleaned = trim(text);
    var lineLength = Math.max(16, Math.floor((width - 18) / 6.4));
    var lines;

    if (!cleaned) {
        return minHeight;
    }

    lines = Math.ceil(cleaned.length / lineLength);
    return Math.max(minHeight, 14 + (lines * 14));
}

function estimateArtifactStackHeight(artifactEntries, width, minHeight, gap) {
    var totalHeight = 0;

    (artifactEntries || []).forEach(function (entry, index) {
        totalHeight += estimateTextHeight(entry.data.name, width, minHeight);

        if (index < artifactEntries.length - 1) {
            totalHeight += gap;
        }
    });

    return totalHeight;
}

function getStepXInMain() {
    return Math.max(
        CONST.Layout.MainInnerX,
        Math.floor((CONST.Layout.MainWidth - CONST.Layout.StepWidth) / 2)
    );
}

function getSubprocessWidth() {
    return CONST.Layout.StepWidth - CONST.Layout.StepInnerX - CONST.Layout.StepInnerRight;
}

function getSubprocessEntries(stepData) {
    return (stepData && stepData.subprocesses ? stepData.subprocesses : []).map(function (entry) {
        if (typeof entry === "string") {
            return {
                id: slugify((stepData && stepData.id ? stepData.id + "-" : "") + entry),
                name: entry,
                description: "",
                moscow: ""
            };
        }

        return entry;
    });
}

function getSubprocessName(entry) {
    return safeString(entry && entry.name ? entry.name : entry);
}

function estimateStepContainerHeight(stepData) {
    var titleHeight = estimateTextHeight(stepData.name, CONST.Layout.StepWidth, CONST.Layout.StepMinHeight);
    var subprocessWidth = getSubprocessWidth();
    var subprocessHeight = 0;
    var subprocesses = getSubprocessEntries(stepData);

    subprocesses.forEach(function (subprocessData, index) {
        subprocessHeight += estimateTextHeight(
            getSubprocessName(subprocessData),
            subprocessWidth,
            CONST.Layout.SubprocessMinHeight
        );

        if (index < subprocesses.length - 1) {
            subprocessHeight += CONST.Layout.SubprocessGap;
        }
    });

    return titleHeight +
        CONST.Layout.StepInnerY +
        CONST.Layout.SubprocessStartGap +
        subprocessHeight +
        CONST.Layout.StepInnerBottom;
}

function estimateMainProcessHeight() {
    var totalHeight = CONST.Layout.MainInnerY + CONST.Layout.MainInnerBottom;

    DATA.steps.forEach(function (stepData, index) {
        totalHeight += estimateStepContainerHeight(stepData);

        if (index < DATA.steps.length - 1) {
            totalHeight += CONST.Layout.StepGap;
        }
    });

    return Math.max(CONST.Layout.MainMinHeight, totalHeight);
}

function buildInputDocumentation(inputData) {
    return inputData.description +
        "\n\nOrigin: " + safeString(inputData.origin) +
        "\nMoSCoW: " + safeString(inputData.moscow);
}

function buildArtifactDocumentation(artifactData) {
    var lines = [];

    if (safeString(artifactData && artifactData.description)) {
        lines.push(safeString(artifactData.description));
    }

    if (safeString(artifactData && artifactData.origin)) {
        lines.push("");
        lines.push("Origin: " + safeString(artifactData.origin));
    }

    if (safeString(artifactData && artifactData.moscow)) {
        lines.push("MoSCoW: " + safeString(artifactData.moscow));
    }

    if (artifactData && artifactData.references && artifactData.references.length) {
        lines.push("References: " + artifactData.references.join("; "));
    }

    return lines.join("\n");
}

function findConceptByPropertyId(propertyId) {
    var wantedId = safeString(propertyId);

    if (!wantedId) {
        return null;
    }

    return $("element").filter(function (candidate) {
        return safeString(candidate.prop("id")) === wantedId;
    }).first();
}

function applyProperties(target, properties) {
    Object.keys(properties || {}).forEach(function (propertyName) {
        target.prop(propertyName, safeString(properties[propertyName]));
    });
}

function ensureProcessArtifactConcept(artifactData) {
    var artifactId = safeString(artifactData && artifactData.id);
    var existingConcept = findConceptByPropertyId(artifactId);
    var properties = {
        id: artifactId,
        ProcessViewRole: "Artifact",
        MoSCoW: safeString(artifactData && artifactData.moscow),
        ArtifactOrigin: safeString(artifactData && artifactData.origin),
        SourceDocument: CONST.SourceMarkdownPath
    };

    if (existingConcept) {
        stats.conceptsReused++;
        applyProperties(existingConcept, properties);
        return existingConcept;
    }

    return ensureConcept(
        "business-object",
        safeString(artifactData && artifactData.name),
        "artifact:" + artifactId,
        properties,
        buildArtifactDocumentation(artifactData)
    );
}

function findVisualForConcept(visualEntries, concept) {
    var conceptInternalId = safeString(concept && concept.id);
    var match = null;

    (visualEntries || []).some(function (entry) {
        if (safeString(entry.concept && entry.concept.id) === conceptInternalId) {
            match = entry.visual;
            return true;
        }

        return false;
    });

    return match;
}

function connectSubprocessArtifacts(view, subprocessConcept, subprocessVisual, subprocessData, inputVisuals, outputVisuals) {
    var inputEntries = subprocessData && subprocessData.inputs ? subprocessData.inputs : [];
    var outputEntries = subprocessData && subprocessData.outputs ? subprocessData.outputs : [];

    inputEntries.forEach(function (artifactData) {
        var artifactConcept = ensureProcessArtifactConcept(artifactData);
        var relationship = ensureRelationship(
            "access-relationship",
            subprocessConcept,
            artifactConcept,
            "subprocess-input-access:" + safeString(subprocessData.id) + ":" + safeString(artifactData.id),
            {
                ProcessViewRelationRole: "InputAccess",
                AccessMode: "Read",
                SourceDocument: CONST.SourceMarkdownPath
            }
        );
        var targetVisual = findVisualForConcept(inputVisuals, artifactConcept) || findVisualForConcept(outputVisuals, artifactConcept);

        if (targetVisual) {
            addConnection(view, relationship, subprocessVisual, targetVisual);
        }

        stats.relationships++;
    });

    outputEntries.forEach(function (artifactData) {
        var artifactConcept = ensureProcessArtifactConcept(artifactData);
        var relationshipType = safeString(artifactConcept && artifactConcept.type) === "work-package"
            ? "association-relationship"
            : "access-relationship";
        var relationship = ensureRelationship(
            relationshipType,
            subprocessConcept,
            artifactConcept,
            "subprocess-output-access:" + safeString(subprocessData.id) + ":" + safeString(artifactData.id),
            {
                ProcessViewRelationRole: "OutputAccess",
                AccessMode: "Write",
                SourceDocument: CONST.SourceMarkdownPath
            }
        );
        var targetVisual = findVisualForConcept(outputVisuals, artifactConcept) || findVisualForConcept(inputVisuals, artifactConcept);

        if (targetVisual) {
            addConnection(view, relationship, subprocessVisual, targetVisual);
        }

        stats.relationships++;
    });
}

function optimizeGeneratedLayout(layout) {
    var stepX = getStepXInMain();
    var subprocessWidth = getSubprocessWidth();
    var currentStepY = CONST.Layout.MainInnerY;
    var mainBounds = layout.mainVisual.bounds;
    var mainHeight;

    layout.stepVisuals.forEach(function (stepEntry) {
        var currentSubY = CONST.Layout.StepInnerY + CONST.Layout.SubprocessStartGap;
        var titleHeight = estimateTextHeight(stepEntry.data.name, CONST.Layout.StepWidth, CONST.Layout.StepMinHeight);

        stepEntry.subprocessVisuals.forEach(function (subprocessEntry) {
            var subHeight = estimateTextHeight(
                subprocessEntry.data.name,
                subprocessWidth,
                CONST.Layout.SubprocessMinHeight
            );

            setVisualBounds(
                subprocessEntry.visual,
                CONST.Layout.StepInnerX,
                currentSubY,
                subprocessWidth,
                subHeight
            );

            currentSubY += subHeight + CONST.Layout.SubprocessGap;
        });

        if (stepEntry.subprocessVisuals.length > 0) {
            currentSubY -= CONST.Layout.SubprocessGap;
        } else {
            currentSubY = CONST.Layout.StepInnerY;
        }

        var stepHeight = Math.max(
            CONST.Layout.StepMinHeight,
            titleHeight + CONST.Layout.StepInnerY + CONST.Layout.StepInnerBottom,
            currentSubY + CONST.Layout.StepInnerBottom
        );

        setVisualBounds(
            stepEntry.visual,
            stepX,
            currentStepY,
            CONST.Layout.StepWidth,
            stepHeight
        );

        currentStepY += stepHeight + CONST.Layout.StepGap;
    });

    if (layout.stepVisuals.length > 0) {
        currentStepY -= CONST.Layout.StepGap;
    }

    mainHeight = Math.max(
        CONST.Layout.MainMinHeight,
        currentStepY + CONST.Layout.MainInnerBottom
    );

    setVisualBounds(
        layout.mainVisual,
        mainBounds.x,
        mainBounds.y,
        CONST.Layout.MainWidth,
        mainHeight
    );

    function alignArtifacts(artifactEntries, x, width, minHeight, gap, startY, availableHeight) {
        var currentY;

        currentY = startY + Math.max(
            0,
            Math.floor((availableHeight - estimateArtifactStackHeight(artifactEntries, width, minHeight, gap)) / 2)
        );

        artifactEntries.forEach(function (entry) {
            var height = estimateTextHeight(entry.data.name, width, minHeight);

            setVisualBounds(entry.visual, x, currentY, width, height);
            currentY += height + gap;
        });
    }

    alignArtifacts(
        layout.inputVisuals,
        CONST.Layout.InputX,
        CONST.Layout.InputWidth,
        CONST.Layout.ArtifactMinHeight,
        CONST.Layout.ArtifactGap,
        CONST.Layout.MainY,
        mainHeight
    );
    alignArtifacts(
        layout.outputVisuals,
        CONST.Layout.OutputX,
        CONST.Layout.OutputWidth,
        CONST.Layout.ArtifactMinHeight,
        CONST.Layout.ArtifactGap,
        CONST.Layout.MainY,
        mainHeight
    );

    layout.stepVisuals.forEach(function (stepEntry) {
        var stepBounds = stepEntry.visual.bounds;
        var absoluteStepY = mainBounds.y + stepBounds.y;

        alignArtifacts(
            stepEntry.stepInputVisuals,
            CONST.Layout.StepInputX,
            CONST.Layout.StepArtifactWidth,
            CONST.Layout.StepArtifactMinHeight,
            CONST.Layout.StepArtifactGap,
            absoluteStepY,
            stepBounds.height
        );
        alignArtifacts(
            stepEntry.stepOutputVisuals,
            CONST.Layout.StepOutputX,
            CONST.Layout.StepArtifactWidth,
            CONST.Layout.StepArtifactMinHeight,
            CONST.Layout.StepArtifactGap,
            absoluteStepY,
            stepBounds.height
        );
    });
}

function confirmExecution() {
    var subprocessCount = DATA.steps.reduce(function (sum, step) {
        return sum + step.subprocesses.length;
    }, 0);
    return dialogs.confirmInfo(
        "This script will generate or update a focused process view for '" + DATA.process.name + "'." +
        "\n\nSource JSON: " + CONST.SourceJsonPath +
        "\nSource markdown: " + CONST.SourceMarkdownPath +
        "\nInputs: " + DATA.inputs.length +
        "\nOutputs: " + DATA.outputs.length +
        "\nSteps: " + DATA.steps.length +
        "\nSub-processes: " + subprocessCount +
        "\n\nThe script will create or reuse process, top-level artefact, and relationship elements in the open Archi model." +
        "\n\nDo you want to continue?",
        "Run SABSA Conceptual Process Generator"
    );
}

function buildResultMessage(view) {
    return "Generated view: " + view.name +
        "\nLayout optimization: applied" +
        "\nProcesses: " + stats.processes +
        "\nArtifacts: " + stats.artifacts +
        "\nRelationships: " + stats.relationships +
        "\nConcepts created: " + stats.conceptsCreated +
        "\nConcepts reused: " + stats.conceptsReused +
        "\nRelationships created: " + stats.relationshipsCreated +
        "\nRelationships reused: " + stats.relationshipsReused;
}

function createView() {
    var inputVisuals = [];
    var outputVisuals = [];
    var stepVisuals = [];
    var allSubprocessVisuals = [];
    var viewName = buildUniqueViewName(CONST.ViewName);
    var view = model.createArchimateView(viewName);
    var mainConcept = ensureConcept(
        "business-process",
        DATA.process.name,
        "process:" + DATA.process.id,
        {
            id: "sabsa-process:" + DATA.process.id,
            ProcessViewRole: "MainProcess",
            SourceDocument: CONST.SourceMarkdownPath
        },
        DATA.process.description
    );
    var mainVisual;
    var currentStepY = CONST.Layout.MainInnerY;
    var mainHeight = estimateMainProcessHeight();

    view.documentation = "Generated from JSON extract " + CONST.SourceJsonPath + " based on " + CONST.SourceMarkdownPath + ". Shows the main process, step structure, subprocesses, and top-level plus step-level inputs/outputs for Develop Conceptual Security Architecture.";
    moveViewToFolder(view);
    stats.views++;

    DATA.inputs.forEach(function (inputData, index) {
        var concept = ensureConcept(
            "business-object",
            inputData.name,
            "input:" + inputData.id,
            {
                id: "sabsa-process:input:" + inputData.id,
                ProcessViewRole: "InputArtifact",
                InputOrigin: inputData.origin,
                MoSCoW: inputData.moscow,
                SourceDocument: CONST.SourceMarkdownPath
            },
            buildInputDocumentation(inputData)
        );
        var visual = addStyledVisual(
            view,
            concept,
            CONST.Layout.InputX,
            CONST.Layout.MainY + (index * (CONST.Layout.ArtifactMinHeight + CONST.Layout.ArtifactGap)),
            CONST.Layout.InputWidth,
            estimateTextHeight(inputData.name, CONST.Layout.InputWidth, CONST.Layout.ArtifactMinHeight),
            CONST.Style.InputFill
        );

        inputVisuals.push({
            concept: concept,
            visual: visual,
            data: inputData
        });
        stats.artifacts++;
    });

    DATA.outputs.forEach(function (outputData, index) {
        var concept = ensureConcept(
            "work-package",
            outputData.name,
            "output:" + outputData.id,
            {
                id: "sabsa-process:output:" + outputData.id,
                ProcessViewRole: "OutputArtifact",
                OutputOrigin: safeString(outputData.origin),
                MoSCoW: safeString(outputData.moscow),
                SourceDocument: CONST.SourceMarkdownPath
            },
            outputData.description
        );
        var visual = addStyledVisual(
            view,
            concept,
            CONST.Layout.OutputX,
            CONST.Layout.MainY + (index * (CONST.Layout.ArtifactMinHeight + CONST.Layout.ArtifactGap)),
            CONST.Layout.OutputWidth,
            estimateTextHeight(outputData.name, CONST.Layout.OutputWidth, CONST.Layout.ArtifactMinHeight),
            CONST.Style.OutputFill
        );

        outputVisuals.push({
            concept: concept,
            visual: visual,
            data: outputData
        });
        stats.artifacts++;
    });

    mainVisual = addStyledVisual(
        view,
        mainConcept,
        CONST.Layout.MainX,
        CONST.Layout.MainY,
        CONST.Layout.MainWidth,
        mainHeight,
        CONST.Style.MainProcessFill
    );
    stats.processes++;

    DATA.steps.forEach(function (stepData, stepIndex) {
        var stepConcept = ensureConcept(
            "business-process",
            stepData.name,
            "step:" + stepData.id,
            {
                id: "sabsa-process:step:" + stepData.id,
                ProcessViewRole: "StepProcess",
                StepNumber: String(stepIndex + 1),
                MoSCoW: safeString(stepData.moscow),
                SourceDocument: CONST.SourceMarkdownPath
            },
            stepData.description
        );
        var stepHeight = estimateStepContainerHeight(stepData);
        var stepVisual = addStyledVisual(
            mainVisual,
            stepConcept,
            getStepXInMain(),
            currentStepY,
            CONST.Layout.StepWidth,
            stepHeight,
            CONST.Style.StepFill
        );
        var composition = ensureRelationship(
            "composition-relationship",
            mainConcept,
            stepConcept,
            "composition:" + DATA.process.id + ":" + stepData.id,
            {
                ProcessViewRelationRole: "Composition",
                SourceDocument: CONST.SourceMarkdownPath
            }
        );

        addConnection(view, composition, mainVisual, stepVisual);
        stats.processes++;
        stats.relationships++;
        var stepEntry = {
            concept: stepConcept,
            visual: stepVisual,
            data: stepData,
            stepInputVisuals: [],
            stepOutputVisuals: [],
            subprocessVisuals: []
        };

        stepVisuals.push(stepEntry);

        (stepData.inputs || []).forEach(function (artifactData) {
            var artifactConcept = ensureProcessArtifactConcept(artifactData);
            var artifactVisual = addStyledVisual(
                view,
                artifactConcept,
                CONST.Layout.StepInputX,
                CONST.Layout.MainY,
                CONST.Layout.StepArtifactWidth,
                estimateTextHeight(artifactData.name, CONST.Layout.StepArtifactWidth, CONST.Layout.StepArtifactMinHeight),
                CONST.Style.StepInputFill
            );
            var artifactRelationship = ensureRelationship(
                "access-relationship",
                stepConcept,
                artifactConcept,
                "step-input-access:" + stepData.id + ":" + safeString(artifactData.id),
                {
                    ProcessViewRelationRole: "InputAccess",
                    AccessMode: "Read",
                    SourceDocument: CONST.SourceMarkdownPath
                }
            );

            addConnection(view, artifactRelationship, stepVisual, artifactVisual);
            stepEntry.stepInputVisuals.push({
                concept: artifactConcept,
                visual: artifactVisual,
                data: artifactData
            });
            stats.artifacts++;
            stats.relationships++;
        });

        (stepData.outputs || []).forEach(function (artifactData) {
            var artifactConcept = ensureProcessArtifactConcept(artifactData);
            var preferredRelationshipType = safeString(artifactConcept && artifactConcept.type) === "work-package"
                ? "association-relationship"
                : "access-relationship";
            var artifactVisual = addStyledVisual(
                view,
                artifactConcept,
                CONST.Layout.StepOutputX,
                CONST.Layout.MainY,
                CONST.Layout.StepArtifactWidth,
                estimateTextHeight(artifactData.name, CONST.Layout.StepArtifactWidth, CONST.Layout.StepArtifactMinHeight),
                CONST.Style.StepOutputFill
            );
            var artifactRelationship = ensureRelationship(
                preferredRelationshipType,
                stepConcept,
                artifactConcept,
                "step-output-access:" + stepData.id + ":" + safeString(artifactData.id),
                {
                    ProcessViewRelationRole: "OutputAccess",
                    AccessMode: "Write",
                    SourceDocument: CONST.SourceMarkdownPath
                }
            );

            addConnection(view, artifactRelationship, stepVisual, artifactVisual);
            stepEntry.stepOutputVisuals.push({
                concept: artifactConcept,
                visual: artifactVisual,
                data: artifactData
            });
            stats.artifacts++;
            stats.relationships++;
        });

        getSubprocessEntries(stepData).forEach(function (subprocessData, subprocessIndex) {
            var subprocessName = getSubprocessName(subprocessData);
            var subprocessId = safeString(subprocessData.id) || slugify(stepData.id + "-" + subprocessName);
            var subprocessConcept = ensureConcept(
                "business-process",
                subprocessName,
                "subprocess:" + subprocessId,
                {
                    id: "sabsa-process:subprocess:" + subprocessId,
                    ProcessViewRole: "Subprocess",
                    StepNumber: String(stepIndex + 1),
                    SubprocessOrder: String(subprocessIndex + 1),
                    MoSCoW: safeString(subprocessData.moscow),
                    ParentStep: stepData.id,
                    SourceDocument: CONST.SourceMarkdownPath
                },
                safeString(subprocessData.description) || ("Sub-process of " + stepData.name + " derived from " + CONST.SourceMarkdownPath + ".")
            );
            var relativeSubY = CONST.Layout.StepInnerY + CONST.Layout.SubprocessStartGap;
            var subprocessWidth = getSubprocessWidth();
            var previousSubprocesses = getSubprocessEntries(stepData).slice(0, subprocessIndex);
            var subHeight = estimateTextHeight(subprocessName, subprocessWidth, CONST.Layout.SubprocessMinHeight);

            previousSubprocesses.forEach(function (previousSubprocess) {
                relativeSubY += estimateTextHeight(
                    getSubprocessName(previousSubprocess),
                    subprocessWidth,
                    CONST.Layout.SubprocessMinHeight
                ) + CONST.Layout.SubprocessGap;
            });

            var subVisual = addStyledVisual(
                stepVisual,
                subprocessConcept,
                CONST.Layout.StepInnerX,
                relativeSubY,
                subprocessWidth,
                subHeight,
                CONST.Style.SubprocessFill
            );
            var stepComposition = ensureRelationship(
                "composition-relationship",
                stepConcept,
                subprocessConcept,
                "composition:" + stepData.id + ":" + subprocessId,
                {
                    ProcessViewRelationRole: "Composition",
                    SourceDocument: CONST.SourceMarkdownPath
                }
            );

            addConnection(view, stepComposition, stepVisual, subVisual);
            stats.processes++;
            stats.relationships++;
            stepEntry.subprocessVisuals.push({
                concept: subprocessConcept,
                visual: subVisual,
                data: {
                    id: subprocessId,
                    name: subprocessName,
                    moscow: safeString(subprocessData.moscow)
                },
                order: subprocessIndex + 1
            });
            connectSubprocessArtifacts(
                view,
                subprocessConcept,
                subVisual,
                subprocessData,
                stepEntry.stepInputVisuals.concat(inputVisuals),
                stepEntry.stepOutputVisuals.concat(outputVisuals)
            );
            allSubprocessVisuals.push({
                concept: subprocessConcept,
                visual: subVisual,
                stepId: stepData.id,
                order: subprocessIndex + 1
            });
        });

        currentStepY += stepHeight + CONST.Layout.StepGap;
    });

    stepVisuals.forEach(function (stepEntry, index) {
        if (index === 0) {
            return;
        }

        var previous = stepVisuals[index - 1];
        var relationship = ensureRelationship(
            "triggering-relationship",
            previous.concept,
            stepEntry.concept,
            "triggering:step:" + previous.data.id + ":" + stepEntry.data.id,
            {
                ProcessViewRelationRole: "Triggering",
                SourceDocument: CONST.SourceMarkdownPath
            }
        );

        addConnection(view, relationship, previous.visual, stepEntry.visual);
        stats.relationships++;
    });

    DATA.steps.forEach(function (stepData) {
        var stepSubprocesses = allSubprocessVisuals.filter(function (entry) {
            return entry.stepId === stepData.id;
        }).sort(function (left, right) {
            return left.order - right.order;
        });

        stepSubprocesses.forEach(function (entry, index) {
            if (index === 0) {
                return;
            }

            var previous = stepSubprocesses[index - 1];
            var relationship = ensureRelationship(
                "triggering-relationship",
                previous.concept,
                entry.concept,
                "triggering:subprocess:" + previous.stepId + ":" + previous.order + ":" + entry.order,
                {
                    ProcessViewRelationRole: "Triggering",
                    SourceDocument: CONST.SourceMarkdownPath
                }
            );

            addConnection(view, relationship, previous.visual, entry.visual);
            stats.relationships++;
        });
    });

    inputVisuals.forEach(function (entry) {
        var relationship = ensureRelationship(
            "access-relationship",
            mainConcept,
            entry.concept,
            "input-access:" + DATA.process.id + ":" + entry.data.id,
            {
                ProcessViewRelationRole: "InputAccess",
                AccessMode: "Read",
                SourceDocument: CONST.SourceMarkdownPath
            }
        );

        addConnection(view, relationship, mainVisual, entry.visual);
        stats.relationships++;
    });

    outputVisuals.forEach(function (entry) {
        var relationship = ensureRelationship(
            "association-relationship",
            mainConcept,
            entry.concept,
            "output-access:" + DATA.process.id + ":" + entry.data.id,
            {
                ProcessViewRelationRole: "OutputAccess",
                SourceDocument: CONST.SourceMarkdownPath
            }
        );

        addConnection(view, relationship, mainVisual, entry.visual);
        stats.relationships++;
    });

    optimizeGeneratedLayout({
        mainVisual: mainVisual,
        inputVisuals: inputVisuals,
        outputVisuals: outputVisuals,
        stepVisuals: stepVisuals
    });

    return view;
}

function main() {
    var view;

    if (!model) {
        throw new Error("No active model is open.");
    }

    if (!confirmExecution()) {
        logger.info("SABSA conceptual process generation cancelled by user.", {
            source_json: CONST.SourceJsonPath,
            source_markdown: CONST.SourceMarkdownPath
        }, "sabsa.process.generation.cancelled");
        return;
    }

    logger.start("SABSA conceptual process generation started.", {
        source_json: CONST.SourceJsonPath,
        source_markdown: CONST.SourceMarkdownPath
    });

    view = createView();

    logger.finish("SABSA conceptual process generation finished.", {
        source_json: CONST.SourceJsonPath,
        view_name: view.name,
        layout_optimized: true,
        processes_created_or_reused: stats.processes,
        artifacts_created_or_reused: stats.artifacts,
        relationships_created_or_reused: stats.relationships,
        concepts_created: stats.conceptsCreated,
        concepts_reused: stats.conceptsReused,
        relationships_created: stats.relationshipsCreated,
        relationships_reused: stats.relationshipsReused
    });

    dialogs.showInfo(buildResultMessage(view), "SABSA Conceptual Process View");
}

main();
