var File = Java.type("java.io.File");

load(new File(__DIR__ + "../../../lib/logging/Logger.js").getCanonicalPath());
load(new File(__DIR__ + "../../../lib/ui/DialogHelpers.js").getCanonicalPath());
load(new File(__DIR__ + "../../lib/overview/SABSA_Overview_Registry.js").getCanonicalPath());

var SCRIPT_NAME = "Generate_SABSA_A1_Risk_Feedback_Control_System_View";
var logger = ArchiLogging.createLogger(SCRIPT_NAME, {
    clearConsole: true,
    minimumLevel: "WARN"
});
var dialogs = ArchiDialogs.createDialogService(logger, {
    title: "SABSA A1 Risk Feedback Control System"
});

var CONST = {
    ViewName: "SABSA A1 - Risk Management Feedback Control System",
    Namespace: "SabsaA1RiskFeedbackControlSystem",
    Folder: {
        Root: "SABSA",
        A1: "A1",
        ModelName: "Risk Feedback Control System",
        Elements: "Elements",
        Relations: "Risk Feedback Control System"
    },
    Property: {
        Key: "SabsaA1RiskFeedbackControlSystemKey",
        Kind: "SabsaA1RiskFeedbackControlSystemKind",
        Namespace: "Namespace",
        SabsaType: "SabsaType",
        SourceView: "SourceView",
        Layer: "SabsaLayer"
    },
    Layout: {
        TitleX: 30,
        TitleY: 26,
        TitleWidth: 1040,
        TitleHeight: 58,
        StrategyX: 150,
        StrategyY: 78,
        TreatmentX: 700,
        TreatmentY: 78,
        TopWidth: 460,
        TopHeight: 104,
        DomainX: 150,
        DomainY: 330,
        DomainWidth: 170,
        DomainHeight: 66,
        DecisionX: 330,
        DecisionY: 330,
        DecisionWidth: 270,
        DecisionHeight: 112,
        ControlX: 650,
        ControlY: 210,
        ControlWidth: 270,
        ControlHeight: 104,
        DetectX: 670,
