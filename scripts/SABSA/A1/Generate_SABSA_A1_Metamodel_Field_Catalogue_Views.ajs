var File = Java.type("java.io.File");
var Files = Java.type("java.nio.file.Files");
var Paths = Java.type("java.nio.file.Paths");
var StandardCharsets = Java.type("java.nio.charset.StandardCharsets");

load(new File(__DIR__ + "../../lib/logging/Logger.js").getCanonicalPath());
load(new File(__DIR__ + "../../lib/ui/DialogHelpers.js").getCanonicalPath());

var SCRIPT_NAME = typeof SABSA_A1_FIELD_CATALOGUE_SCRIPT_NAME === "undefined"
    ? "Generate_SABSA_A1_Metamodel_Field_Catalogue_Views"
    : String(SABSA_A1_FIELD_CATALOGUE_SCRIPT_NAME);
var LOG_LEVEL = "WARN";
var logger = ArchiLogging.createLogger(SCRIPT_NAME, {
    clearConsole: true,
    minimumLevel: LOG_LEVEL
});
var dialogs = ArchiDialogs.createDialogService(logger, {
    title: typeof SABSA_A1_FIELD_CATALOGUE_DIALOG_TITLE === "undefined"
        ? "SABSA A1 Metamodel Field Catalogue"
        : String(SABSA_A1_FIELD_CATALOGUE_DIALOG_TITLE)
});

var CONST = {
    SourceMarkdownPath: new File(__DIR__ + "../../../../reference/Inbox/SABSA-A1-MFC_generic_metamodel_field_catalogue.md").getCanonicalPath(),
    SourceDocumentName: "SABSA-A1-MFC_generic_metamodel_field_catalogue.md",
    Namespace: "SabsaA1Overlay",
    LayerViewName: "SABSA A1 - SABSA Architecture Layer Alignment",
    TypeViewName: "SABSA A1 - Metamodel Core Type Inventory",
    RelationshipViewName: "SABSA A1 - Metamodel Relationship Catalogue",
    ForeignKeyViewName: "SABSA A1 - Metamodel Field FK Relations",
    ViewpointViewName: "SABSA A1 - Metamodel Viewpoint Catalogue",
    TableIndexViewName: "SABSA A1 - Metamodel Complete Table Index",
    SampleOverviewViewName: "SABSA A1 - Overlay Sample Relationship Overview",
    OverlayOverviewViewName: "SABSA A1 Overlay - Overview",
    OverlayTypeModelViewName: "SABSA A1 Overlay - Type Model",
    OverlayTemplateLibraryViewName: "SABSA A1 Overlay - Template Library",
    Folder: {
        Root: "SABSA",
        A1: "A1",
        OverlayModel: "Overlay Model",
        ModelName: "Metamodel Field Catalogue",
        Layers: "Layers",
        CoreTypes: "Core Types",
        Relationships: "Relationships",
        Viewpoints: "Viewpoints",
        Tables: "Tables",
