        "assurance_requirement": ["Assurance_Requirement"],
        "assurance_subject": ["Assurance_Evaluation_Subject"],
        "attribute": ["Attribute"],
        "attribute_metric": ["KRI"],
        "capability": ["Treatment_Capability"],
        "capability_rating": ["Event_Likelihood"],
        "classification": ["Classification_Value"],
        "consequence": ["Consequence"],
        "consequence_taxonomy": ["Category_Taxonomy"],
        "control_objective": ["Control_Objective"],
        "da": ["Domain_Attribute"],
        "da_dependency": ["DA_Dependency"],
        "dependency": ["DA_Dependency"],
        "dependencies": ["DA_Dependency"],
        "domain": ["Domain"],
        "domain_attribute": ["Domain_Attribute"],
        "domain_authority": ["Domain_Authority"],
        "enablement_objective": ["Enablement_Objective"],
        "event": ["Event"],
        "event_agent_map": ["Event_Agent_Map"],
        "event_likelihood": ["Event_Likelihood"],
        "event_taxonomy": ["Category_Taxonomy"],
        "evidence": ["Evidence_Item"],
        "evidence_item": ["Evidence_Item"],
        "finding": ["Assurance_Finding"],
        "kri": ["KRI"],
        "library_item": ["Treatment_Library_Item"],
        "motivation_rating": ["Event_Likelihood"],
        "opportunity": ["Risk"],
        "overall_likelihood": ["Overall_Likelihood"],
        "parent_domain": ["Domain"],
        "period": ["Risk_Period", "Monitoring_Period"],
        "risk": ["Risk"],
        "risk_assessment": ["Risk_Assessment"],
        "risk_period": ["Risk_Period"],
        "role": ["Stakeholder_Role"],
        "role_or_stakeholder": ["Stakeholder_Role", "Stakeholder"],
        "scenario": ["Scenario"],
        "scorecard": ["Risk_Scorecard"],
        "source": ["Source_Reference"],
        "source_reference": ["Source_Reference"],
        "stakeholder": ["Stakeholder"],
        "state": ["State"],
        "state_attribute": ["State_Attribute"],
        "state_rating": ["State_Rating"],
        "state_taxonomy": ["Category_Taxonomy"],
        "taxonomy": ["Category_Taxonomy"],
        "threshold": ["Risk_Appetite_Criteria"],
        "treatment": ["Risk_Treatment"],
        "treatment_library_item": ["Treatment_Library_Item"],
        "trigger_factor": ["Trigger_Factor"]
    };
}

function addReferencedCoreTypeCandidate(result, seen, coreTypeConcepts, candidate) {
    var cleaned = stripMarkup(candidate)
        .replace(/_ids?\b/ig, " ")
        .replace(/\boptional\b/ig, " ")
        .replace(/\bfks?\b/ig, " ")
        .replace(/\bids?\b/ig, " ")
        .replace(/\breferences?\b/ig, " ")
        .replace(/\brelated\b/ig, " ")
        .replace(/\binput\b/ig, " ")
        .replace(/\btarget\b/ig, " ")
        .replace(/\bfrom\b/ig, " ")
        .replace(/\bto\b/ig, " ")
        .replace(/\bsender\b/ig, " ")
        .replace(/\breceiver\b/ig, " ")
        .replace(/\bmonitored\b/ig, " ")
        .replace(/\brequired\b/ig, " ")
        .replace(/\bbroader\b/ig, " ")
        .replace(/\bparent\b/ig, " parent ")
        .replace(/\s+/g, " ")
        .trim();
    var aliases = getFkTargetAliases();
    var aliasKey = propertyKey(cleaned);
    var aliasValues = aliases[aliasKey] || [];
    var concept;

    if (!cleaned) {
        return;
    }

    addUniqueConcept(result, seen, getCoreTypeConcept(coreTypeConcepts, cleaned));
    addUniqueConcept(result, seen, getCoreTypeConcept(coreTypeConcepts, splitCamelCase(cleaned)));

    aliasValues.forEach(function (aliasValue) {
        addUniqueConcept(result, seen, getCoreTypeConcept(coreTypeConcepts, aliasValue));
    });

    Object.keys(coreTypeConcepts).forEach(function (typeName) {
        var normalizedType = propertyKey(typeName);
        if (aliasKey === normalizedType) {
            addUniqueConcept(result, seen, coreTypeConcepts[typeName]);
        }
    });

    concept = getCoreTypeConcept(coreTypeConcepts, cleaned.replace(/\s+/g, "_"));
    addUniqueConcept(result, seen, concept);
}

function addReferencedCoreTypesFromDelimitedText(result, seen, coreTypeConcepts, text) {
    stripMarkup(text)
        .split(/\s*(?:,|;|\/|\bor\b|\band\b)\s*/i)
        .forEach(function (part) {
            addReferencedCoreTypeCandidate(result, seen, coreTypeConcepts, part);
        });
}

function addReferencedCoreTypesFromFkText(result, seen, coreTypeConcepts, note) {
    var text = stripMarkup(note);
    var patterns = [
        /\bfks?\s+to\s+([^.;]+)/ig,
        /\boptional\s+fks?\s+to\s+([^.;]+)/ig,
        /\boptional\s+([^.;]+?)\s+fks?\b/ig,
        /\b([^.;]+?)\s+ids?\b/ig
    ];

    patterns.forEach(function (pattern) {
        var match;
        while ((match = pattern.exec(text)) !== null) {
            addReferencedCoreTypesFromDelimitedText(result, seen, coreTypeConcepts, match[1]);
        }
    });

    Object.keys(getFkTargetAliases()).forEach(function (aliasKey) {
        var words = aliasKey.replace(/_/g, "[ _-]");
        var regex = new RegExp("\\b" + words + "s?\\b", "i");
        if (regex.test(text)) {
            addReferencedCoreTypeCandidate(result, seen, coreTypeConcepts, aliasKey);
        }
    });
}

function getReferencedCoreTypeConcepts(coreTypeConcepts, fieldData) {
    var result = [];
    var seen = {};
    var note = safeString(fieldData && fieldData.Note);
    var fieldName = stripMarkup(fieldData && fieldData.Field);
    var regex = /`([^`]+)`/g;
    var match;
    var inferred;

    if (safeString(fieldData && fieldData["Key Role"]) !== "FK") {
        return result;
    }

    while ((match = regex.exec(note)) !== null) {
        addUniqueConcept(result, seen, getCoreTypeConcept(coreTypeConcepts, match[1]));
    }

    addReferencedCoreTypesFromFkText(result, seen, coreTypeConcepts, note);
    addReferencedCoreTypesFromDelimitedText(result, seen, coreTypeConcepts, fieldName);

    inferred = fieldName
        .replace(/_ids$/i, "")
        .replace(/_id$/i, "")
        .replace(/_fk$/i, "");
    if (inferred && inferred !== fieldName) {
        addUniqueConcept(result, seen, getCoreTypeConcept(coreTypeConcepts, inferred));
        addUniqueConcept(result, seen, getCoreTypeConcept(coreTypeConcepts, splitCamelCase(inferred)));
    }

    return result;
}

function buildSemanticRelationLabel(parsed, data) {
    var cardinality = safeString(data.Cardinality);
    var semantics = truncate(safeString(data.Semantics), 70);

    if (semantics && cardinality) {
        return semantics + " [" + cardinality + "]";
    }
    if (semantics) {
        return semantics;
    }
    if (cardinality) {
        return parsed.source + " -> " + parsed.target + " [" + cardinality + "]";
    }
    return parsed.source + " -> " + parsed.target;
}

function buildFkRelationLabel(fieldData, targetConcept) {
    var fieldName = stripMarkup(fieldData.Field);
    var required = safeString(fieldData.Required);
    var targetName = safeString(targetConcept && targetConcept.name);

    if (targetName) {
        return fieldName + " -> " + targetName + (required ? " [" + required + "]" : "");
    }

    return fieldName;
}

function buildSampleValue(fieldName, datatype, description) {
    var type = safeString(datatype).toLowerCase();
    var note = stripMarkup(description);
    var enumCandidate = note.split(",")[0].replace(/\.$/, "").trim();

    if (type === "date") {
        return "2026-06-10";
    }
    if (type === "integer" || type === "number") {
        return "1";
    }
    if (type === "boolean") {
        return "True";
    }
    if (type === "enum") {
        return enumCandidate || "Sample";
    }
    if (type === "list") {
        return "sample_ref";
    }
    if (type === "formula") {
        return "sample_formula";
    }
    if (type === "text") {
        return "Sample " + fieldName + ".";
    }

    return "sample_" + propertyKey(fieldName);
}

function removeReferenceFieldValues(concept, metaConcept) {
    var removed = 0;
    var fieldList = safeString(metaConcept.prop("FieldList")).split(/\s*;\s*/).filter(function (fieldName) {
        return !!fieldName;
    });

    fieldList.forEach(function (fieldName) {
        if (isReferenceField(metaConcept, fieldName) && safeString(concept.prop(fieldName))) {
            concept.removeProp(fieldName);
            removed++;
        }
    });

    return removed;
}

function applySamplePropertiesFromMeta(sampleConcept, metaConcept) {
    var fieldList = safeString(metaConcept.prop("FieldList")).split(/\s*;\s*/).filter(function (fieldName) {
        return !!fieldName;
    });
    var defaults = parseJsonObject(metaConcept.prop("DefaultValuesJson"));

    stats.fieldMetadataPropertiesRemoved += removeReferenceFieldValues(sampleConcept, metaConcept);

    fieldList.forEach(function (fieldName) {
        var datatype = getFieldDatatype(metaConcept, fieldName);
        var description = getFieldDescription(metaConcept, fieldName);
        var defaultValue = safeString(defaults[fieldName]);

        if (isReferenceField(metaConcept, fieldName)) {
            return;
        }

        sampleConcept.prop(fieldName, defaultValue || buildSampleValue(fieldName, datatype, description));
    });
}

function createSampleConcepts(coreTypeConcepts) {
    var samplesByType = {};

    Object.keys(coreTypeConcepts).forEach(function (typeName) {
        var metaConcept = coreTypeConcepts[typeName];
        var conceptType = safeString(metaConcept.prop("RecommendedArchiMateType")) || "grouping";
        var sampleName = "Sample " + typeName;
        var sample = ensureConcept(conceptType, sampleName, "catalogue:sample:type:" + typeName, {
            SabsaA1CatalogueKind: "Sample",
            SabsaType: typeName,
            TypeName: typeName,
            SourceSection: "Generated sample from " + typeName,
            MetaElementKey: metaConcept.prop("SabsaA1CatalogueKey"),
            VisualFillColor: getConceptFill(metaConcept, CONST.Style.TypeFill),
            VisualColorRole: getColorRole(getConceptFill(metaConcept, CONST.Style.TypeFill))
        }, "Sample element for SABSA A1 overlay stereotype " + typeName + ".");

        applySamplePropertiesFromMeta(sample, metaConcept);
        ensureRelationship("association-relationship", sample, metaConcept, "catalogue:sample:meta:" + typeName, "uses stereotype " + typeName, {
            SabsaA1CatalogueRelationKind: "SampleUsesMetaType",
            RelationshipKind: CONST.Kind.SampleRelationship,
            RelationshipTypeName: "SampleUsesMetaType",
            RelationshipLabel: "uses stereotype " + typeName,
            SourceSection: "Generated sample"
        });

        samplesByType[typeName] = sample;
        stats.samples++;
    });

    return samplesByType;
}

function createSampleRelationships(tableData, coreTypeConcepts, samplesByType) {
    var sampleRelationships = [];

    (tableData.rowsByTableId["6-03"] || []).forEach(function (rowEntry) {
        var parsed = parseRelationshipExpression(rowEntry.data.Relationship);
        var sourceMeta = getCoreTypeConcept(coreTypeConcepts, parsed.source);
        var targetMeta = getCoreTypeConcept(coreTypeConcepts, parsed.target);
        var sourceSample = sourceMeta ? samplesByType[sourceMeta.name] : null;
        var targetSample = targetMeta ? samplesByType[targetMeta.name] : null;
        var label = buildSemanticRelationLabel(parsed, rowEntry.data);
        var relationship;

        if (!sourceSample || !targetSample) {
            return;
        }

        relationship = ensureRelationship("association-relationship", sourceSample, targetSample, "catalogue:sample:relationship:" + slugify(parsed.label), label, {
            SabsaA1CatalogueRelationKind: "SampleSemanticRelationship",
            RelationshipKind: CONST.Kind.SampleRelationship,
            RelationshipTypeName: specializationName(parsed.label),
            RelationshipLabel: label,
            RelationshipExpression: parsed.label,
            SourceType: parsed.source,
            TargetType: parsed.target,
            Cardinality: rowEntry.data.Cardinality,
            Semantics: rowEntry.data.Semantics,
            ValidationImpact: rowEntry.data["Validation Impact"],
            SourceSection: "Table 6-03"
        });
        sampleRelationships.push(relationship);
        stats.sampleRelationships++;
    });

    $("relationship").filter(function (relationship) {
        return safeString(relationship.prop("SabsaA1CatalogueRelationKind")) === "CoreTypeForeignKeyReference";
    }).each(function (fkRelationship) {
        var sourceMeta = getCoreTypeConcept(coreTypeConcepts, fkRelationship.prop("SourceType"));
        var targetMeta = getCoreTypeConcept(coreTypeConcepts, fkRelationship.prop("TargetType"));
        var sourceSample = sourceMeta ? samplesByType[sourceMeta.name] : null;
        var targetSample = targetMeta ? samplesByType[targetMeta.name] : null;
        var fkKey = safeString(fkRelationship.prop("SabsaA1CatalogueKey"));
        var fieldName = safeString(fkRelationship.prop("FieldName"));
        var label = safeString(fkRelationship.prop("RelationshipLabel")) || (fieldName + " -> " + safeString(fkRelationship.prop("TargetType")));
        var relationship;

        if (!sourceSample || !targetSample || !fkKey) {
            return;
        }

        relationship = ensureRelationship("association-relationship", sourceSample, targetSample, "catalogue:sample:fk:" + slugify(fkKey), label, {
            SabsaA1CatalogueRelationKind: "SampleForeignKeyRelationship",
            RelationshipKind: CONST.Kind.SampleRelationship,
            RelationshipTypeName: "SampleForeignKeyReference",
            RelationshipLabel: label,
            SourceType: sourceMeta.name,
            TargetType: targetMeta.name,
            FieldName: fieldName,
            Required: fkRelationship.prop("Required"),
            KeyRole: fkRelationship.prop("KeyRole"),
            Description: fkRelationship.prop("Description"),
            SourceSection: fkRelationship.prop("SourceSection")
        });
        sampleRelationships.push(relationship);
        stats.sampleRelationships++;
    });

    return sampleRelationships;
}

function createSampleOverviewView(samplesByType, sampleRelationships) {
    var view = model.createArchimateView(buildUniqueViewName(CONST.SampleOverviewViewName));
    var visuals = {};
    var sampleKeys = Object.keys(samplesByType);

    view.documentation = "Generated SABSA A1 overlay sample elements and stereotyped sample relationships.";
    moveViewToFolder(view);

    sampleKeys.forEach(function (typeName, index) {
        var concept = samplesByType[typeName];
        var pos = gridPosition(index, CONST.Layout.TypeColumns, CONST.Layout.StartX, CONST.Layout.StartY, CONST.Layout.CardWidth, CONST.Layout.CardHeight);
        visuals[typeName] = addStyledVisual(view, concept, pos.x, pos.y, CONST.Layout.CardWidth, CONST.Layout.CardHeight, getConceptFill(concept, CONST.Style.TypeFill));
    });

    sampleRelationships.forEach(function (relationship) {
        var sourceType = safeString(relationship.prop("SourceType"));
        var targetType = safeString(relationship.prop("TargetType"));
        var sourceVisual = visuals[sourceType];
        var targetVisual = visuals[targetType];

        if (!sourceVisual) {
            Object.keys(visuals).forEach(function (key) {
                if (!sourceVisual && normalizeTypeName(key) === normalizeTypeName(sourceType)) {
                    sourceVisual = visuals[key];
                }
            });
        }
        if (!targetVisual) {
            Object.keys(visuals).forEach(function (key) {
                if (!targetVisual && normalizeTypeName(key) === normalizeTypeName(targetType)) {
                    targetVisual = visuals[key];
                }
            });
        }

        addConnection(view, relationship, sourceVisual, targetVisual);
    });

    stats.views++;
    return view;
}

function buildTemplateIndex(coreTypeConcepts) {
    var entries = [];

    Object.keys(coreTypeConcepts).forEach(function (typeName) {
        var concept = coreTypeConcepts[typeName];
        entries.push({
            Namespace: CONST.Namespace,
            Kind: CONST.Kind.MetaType,
            TypeName: typeName,
            BaseType: safeString(concept.prop("RecommendedArchiMateType")),
            ConceptType: safeString(concept.prop("RecommendedArchiMateType")),
            Stereotype: "«SABSA A1 " + typeName + "»",
            DefaultLabelExpression: CONST.LabelExpression.Stereotype,
            MetaElementKey: safeString(concept.prop("SabsaA1CatalogueKey")),
            FieldList: safeString(concept.prop("FieldList"))
        });
    });

    return entries;
}

function buildRelationshipIndex(relationshipConcepts) {
    return relationshipConcepts.map(function (concept) {
        return {
            Namespace: CONST.Namespace,
            Kind: CONST.Kind.MetaRelationship,
            TypeName: safeString(concept.prop(CONST.Property.TypeName)) || specializationName(concept.name),
            BaseType: "association-relationship",
            ConceptType: "association-relationship",
            Stereotype: safeString(concept.prop(CONST.Property.Stereotype)),
            DefaultLabelExpression: CONST.LabelExpression.Stereotype,
            MetaElementKey: safeString(concept.prop("SabsaA1CatalogueKey")),
            RelationshipExpression: safeString(concept.prop("Relationship")),
            SourceType: safeString(concept.prop("SourceType")),
            TargetType: safeString(concept.prop("TargetType"))
        };
    });
}

function persistOverlayIndexes(coreTypeConcepts, relationshipConcepts) {
    model.prop(CONST.Property.TemplateIndexJson, JSON.stringify(buildTemplateIndex(coreTypeConcepts), null, 2));
    model.prop(CONST.Property.RelationshipIndexJson, JSON.stringify(buildRelationshipIndex(relationshipConcepts), null, 2));
}

function findLayerConcept(layerConcepts, layerName) {
    var wanted = slugify(layerName);
    var found = null;

    layerConcepts.forEach(function (concept) {
        if (!found && slugify(safeString(concept.prop("Layer"))) === wanted) {
            found = concept;
        }
    });

    return found;
}

function indexRelationshipConcepts(relationshipConcepts) {
    var result = {};

    relationshipConcepts.forEach(function (concept) {
        result[slugify(concept.name)] = concept;
    });

    return result;
}

function indexViewpointConcepts(viewpointConcepts) {
    var result = {};

    viewpointConcepts.forEach(function (concept) {
        result[slugify(safeString(concept.prop("Viewpoint")))] = concept;
    });

    return result;
}

function createRelationshipConcepts(markdown, sourceConcept, coreTypeConcepts) {
    var rows = extractTableAfterMarker(markdown, "Table 6-03 - Relationship Catalogue");
    var concepts = [];

    rows.forEach(function (row, index) {
        var data = rowToObject(row);
        var parsed = parseRelationshipExpression(data.Relationship);
        var name = parsed.label || ("Relationship " + (index + 1));
        var fillColor = CONST.Style.RelationshipFill;
        var concept = ensureConcept("business-object", name, "catalogue:relationship:" + slugify(name), {
            SabsaA1CatalogueKind: "Relationship",
            Relationship: name,
            SourceType: parsed.source,
            TargetType: parsed.target,
            Cardinality: data.Cardinality,
            Semantics: data.Semantics,
            ValidationImpact: data["Validation Impact"],
            VisualFillColor: fillColor,
            VisualColorRole: getColorRole(fillColor),
            SourceSection: "Table 6-03"
        }, buildDocumentation("Relationship definition extracted from Table 6-03.", data));
        applyTableProperties(concept, data);

        ensureRelationship("association-relationship", sourceConcept, concept, "catalogue:source:relationship:" + slugify(name), "defines", {
            SabsaA1CatalogueRelationKind: "SourceTrace",
            SourceSection: "Table 6-03"
        });

        if (coreTypeConcepts[parsed.source]) {
            ensureRelationship("association-relationship", concept, coreTypeConcepts[parsed.source], "catalogue:relationship:" + slugify(name) + ":source", "source", {
                SabsaA1CatalogueRelationKind: "RelationshipSource",
                SourceSection: "Table 6-03"
            });
        }

        if (coreTypeConcepts[parsed.target]) {
            ensureRelationship("association-relationship", concept, coreTypeConcepts[parsed.target], "catalogue:relationship:" + slugify(name) + ":target", "target", {
                SabsaA1CatalogueRelationKind: "RelationshipTarget",
                SourceSection: "Table 6-03"
            });
        }

        concepts.push(concept);
        stats.relationships++;
    });

    return concepts;
}

function createViewpointConcepts(markdown, sourceConcept) {
    var rows = extractTableAfterMarker(markdown, "Table 6-05 - Recommended Architecture Viewpoints");
    var concepts = [];

    rows.forEach(function (row) {
        var data = rowToObject(row);
        var viewpoint = data.Viewpoint;
        var concept;

        if (!viewpoint) {
            return;
        }

        var fillColor = CONST.Style.ViewpointFill;
        concept = ensureConcept("grouping", viewpoint, "catalogue:viewpoint:" + slugify(viewpoint), {
            SabsaA1CatalogueKind: "Viewpoint",
            Viewpoint: viewpoint,
            MainQuestion: data["Main Question"],
            UseFor: data["Use For"],
            RequiredBackLink: data["Required Back-Link"],
            VisualFillColor: fillColor,
            VisualColorRole: getColorRole(fillColor),
            SourceSection: "Table 6-05"
        }, buildDocumentation("Recommended architecture viewpoint extracted from Table 6-05.", data));
        applyTableProperties(concept, data);

        ensureRelationship("association-relationship", sourceConcept, concept, "catalogue:source:viewpoint:" + slugify(viewpoint), "defines", {
            SabsaA1CatalogueRelationKind: "SourceTrace",
            SourceSection: "Table 6-05"
        });
        concepts.push(concept);
        stats.viewpoints++;
    });

    return concepts;
}

function linkTableRowsToConcepts(tableData, layerConcepts, coreTypeConcepts, relationshipConcepts, viewpointConcepts) {
    var relationshipIndex = indexRelationshipConcepts(relationshipConcepts);
    var viewpointIndex = indexViewpointConcepts(viewpointConcepts);

    function linkRow(tableId, rowEntry, targetConcept, relationKind, label) {
        if (!rowEntry || !rowEntry.concept || !targetConcept) {
            return;
        }

        ensureRelationship("association-relationship", rowEntry.concept, targetConcept, "catalogue:row-link:" + slugify(tableId) + ":" + rowEntry.rowIndex + ":" + slugify(relationKind), label, {
            SabsaA1CatalogueRelationKind: relationKind,
            RelationshipLabel: label,
            TableId: tableId,
            RowIndex: String(rowEntry.rowIndex),
            SourceSection: "Table " + tableId
        });
    }

    function linkTable(tableId, targetConcept, relationKind, label) {
        if (!tableData.tablesById[tableId] || !targetConcept) {
            return;
        }

        ensureRelationship("association-relationship", tableData.tablesById[tableId], targetConcept, "catalogue:table-link:" + slugify(tableId) + ":" + safeString(targetConcept.prop("SabsaA1CatalogueKey")) + ":" + slugify(relationKind), label, {
            SabsaA1CatalogueRelationKind: relationKind,
            TableId: tableId,
            SourceSection: "Table " + tableId
        });
    }

    (tableData.rowsByTableId["3-LA01"] || []).forEach(function (rowEntry) {
        var target = findLayerConcept(layerConcepts, rowEntry.data.Layer);
        linkRow("3-LA01", rowEntry, target, "RowDefinesLayer", "defines layer");
        linkTable("3-LA01", target, "TableDefinesLayer", "defines layer");
    });

    (tableData.rowsByTableId["6-01"] || []).forEach(function (rowEntry) {
        var target = getCoreTypeConcept(coreTypeConcepts, rowEntry.data.Type);
        linkRow("6-01", rowEntry, target, "RowDefinesCoreType", "defines type");
        linkTable("6-01", target, "TableDefinesCoreType", "defines type");
    });

    (tableData.rowsByTableId["6-02"] || []).forEach(function (rowEntry) {
        var target = getCoreTypeConcept(coreTypeConcepts, rowEntry.data["Type / Pattern"]);
        linkRow("6-02", rowEntry, target, "RowDefinesPromotedCoreType", "defines promoted/support type");
        linkTable("6-02", target, "TableDefinesPromotedCoreType", "defines promoted/support type");
    });

    (tableData.rowsByTableId["6-03"] || []).forEach(function (rowEntry) {
        var parsed = parseRelationshipExpression(rowEntry.data.Relationship);
        var relationshipConcept = relationshipIndex[slugify(parsed.label)];
        var sourceType = getCoreTypeConcept(coreTypeConcepts, parsed.source);
        var targetType = getCoreTypeConcept(coreTypeConcepts, parsed.target);

        linkRow("6-03", rowEntry, relationshipConcept, "RowDefinesRelationship", "defines relationship");
        linkTable("6-03", relationshipConcept, "TableDefinesRelationship", "defines relationship");

        if (sourceType && targetType) {
            ensureRelationship("association-relationship", sourceType, targetType, "catalogue:type-relation:" + slugify(parsed.label), buildSemanticRelationLabel(parsed, rowEntry.data), {
                SabsaA1CatalogueRelationKind: "CoreTypeSemanticRelationship",
                RelationshipLabel: buildSemanticRelationLabel(parsed, rowEntry.data),
                RelationshipExpression: parsed.label,
                SourceType: parsed.source,
                TargetType: parsed.target,
                Cardinality: rowEntry.data.Cardinality,
                Semantics: rowEntry.data.Semantics,
                ValidationImpact: rowEntry.data["Validation Impact"],
                SourceSection: "Table 6-03"
            });
            stats.elementRelations++;
        }
    });

    (tableData.rowsByTableId["6-05"] || []).forEach(function (rowEntry) {
        var target = viewpointIndex[slugify(rowEntry.data.Viewpoint)];
        linkRow("6-05", rowEntry, target, "RowDefinesViewpoint", "defines viewpoint");
        linkTable("6-05", target, "TableDefinesViewpoint", "defines viewpoint");
    });

    tableData.tables.forEach(function (tableConcept) {
        var title = safeString(tableConcept.prop("TableTitle"));
        var tableId = safeString(tableConcept.prop("TableId"));
        var rowEntries = tableData.rowsByTableId[tableId] || [];
        var rows = rowEntries.map(function (rowEntry) {
            return rowEntry.data;
        });
        var targets = getCoreTypeConceptsForTitle(coreTypeConcepts, title);

        targets.forEach(function (target) {
            applyFieldCatalogueProperties(target, rows, tableId);

            ensureRelationship("association-relationship", tableConcept, target, "catalogue:table-detail:" + slugify(tableId) + ":" + safeString(target.prop("SabsaA1CatalogueKey")), "details type", {
                SabsaA1CatalogueRelationKind: "TableDetailsCoreType",
                TableId: tableId,
                TableTitle: title,
                TargetCoreType: target.name,
                SourceSection: "Table " + tableId
            });

            rowEntries.forEach(function (rowEntry) {
                var fieldRoleLabel = isFieldCatalogueRow(rowEntry.data) ? getFieldRoleLabel(rowEntry.data) : "Property";

                linkRow(tableId, rowEntry, target, "FieldRowBelongsToCoreType", fieldRoleLabel);

                if (isFieldCatalogueRow(rowEntry.data)) {
                    if (rowEntry.concept) {
                        ensureRelationship("association-relationship", target, rowEntry.concept, "catalogue:core-type-field:" + safeString(target.prop("SabsaA1CatalogueKey")) + ":" + tableId + ":" + rowEntry.rowIndex, fieldRoleLabel, {
                            SabsaA1CatalogueRelationKind: "CoreTypeHasField",
                            RelationshipLabel: fieldRoleLabel,
                            FieldName: stripMarkup(rowEntry.data.Field),
                            Datatype: rowEntry.data.Datatype,
                            Required: rowEntry.data.Required,
                            KeyRole: rowEntry.data["Key Role"],
                            TemplateFamily: rowEntry.data["Template Family"],
                            Description: rowEntry.data.Note,
                            SourceSection: "Table " + tableId
                        });
                    }

                    getReferencedCoreTypeConcepts(coreTypeConcepts, rowEntry.data).forEach(function (referencedType) {
                        ensureRelationship("association-relationship", target, referencedType, "catalogue:fk:" + safeString(target.prop("SabsaA1CatalogueKey")) + ":" + tableId + ":" + rowEntry.rowIndex + ":" + safeString(referencedType.prop("SabsaA1CatalogueKey")), buildFkRelationLabel(rowEntry.data, referencedType), {
                            SabsaA1CatalogueRelationKind: "CoreTypeForeignKeyReference",
                            RelationshipLabel: buildFkRelationLabel(rowEntry.data, referencedType),
                            SourceType: target.name,
                            TargetType: referencedType.name,
                            TableId: tableId,
                            RowIndex: String(rowEntry.rowIndex),
                            FieldRowKey: safeString(rowEntry.concept.prop("SabsaA1CatalogueKey")),
                            FieldName: stripMarkup(rowEntry.data.Field),
                            Datatype: rowEntry.data.Datatype,
                            Required: rowEntry.data.Required,
                            KeyRole: rowEntry.data["Key Role"],
                            TemplateFamily: rowEntry.data["Template Family"],
                            Description: rowEntry.data.Note,
                            SourceSection: "Table " + tableId
                        });

                        if (rowEntry.concept) {
                            ensureRelationship("association-relationship", rowEntry.concept, referencedType, "catalogue:fk-row:" + safeString(rowEntry.concept.prop("SabsaA1CatalogueKey")) + ":" + safeString(referencedType.prop("SabsaA1CatalogueKey")), buildFkRelationLabel(rowEntry.data, referencedType), {
                                SabsaA1CatalogueRelationKind: "FieldRowForeignKeyReference",
                                RelationshipLabel: buildFkRelationLabel(rowEntry.data, referencedType),
                                SourceType: target.name,
                                TargetType: referencedType.name,
                                TableId: tableId,
                                RowIndex: String(rowEntry.rowIndex),
                                FieldRowKey: safeString(rowEntry.concept.prop("SabsaA1CatalogueKey")),
                                FieldName: stripMarkup(rowEntry.data.Field),
                                Datatype: rowEntry.data.Datatype,
                                Required: rowEntry.data.Required,
                                KeyRole: rowEntry.data["Key Role"],
                                TemplateFamily: rowEntry.data["Template Family"],
                                Description: rowEntry.data.Note,
                                SourceSection: "Table " + tableId
                            });
                        }
                        stats.elementRelations++;
                    });
                }
            });
        });
    });
}

function createGridView(baseName, sourceConcept, concepts, fillColor, columns) {
    var view = model.createArchimateView(buildUniqueViewName(baseName));
    var sourceVisual;

    view.documentation = "Generated from " + CONST.SourceMarkdownPath + ".";
    moveViewToFolder(view);

    sourceVisual = addStyledVisual(view, sourceConcept, CONST.Layout.StartX, CONST.Layout.StartY, CONST.Layout.SourceWidth, CONST.Layout.SourceHeight, CONST.Style.SourceFill);

    function sourceTraceKey(concept) {
        var kind = safeString(concept.prop("SabsaA1CatalogueKind"));

        if (kind === "Layer") {
            return "catalogue:source:layer:" + slugify(safeString(concept.prop("Layer")));
        }

        if (kind === "CoreType") {
            return "catalogue:source:type:" + safeString(concept.prop("SabsaType"));
        }

        if (kind === "Viewpoint") {
            return "catalogue:source:viewpoint:" + slugify(safeString(concept.prop("Viewpoint")));
        }

        if (kind === "Table") {
            return "catalogue:source:table:" + slugify(safeString(concept.prop("TableId")));
        }

        return "";
    }

    concepts.forEach(function (concept, index) {
        var pos = gridPosition(index, columns, CONST.Layout.StartX, CONST.Layout.StartY + 120, CONST.Layout.CardWidth, CONST.Layout.CardHeight);
        var visual = addStyledVisual(view, concept, pos.x, pos.y, CONST.Layout.CardWidth, CONST.Layout.CardHeight, getConceptFill(concept, fillColor));
        addConnection(view, findRelationshipByKey(sourceTraceKey(concept)), sourceVisual, visual);
    });

    stats.views++;
    return view;
}

function createTypeView(sourceConcept, typeConcepts) {
    var view = model.createArchimateView(buildUniqueViewName(CONST.TypeViewName));
    var sourceVisual;
    var visualsByConcept = {};

    view.documentation = "Generated core, promoted support and extension types with semantic and FK relationships from " + CONST.SourceMarkdownPath + ".";
    moveViewToFolder(view);

    sourceVisual = addStyledVisual(view, sourceConcept, CONST.Layout.StartX, CONST.Layout.StartY, CONST.Layout.SourceWidth, CONST.Layout.SourceHeight, CONST.Style.SourceFill);
    rememberVisual(visualsByConcept, sourceConcept, sourceVisual);

    Object.keys(typeConcepts).forEach(function (key, index) {
        var concept = typeConcepts[key];
        var pos = gridPosition(index, CONST.Layout.TypeColumns, CONST.Layout.StartX, CONST.Layout.StartY + 120, CONST.Layout.CardWidth, CONST.Layout.CardHeight);
        var visual = addStyledVisual(view, concept, pos.x, pos.y, CONST.Layout.CardWidth, CONST.Layout.CardHeight, getConceptFill(concept, CONST.Style.TypeFill));

        rememberVisual(visualsByConcept, concept, visual);
        addConnection(view, findRelationshipByKey("catalogue:source:type:" + safeString(concept.prop("SabsaType"))), sourceVisual, visual);
    });

    addVisibleRelationshipsByEndpoint(view, visualsByConcept, [
        "CoreTypeSemanticRelationship",
        "CoreTypeForeignKeyReference",
        "CoreTypeSpecialization"
    ]);

    stats.views++;
    return view;
}

function createForeignKeyRelationView(sourceConcept, tableData, coreTypeConcepts) {
    var view = model.createArchimateView(buildUniqueViewName(CONST.ForeignKeyViewName));
    var sourceVisual;
    var visualsByKey = {};
    var visualsByConcept = {};
    var fkEntries = [];

    view.documentation = "Generated FK field relations from catalogue field tables. Each FK row is shown between its owning SABSA A1 type and the resolved target type.";
    moveViewToFolder(view);

    sourceVisual = addStyledVisual(view, sourceConcept, CONST.Layout.StartX, CONST.Layout.StartY, CONST.Layout.SourceWidth, CONST.Layout.SourceHeight, CONST.Style.SourceFill);
    rememberVisual(visualsByConcept, sourceConcept, sourceVisual);

    function visualKey(concept) {
        return safeString(concept && concept.prop("SabsaA1CatalogueKey"));
    }

    function ensureVisual(concept, x, y, fillColor) {
        var key = visualKey(concept);

        if (!concept || !key) {
            return null;
        }

        if (!visualsByKey[key]) {
            visualsByKey[key] = addStyledVisual(view, concept, x, y, CONST.Layout.CardWidth, CONST.Layout.CardHeight, fillColor);
            rememberVisual(visualsByConcept, concept, visualsByKey[key]);
        }

        return visualsByKey[key];
    }

    tableData.tables.forEach(function (tableConcept) {
        var tableId = safeString(tableConcept.prop("TableId"));
        var title = safeString(tableConcept.prop("TableTitle"));
        var ownerTypes = getCoreTypeConceptsForTitle(coreTypeConcepts, title);
        var rowEntries = tableData.rowsByTableId[tableId] || [];

        ownerTypes.forEach(function (ownerType) {
            rowEntries.forEach(function (rowEntry) {
                if (!isFieldCatalogueRow(rowEntry.data) || safeString(rowEntry.data["Key Role"]) !== "FK") {
                    return;
                }

                getReferencedCoreTypeConcepts(coreTypeConcepts, rowEntry.data).forEach(function (targetType) {
                    fkEntries.push({
                        tableId: tableId,
                        rowEntry: rowEntry,
                        sourceType: ownerType,
                        targetType: targetType
                    });
                });
            });
        });
    });

    fkEntries.forEach(function (entry, index) {
        var baseY = CONST.Layout.StartY + 140 + (index * (CONST.Layout.CardHeight + CONST.Layout.GapY));
        ensureVisual(entry.sourceType, CONST.Layout.StartX, baseY, getConceptFill(entry.sourceType, CONST.Style.TypeFill));
        ensureVisual(tableData.tablesById[entry.tableId], CONST.Layout.StartX + 340, baseY, CONST.Style.RepresentationFill);
        ensureVisual(entry.rowEntry.concept, CONST.Layout.StartX + 680, baseY, getConceptFill(entry.rowEntry.concept, CONST.Style.RepresentationFill));
        ensureVisual(entry.targetType, CONST.Layout.StartX + 1020, baseY, getConceptFill(entry.targetType, CONST.Style.TypeFill));
    });

    addVisibleRelationshipsByEndpoint(view, visualsByConcept, [
        "SourceTableTrace",
        "TableRow",
        "CoreTypeHasField",
        "FieldRowForeignKeyReference",
        "CoreTypeForeignKeyReference"
    ]);

    stats.views++;
    return view;
}

function createTableIndexView(sourceConcept, tableConcepts) {
    return createGridView(CONST.TableIndexViewName, sourceConcept, tableConcepts, CONST.Style.RepresentationFill, CONST.Layout.TypeColumns);
}

function createRelationshipView(sourceConcept, relationshipConcepts, coreTypeConcepts) {
    var view = model.createArchimateView(buildUniqueViewName(CONST.RelationshipViewName));
    var sourceVisual = addStyledVisual(view, sourceConcept, CONST.Layout.StartX, CONST.Layout.StartY, CONST.Layout.SourceWidth, CONST.Layout.SourceHeight, CONST.Style.SourceFill);
    var typeVisuals = {};
    var visualsByConcept = {};
    var typeIndex = 0;

    view.documentation = "Generated from the relationship catalogue in " + CONST.SourceMarkdownPath + ".";
    moveViewToFolder(view);
    rememberVisual(visualsByConcept, sourceConcept, sourceVisual);

    function ensureTypeVisual(typeName) {
        var metaConcept = getCoreTypeConcept(coreTypeConcepts, typeName);
        var pos;
        var visual;

        if (!metaConcept) {
            return null;
        }

        visual = resolveVisualByTypeName(typeVisuals, metaConcept.name);
        if (visual) {
            return visual;
        }

        pos = gridPosition(typeIndex, CONST.Layout.Columns, CONST.Layout.StartX + 980, CONST.Layout.StartY + 120, CONST.Layout.CardWidth, CONST.Layout.CardHeight);
        visual = addStyledVisual(view, metaConcept, pos.x, pos.y, CONST.Layout.CardWidth, CONST.Layout.CardHeight, getConceptFill(metaConcept, CONST.Style.TypeFill));
        typeVisuals[metaConcept.name] = visual;
        typeVisuals[normalizeTypeName(metaConcept.name)] = visual;
        rememberVisual(visualsByConcept, metaConcept, visual);
        typeIndex++;
        return visual;
    }

    relationshipConcepts.forEach(function (concept, index) {
        var pos = gridPosition(index, CONST.Layout.Columns, CONST.Layout.StartX, CONST.Layout.StartY + 120, CONST.Layout.CardWidth, CONST.Layout.CardHeight);
        var relationshipVisual = addStyledVisual(view, concept, pos.x, pos.y, CONST.Layout.CardWidth, CONST.Layout.CardHeight, getConceptFill(concept, CONST.Style.RelationshipFill));

        ensureTypeVisual(concept.prop("SourceType"));
        ensureTypeVisual(concept.prop("TargetType"));
        rememberVisual(visualsByConcept, concept, relationshipVisual);
    });

    addVisibleRelationshipsByEndpoint(view, visualsByConcept, [
        "SourceTrace",
        "RelationshipSource",
        "RelationshipTarget",
        "CoreTypeSemanticRelationship"
    ]);

    stats.views++;
    return view;
}

function createOverlayLibraryOverviewView() {
    var view = model.createArchimateView(buildUniqueViewName(CONST.OverlayOverviewViewName));
    var group;

    view.documentation = "Generated SABSA A1 overlay overview following the security overlay library pattern.";
    moveViewToFolder(view);

    addLibraryNote(
        view,
        "SABSA A1 Overlay Overview\n" +
        "This generator creates metamodel detail views plus an Overlay Type Model and an Overlay Template Library.\n" +
        "Field_* metadata belongs only to CoreType meta elements.",
        CONST.Layout.StartX,
        CONST.Layout.StartY,
        CONST.Layout.LibraryHeaderWidth,
        CONST.Layout.LibraryHeaderHeight,
        CONST.Style.LibraryHeaderFill
    );

    group = addLibraryGroup(
        view,
        "Created Overlay Library Views",
        CONST.Layout.LibraryGroupX,
        CONST.Layout.LibraryGroupY,
        CONST.Layout.LibraryGroupWidth,
        160,
        CONST.Style.LibraryGroupFill
    );

    addLibraryNote(group, "Overlay Type Model\nMeta types and meta relationships.", CONST.Layout.LibraryGroupInnerX, CONST.Layout.LibraryGroupInnerY, CONST.Layout.OverviewCardWidth, CONST.Layout.OverviewCardHeight, CONST.Style.LibraryTypeGroupFill);
    addLibraryNote(group, "Overlay Template Library\nSample/template elements with concrete field values only.", CONST.Layout.LibraryGroupInnerX + CONST.Layout.OverviewGapX, CONST.Layout.LibraryGroupInnerY, CONST.Layout.OverviewCardWidth, CONST.Layout.OverviewCardHeight, CONST.Style.LibraryTemplateGroupFill);

    stats.views++;
    return view;
}

function groupCoreTypesByBaseType(coreTypeConcepts) {
    var grouped = {};

    Object.keys(coreTypeConcepts || {}).forEach(function (typeName) {
        var concept = coreTypeConcepts[typeName];
        var baseType = safeString(concept.prop(CONST.Property.BaseType)) || safeString(concept.prop("RecommendedArchiMateType")) || concept.type || "grouping";

        if (!grouped[baseType]) {
            grouped[baseType] = [];
        }
        grouped[baseType].push(concept);
    });

    return grouped;
}

function createOverlayTypeModelView(coreTypeConcepts, relationshipConcepts) {
    var view = model.createArchimateView(buildUniqueViewName(CONST.OverlayTypeModelViewName));
    var grouped = groupCoreTypesByBaseType(coreTypeConcepts);
    var currentY = CONST.Layout.LibraryGroupY;
    var typeLabel = "«Overlay Type»\n${name}\n${property:BaseType}";
    var relationshipLabel = "«Relationship Type»\n${name}\n${property:BaseType}";

    view.documentation = "Generated SABSA A1 overlay type model. Meta elements define the available overlay types.";
    moveViewToFolder(view);

    addLibraryNote(
        view,
        "SABSA A1 Overlay Type Model\nMeta CoreType elements own Field_* metadata. Relationship catalogue entries are shown as relationship-type cards.",
        CONST.Layout.StartX,
        CONST.Layout.StartY,
        CONST.Layout.LibraryHeaderWidth,
        CONST.Layout.LibraryHeaderHeight,
        CONST.Style.LibraryHeaderFill
    );

    Object.keys(grouped).sort().forEach(function (baseType) {
        var concepts = grouped[baseType];
        var groupHeight = calculateLibraryGroupHeight(concepts.length);
        var group = addLibraryGroup(view, baseType, CONST.Layout.LibraryGroupX, currentY, CONST.Layout.LibraryGroupWidth, groupHeight, CONST.Style.LibraryTypeGroupFill);

        concepts.forEach(function (concept, index) {
            addLibraryConcept(group, concept, index, getConceptFill(concept, CONST.Style.TypeFill), typeLabel);
        });

        currentY = nextLibraryGroupY(currentY, groupHeight);
    });

    if (relationshipConcepts && relationshipConcepts.length) {
        var relationshipGroupHeight = calculateLibraryGroupHeight(relationshipConcepts.length);
        var relationshipGroup = addLibraryGroup(view, "Relationship Types", CONST.Layout.LibraryGroupX, currentY, CONST.Layout.LibraryGroupWidth, relationshipGroupHeight, CONST.Style.RelationshipFill);

        relationshipConcepts.forEach(function (concept, index) {
            addLibraryConcept(relationshipGroup, concept, index, getConceptFill(concept, CONST.Style.RelationshipFill), relationshipLabel);
        });
    }

    stats.views++;
    return view;
}

function createOverlayTemplateLibraryView(samplesByType) {
    var view = model.createArchimateView(buildUniqueViewName(CONST.OverlayTemplateLibraryViewName));
    var samples = Object.keys(samplesByType || {}).sort().map(function (typeName) {
        return samplesByType[typeName];
    });
    var grouped = {};
    var currentY = CONST.Layout.LibraryGroupY;
    var templateLabel = "«${specialization}»\n${name}\n${property:BaseType}";

    view.documentation = "Generated SABSA A1 overlay template library. Templates carry concrete field values only.";
    moveViewToFolder(view);

    addLibraryNote(
        view,
        "SABSA A1 Overlay Template Library\nSample/template elements are specialized and carry concrete field values. Field_* metadata stays on the linked CoreType meta element.",
        CONST.Layout.StartX,
        CONST.Layout.StartY,
        CONST.Layout.LibraryHeaderWidth,
        CONST.Layout.LibraryHeaderHeight,
        CONST.Style.LibraryHeaderFill
    );

    samples.forEach(function (sample) {
        var baseType = safeString(sample.prop(CONST.Property.BaseType)) || sample.type || "grouping";

        if (!grouped[baseType]) {
            grouped[baseType] = [];
        }
        grouped[baseType].push(sample);
    });

    Object.keys(grouped).sort().forEach(function (baseType) {
        var concepts = grouped[baseType];
        var groupHeight = calculateLibraryGroupHeight(concepts.length);
        var group = addLibraryGroup(view, baseType, CONST.Layout.LibraryGroupX, currentY, CONST.Layout.LibraryGroupWidth, groupHeight, CONST.Style.LibraryTemplateGroupFill);

        concepts.forEach(function (concept, index) {
            addLibraryConcept(group, concept, index, getConceptFill(concept, CONST.Style.TypeFill), templateLabel);
        });

        currentY = nextLibraryGroupY(currentY, groupHeight);
    });

    stats.views++;
    return view;
}

function validateCounts(summary, mode) {
    if (!summary.genericTables || !summary.genericRows) {
        throw new Error("The field catalogue did not yield tables and rows.");
    }
    if (shouldGenerateMeta(mode) && (!summary.layers || !summary.coreTypes || !summary.relationships)) {
        throw new Error("The field catalogue did not yield layers, core types and relationships.");
    }
}

function confirmExecution(summary, mode) {
    return dialogs.confirmInfo(
        "This script will parse the Generic SABSA A1 Metamodel Field Catalogue and create " + modeLabel(mode) + " ArchiMate elements/views." +
        "\n\nSource Markdown: " + CONST.SourceMarkdownPath +
        "\nMode: " + mode +
        "\nAll catalogue tables: " + summary.genericTables +
        "\nAll catalogue rows: " + summary.genericRows +
        "\nField definitions: " + summary.fieldDefinitions +
        (shouldGenerateMeta(mode) ? "\nNamed element relations: generated from relationship and FK catalogue rows" : "") +
        (shouldGenerateMeta(mode) ? "\nOverlay samples: generated after stereotype metadata is built" : "") +
        "\nLayers: " + summary.layers +
        "\nCore types: " + summary.coreTypes +
        "\nRelationships: " + summary.relationships +
        "\nViewpoints: " + summary.viewpoints +
        "\n\nDo you want to continue?",
        "Run SABSA A1 " + modeLabel(mode) + " Generator"
    );
}

function main() {
    var mode = getExecutionMode();
    var markdown = readUtf8Text(CONST.SourceMarkdownPath);
    var parsedTableBlocks = parseMarkdownTableBlocks(markdown);
    var summary = {
        genericTables: parsedTableBlocks.length,
        genericRows: parsedTableBlocks.reduce(function (sum, block) {
            return sum + block.rows.length;
        }, 0),
        fieldDefinitions: parsedTableBlocks.reduce(function (sum, block) {
            return sum + block.rows.filter(isFieldCatalogueRow).length;
        }, 0),
        layers: extractTableAfterMarker(markdown, "Table 3-LA01 - SABSA Architecture Layer Alignment").length,
        coreTypes: extractTableAfterMarker(markdown, "Table 6-01 - Core Type Inventory").length,
        relationships: extractTableAfterMarker(markdown, "Table 6-03 - Relationship Catalogue").length,
        viewpoints: extractTableAfterMarker(markdown, "Table 6-05 - Recommended Architecture Viewpoints").length
    };
    var sourceConcept;
    var tableData;
    var layerConcepts;
    var coreTypeConcepts;
    var relationshipConcepts;
    var viewpointConcepts;
    var samplesByType;
    var sampleRelationships;

    if (!model) {
        throw new Error("No active model is open.");
    }

    validateCounts(summary, mode);

    if (!confirmExecution(summary, mode)) {
        logger.info("SABSA A1 field catalogue generation cancelled by user.", {
            source_markdown: CONST.SourceMarkdownPath,
            mode: mode
        }, "sabsa.a1.catalogue.generation.cancelled");
        return;
    }

    logger.start("SABSA A1 field catalogue generation started.", {
        source_markdown: CONST.SourceMarkdownPath,
        mode: mode
    });

    sourceConcept = createSourceConcept(markdown);

    if (shouldGenerateTables(mode)) {
        tableData = createCompleteTableCatalogueConcepts(markdown, sourceConcept);
        createTableIndexView(sourceConcept, tableData.tables);
    } else {
        tableData = createTableCatalogueReferenceData(markdown);
    }

    if (shouldGenerateMeta(mode)) {
        layerConcepts = createLayerConcepts(markdown, sourceConcept);
        coreTypeConcepts = createCoreTypeConcepts(markdown, sourceConcept);
        relationshipConcepts = createRelationshipConcepts(markdown, sourceConcept, coreTypeConcepts);
        viewpointConcepts = createViewpointConcepts(markdown, sourceConcept);
        linkTableRowsToConcepts(tableData, layerConcepts, coreTypeConcepts, relationshipConcepts, viewpointConcepts);
        applyCoreTypeSpecializationMetadata(coreTypeConcepts);
        samplesByType = createSampleConcepts(coreTypeConcepts);
        sampleRelationships = createSampleRelationships(tableData, coreTypeConcepts, samplesByType);
        cleanupNonMetaFieldMetadataProperties();
        persistOverlayIndexes(coreTypeConcepts, relationshipConcepts);

        createGridView(CONST.LayerViewName, sourceConcept, layerConcepts, CONST.Style.LayerFill, CONST.Layout.Columns);
        createTypeView(sourceConcept, coreTypeConcepts);
        createForeignKeyRelationView(sourceConcept, tableData, coreTypeConcepts);
        createRelationshipView(sourceConcept, relationshipConcepts, coreTypeConcepts);
        createGridView(CONST.ViewpointViewName, sourceConcept, viewpointConcepts, CONST.Style.ViewpointFill, CONST.Layout.Columns);
        createSampleOverviewView(samplesByType, sampleRelationships);
        createOverlayLibraryOverviewView();
        createOverlayTypeModelView(coreTypeConcepts, relationshipConcepts);
        createOverlayTemplateLibraryView(samplesByType);
    }

    logger.finish("SABSA A1 field catalogue generation finished.", {
        mode: mode,
        layers: stats.layers,
        core_types: stats.coreTypes,
        relationships: stats.relationships,
        viewpoints: stats.viewpoints,
        generic_tables: stats.genericTables,
        generic_rows: stats.genericRows,
        field_definitions: stats.fieldDefinitions,
        named_element_relations: stats.elementRelations,
        samples: stats.samples,
        sample_relationships: stats.sampleRelationships,
        views: stats.views,
        concepts_created: stats.conceptsCreated,
        concepts_reused: stats.conceptsReused,
        relationships_created: stats.relationshipsCreated,
        relationships_reused: stats.relationshipsReused,
        field_metadata_properties_removed: stats.fieldMetadataPropertiesRemoved,
        view_connections_created: stats.viewConnectionsCreated,
        view_connections_skipped: stats.viewConnectionsSkipped
    });

    dialogs.showInfo(
        "Generated views: " + stats.views +
        "\nMode: " + mode +
        "\nAll catalogue tables: " + stats.genericTables +
        "\nAll catalogue rows: " + stats.genericRows +
        "\nField definitions: " + stats.fieldDefinitions +
        "\nNamed element relations: " + stats.elementRelations +
        "\nSamples: " + stats.samples +
        "\nSample relationships: " + stats.sampleRelationships +
        "\nLayers: " + stats.layers +
        "\nCore types: " + stats.coreTypes +
        "\nRelationships: " + stats.relationships +
        "\nViewpoints: " + stats.viewpoints +
        "\nConcepts created: " + stats.conceptsCreated +
        "\nConcepts reused: " + stats.conceptsReused +
        "\nRelationships created: " + stats.relationshipsCreated +
        "\nRelationships reused: " + stats.relationshipsReused +
        "\nField metadata properties removed: " + stats.fieldMetadataPropertiesRemoved +
        "\nView connections created: " + stats.viewConnectionsCreated +
        "\nView connections skipped: " + stats.viewConnectionsSkipped,
        "SABSA A1 " + modeLabel(mode)
    );
}

main();
