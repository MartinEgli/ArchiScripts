    },
    Property: {
        Namespace: "Namespace",
        Kind: "Kind",
        BaseType: "BaseType",
        Category: "Category",
        TypeName: "TypeName",
        ConceptType: "ConceptType",
        Stereotype: "Stereotype",
        DefaultLabelExpression: "DefaultLabelExpression",
        MetaElementKey: "MetaElementKey",
        TemplateIndexJson: "SabsaA1OverlayTemplateIndexJson",
        RelationshipIndexJson: "SabsaA1OverlayRelationshipIndexJson"
    },
    LabelExpression: {
        Stereotype: "«SABSA A1 ${specialization}»\n${name}",
        Fallback: "«${property:Stereotype}»\n${name}"
    },
    Layout: {
        StartX: 40,
        StartY: 40,
        SourceWidth: 360,
        SourceHeight: 72,
        CardWidth: 260,
        CardHeight: 76,
        GapX: 26,
        GapY: 22,
        Columns: 4,
        TypeColumns: 5,
        LibraryGroupX: 40,
        LibraryGroupY: 150,
        LibraryGroupWidth: 1460,
        LibraryGroupInnerX: 22,
        LibraryGroupInnerY: 36,
        LibraryGroupGapY: 28,
        LibraryGroupColumns: 4,
        LibraryHeaderWidth: 980,
        LibraryHeaderHeight: 88,
        OverviewCardWidth: 420,
        OverviewCardHeight: 94,
        OverviewGapX: 460
    },
    Style: {
        SourceFill: "#fff7cc",
        ContextualFill: "#ff9aff",
        ConceptualFill: "#ccccff",
        LogicalFill: "#ccffff",
        PhysicalFill: "#ccff9a",
        ComponentFill: "#ffff9a",
        ManagementFill: "#ffcc64",
        ColumnFill: "#ff9a69",
        CellFill: "#ffff64",
        RepresentationFill: "#ffffcc",
        LayerFill: "#dff7ff",
        TypeFill: "#ffff9a",
        RelationshipFill: "#ffcc64",
        ViewpointFill: "#ccff9a",
        SupportFill: "#f3f3f3",
        LibraryHeaderFill: "#eef5ff",
        LibraryGroupFill: "#f9f9f9",
        LibraryTypeGroupFill: "#eaf0ff",
        LibraryTemplateGroupFill: "#f8f5ea",
        LineColor: "#111111",
        FontColor: "#111111",
        LayerFillByPrefix: {
            "L1": "#ff9aff",
            "L2": "#ccccff",
            "L3": "#ccffff",
            "L4": "#ccff9a",
            "L5": "#ffff9a",
            "L6": "#ffcc64"
        }
    }
};

var stats = {
    layers: 0,
    coreTypes: 0,
    relationships: 0,
    viewpoints: 0,
    genericTables: 0,
    genericRows: 0,
    fieldDefinitions: 0,
    elementRelations: 0,
    samples: 0,
    sampleRelationships: 0,
    views: 0,
    conceptsCreated: 0,
    conceptsReused: 0,
    relationshipsCreated: 0,
    relationshipsReused: 0,
    relationshipLinks: 0,
    viewConnectionsCreated: 0,
    viewConnectionsSkipped: 0,
    fieldMetadataPropertiesRemoved: 0
};

function safeString(value) {
    return value === null || typeof value === "undefined" ? "" : String(value);
}

function getExecutionMode() {
    var mode = typeof SABSA_A1_FIELD_CATALOGUE_MODE === "undefined"
        ? "combined"
        : safeString(SABSA_A1_FIELD_CATALOGUE_MODE).toLowerCase();

    if (mode === "table") {
        return "tables";
    }
    if (mode === "metamodel") {
        return "meta";
    }
    if (mode === "tables" || mode === "meta" || mode === "combined") {
        return mode;
    }

    throw new Error("Unsupported SABSA A1 field catalogue mode: " + mode);
}

function shouldGenerateTables(mode) {
    return mode === "tables" || mode === "combined";
}

function shouldGenerateMeta(mode) {
    return mode === "meta" || mode === "combined";
}

function modeLabel(mode) {
    if (mode === "tables") {
        return "Table Catalogue";
    }
    if (mode === "meta") {
        return "Metamodel Overlay";
    }
    return "Complete Catalogue";
}

function trim(value) {
    return safeString(value).replace(/^\s+|\s+$/g, "");
}

function slugify(value) {
    return trim(value)
        .toLowerCase()
        .replace(/&/g, "and")
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/^-+|-+$/g, "");
}

function propertyKey(value) {
    return stripMarkup(value)
        .toLowerCase()
        .replace(/&/g, "and")
        .replace(/[^a-z0-9]+/g, "_")
        .replace(/^_+|_+$/g, "");
}

function stripMarkup(value) {
    return trim(value)
        .replace(/<[^>]+>/g, "")
        .replace(/`/g, "")
        .replace(/\*\*/g, "")
        .replace(/\s+/g, " ");
}

function displayName(value) {
    return stripMarkup(value)
        .replace(/_/g, " ")
        .replace(/\s+/g, " ")
        .trim();
}

function normalizeFolderName(folderName) {
    return safeString(folderName)
        .toLowerCase()
        .replace(/&/g, "and")
        .replace(/[^a-z0-9]+/g, " ")
        .replace(/\s+/g, " ")
        .trim();
}

function readUtf8Text(absolutePath) {
    return String(new java.lang.String(
        Files.readAllBytes(Paths.get(absolutePath)),
        StandardCharsets.UTF_8
    ));
}

function getTopLevelFolder(rootName) {
    var aliasesByFolderName = {
        "Business": ["Business"],
        "Motivation": ["Motivation"],
        "Strategy": ["Strategy"],
        "Other": ["Other", "Connectors"],
        "Views": ["Views"],
        "Relations": ["Relations", "Relations/Connectors", "Connectors"]
    };
    var wantedNames = (aliasesByFolderName[rootName] || [rootName]).map(normalizeFolderName);
    var foundFolder = null;

    $(model).children("folder").each(function (folder) {
        if (foundFolder) {
            return;
        }

        if (wantedNames.indexOf(normalizeFolderName(folder.name)) >= 0) {
            foundFolder = folder;
        }
    });

    return foundFolder;
}

function ensureChildFolder(parentFolder, childName) {
    var childFolder = $(parentFolder).children("folder").filter(function (folder) {
        return safeString(folder.name) === safeString(childName);
    }).first();

    if (childFolder) {
        return childFolder;
    }

    return parentFolder.createFolder(childName);
}

function ensureFolderPath(rootName, pathSegments) {
    var currentFolder = getTopLevelFolder(rootName);

    if (!currentFolder) {
        throw new Error("Top-level folder not found: " + rootName);
    }

    (pathSegments || []).forEach(function (segment) {
        currentFolder = ensureChildFolder(currentFolder, segment);
    });

    return currentFolder;
}

function getModelFolderSegments(extraSegments) {
    var segments = [CONST.Folder.OverlayModel, CONST.Folder.Root, CONST.Folder.A1, CONST.Folder.ModelName];

    (extraSegments || []).forEach(function (segment) {
        segments.push(segment);
    });

    return segments;
}

function resolveConceptPlacement(conceptType, properties) {
    var kind = safeString(properties && properties.SabsaA1CatalogueKind);
    var folder = kind === "Layer" ? CONST.Folder.Layers :
        kind === "CoreType" ? CONST.Folder.CoreTypes :
            kind === "Relationship" ? CONST.Folder.Relationships :
                kind === "Viewpoint" ? CONST.Folder.Viewpoints :
                    kind === "Table" ? CONST.Folder.Tables :
                        kind === "TableRow" ? CONST.Folder.TableRows :
                            kind === "Sample" ? CONST.Folder.Samples : CONST.Folder.Source;

    if (conceptType === "goal" || conceptType === "requirement" || conceptType === "constraint" ||
        conceptType === "assessment" || conceptType === "outcome" || conceptType === "driver") {
        return { rootName: "Motivation", pathSegments: getModelFolderSegments([folder]) };
    }

    if (conceptType === "capability" || conceptType === "course-of-action") {
        return { rootName: "Strategy", pathSegments: getModelFolderSegments([folder]) };
    }

    if (conceptType === "grouping") {
        return { rootName: "Other", pathSegments: getModelFolderSegments([folder]) };
    }

    return { rootName: "Business", pathSegments: getModelFolderSegments([folder]) };
}

function moveObjectToFolder(rootName, pathSegments, objectToMove) {
    if (!objectToMove) {
        return null;
    }

    ensureFolderPath(rootName, pathSegments).add(objectToMove);
    return objectToMove;
}

function moveConceptToFolder(concept, conceptType, properties) {
    var placement = resolveConceptPlacement(conceptType, properties);
    return moveObjectToFolder(placement.rootName, placement.pathSegments, concept);
}

function moveRelationshipToFolder(relationship) {
    return moveObjectToFolder("Relations", getModelFolderSegments([CONST.Folder.Relationships]), relationship);
}

function moveViewToFolder(viewObject) {
    return moveObjectToFolder("Views", [CONST.Folder.OverlayModel, CONST.Folder.Root, CONST.Folder.A1], viewObject);
}

function buildUniqueViewName(baseName) {
    var candidate = baseName;
    var suffix = 2;

    while ($("view").filter(function (viewObject) {
        return safeString(viewObject.name) === candidate;
    }).first()) {
        candidate = baseName + " (" + suffix + ")";
        suffix++;
    }

    return candidate;
}

function findConceptByKey(conceptType, key) {
    return $(conceptType).filter(function (concept) {
        return safeString(concept.prop("SabsaA1CatalogueKey")) === safeString(key);
    }).first();
}

function ensureConcept(conceptType, name, key, properties, documentation) {
    var concept = findConceptByKey(conceptType, key);
    var conceptCreated = false;

    if (!concept) {
        var placement = resolveConceptPlacement(conceptType, properties);
        concept = model.createElement(conceptType, displayName(name) || safeString(name), ensureFolderPath(placement.rootName, placement.pathSegments));
        conceptCreated = true;
        stats.conceptsCreated++;
    } else {
        stats.conceptsReused++;
    }

    concept.name = displayName(name) || safeString(name);
    concept.documentation = documentation || "";
    concept.prop("SabsaA1CatalogueKey", key);
    setCommonSourceProperties(concept, safeString(properties && properties.SabsaA1CatalogueKind));
    setProperties(concept, properties);
    if (!canOwnFieldMetadata(properties)) {
        stats.fieldMetadataPropertiesRemoved += removeFieldMetadataProperties(concept);
    }
    applyOverlayStereotype(concept, conceptType, properties);

    if (conceptCreated) {
        moveConceptToFolder(concept, conceptType, properties);
    }

    return concept;
}

function findRelationshipByKey(key) {
    return $("relationship").filter(function (relationship) {
        return safeString(relationship.prop("SabsaA1CatalogueKey")) === safeString(key);
    }).first();
}

function ensureRelationship(relationshipType, sourceConcept, targetConcept, key, name, properties) {
    var relationship = findRelationshipByKey(key);
    var relationshipCreated = false;

    if (!sourceConcept || !targetConcept) {
        return null;
    }

    if (!relationship) {
        try {
            relationship = model.createRelationship(relationshipType, displayName(name) || safeString(name), sourceConcept, targetConcept);
        } catch (error) {
            relationship = model.createRelationship("association-relationship", displayName(name) || safeString(name), sourceConcept, targetConcept);
        }
        relationshipCreated = true;
        stats.relationshipsCreated++;
    } else {
        stats.relationshipsReused++;
    }

    relationship.name = displayName(name) || safeString(name);
    relationship.prop("SabsaA1CatalogueKey", key);
    setCommonSourceProperties(relationship, "Relationship");
    setProperties(relationship, properties);
    applyRelationshipStereotype(relationship, relationshipType, properties);

    if (relationshipCreated) {
        moveRelationshipToFolder(relationship);
    }

    stats.relationshipLinks++;
    return relationship;
}

function parseMarkdownTableLines(lines) {
    var rows = [];
    var headers = [];

    lines.forEach(function (line, index) {
        var cells;

        if (line.indexOf("|") < 0) {
            return;
        }

        cells = line.replace(/^\s*\|/, "").replace(/\|\s*$/, "").split("|").map(function (cell) {
            return trim(cell);
        });

        if (index === 0) {
            headers = cells;
            return;
        }

        if (cells.join("").replace(/-/g, "").replace(/:/g, "") === "") {
            return;
        }

        rows.push({ headers: headers, cells: cells });
    });

    return rows;
}

function extractTableAfterMarker(markdown, marker) {
    var markerIndex = markdown.indexOf(marker);
    var lines;
    var tableLines = [];
    var started = false;
    var stopped = false;

    if (markerIndex < 0) {
        return [];
    }

    lines = markdown.substring(markerIndex).split(/\r?\n/);
    lines.forEach(function (line) {
        if (stopped) {
            return;
        }

        if (trim(line).indexOf("|") === 0) {
            tableLines.push(line);
            started = true;
            return;
        }

        if (started) {
            stopped = true;
        }
    });

    return parseMarkdownTableLines(tableLines);
}

function parseTableCaption(captionLine, fallbackIndex) {
    var cleanCaption = stripMarkup(captionLine);
    var match = cleanCaption.match(/Table\s+([A-Za-z0-9.\-]+)\s+-\s+([^\.]+)\./);
    var tableId = match ? match[1] : "unknown-" + fallbackIndex;
    var title = match ? match[2] : cleanCaption;

    return {
        id: tableId,
        title: trim(title),
        caption: cleanCaption
    };
}

function parseMarkdownTableBlocks(markdown) {
    var lines = markdown.split(/\r?\n/);
    var blocks = [];
    var lastCaption = "";
    var i = 0;

    while (i < lines.length) {
        var line = trim(lines[i]);

        if (line.indexOf("**Table ") === 0) {
            lastCaption = line;
            i++;
            continue;
        }

        if (line.indexOf("|") === 0) {
            var tableLines = [];
            var startLine = i + 1;
            while (i < lines.length && trim(lines[i]).indexOf("|") === 0) {
                tableLines.push(lines[i]);
                i++;
            }

            if (lastCaption && tableLines.length >= 2) {
                var parsedCaption = parseTableCaption(lastCaption, blocks.length + 1);
                var parsedRows = parseMarkdownTableLines(tableLines);
                blocks.push({
                    id: parsedCaption.id,
                    title: parsedCaption.title,
                    caption: parsedCaption.caption,
                    startLine: String(startLine),
                    headers: parsedRows.length ? parsedRows[0].headers : [],
                    rows: parsedRows.map(rowToObject)
                });
                lastCaption = "";
            }
            continue;
        }

        i++;
    }

    return blocks;
}

function rowToObject(row) {
    var result = {};
    row.headers.forEach(function (header, index) {
        result[stripMarkup(header)] = stripMarkup(row.cells[index] || "");
    });
    return result;
}

function buildDocumentation(title, properties) {
    var lines = [title, ""];
    Object.keys(properties || {}).forEach(function (key) {
        lines.push(key + ": " + safeString(properties[key]));
    });
    return lines.join("\n");
}

function setProperties(target, properties) {
    Object.keys(properties || {}).forEach(function (propertyName) {
        target.prop(propertyName, safeString(properties[propertyName]));
    });
}

function isFieldMetadataProperty(propertyName) {
    return /^Field_/.test(safeString(propertyName)) || /^FieldDefault_/.test(safeString(propertyName));
}

function isRedundantFieldMetadataProperty(propertyName) {
    return /^Field_.*_(Name|Datatype|Required|KeyRole|TemplateFamily|Description|SourceTable|DefaultValue)$/.test(safeString(propertyName)) ||
        /^FieldDefault_/.test(safeString(propertyName));
}

function canOwnFieldMetadata(properties) {
    return safeString(properties && properties.SabsaA1CatalogueKind) === "CoreType";
}

function removeFieldMetadataProperties(target) {
    var removed = 0;

    if (!target || !target.prop) {
        return removed;
    }

    target.prop().forEach(function (propertyName) {
        if (isFieldMetadataProperty(propertyName)) {
            target.removeProp(propertyName);
            removed++;
        }
    });

    return removed;
}

function removeRedundantFieldMetadataProperties(target) {
    var removed = 0;

    if (!target || !target.prop) {
        return removed;
    }

    target.prop().forEach(function (propertyName) {
        if (isRedundantFieldMetadataProperty(propertyName)) {
            target.removeProp(propertyName);
            removed++;
        }
    });

    return removed;
}

function isSabsaA1CatalogueOrOverlayObject(object) {
    return safeString(object.prop("SabsaA1CatalogueKind")) !== "" ||
        safeString(object.prop("SabsaA1CatalogueRelationKind")) !== "" ||
        safeString(object.prop(CONST.Property.Namespace)) === CONST.Namespace ||
        safeString(object.prop(CONST.Property.MetaElementKey)) !== "";
}

function canConceptOwnFieldMetadata(concept) {
    return safeString(concept.prop("SabsaA1CatalogueKind")) === "CoreType";
}

function cleanupNonMetaFieldMetadataProperties() {
    $("element").each(function (concept) {
        if (!isSabsaA1CatalogueOrOverlayObject(concept)) {
            return;
        }

        if (canConceptOwnFieldMetadata(concept)) {
            stats.fieldMetadataPropertiesRemoved += removeRedundantFieldMetadataProperties(concept);
        } else {
            stats.fieldMetadataPropertiesRemoved += removeFieldMetadataProperties(concept);
        }
    });

    $("relationship").each(function (relationship) {
        if (!isSabsaA1CatalogueOrOverlayObject(relationship)) {
            return;
        }

        stats.fieldMetadataPropertiesRemoved += removeFieldMetadataProperties(relationship);
    });
}

function specializationName(value) {
    return displayName(value)
        .replace(/[^A-Za-z0-9 -]+/g, " ")
        .replace(/\s+/g, " ")
        .trim();
}

function tryCreateSpecialization(name, conceptType) {
    if (!name || !conceptType) {
        return;
    }

    try {
        model.createSpecialization(name, conceptType);
    } catch (error) {
        logger.debug("Specialization already exists or could not be created.", {
            specialization: name,
            concept_type: conceptType,
            error: String(error)
        }, "sabsa.a1.overlay.specialization.skipped");
    }
}

function getOverlayTypeName(conceptType, properties) {
    var kind = safeString(properties && properties.SabsaA1CatalogueKind);

    if (properties && properties.TypeName) {
        return specializationName(properties.TypeName);
    }
    if (kind === "CoreType") {
        return specializationName(properties.SabsaType);
    }
    if (kind === "Relationship") {
        return specializationName(properties.Relationship || "SABSA A1 Relationship");
    }
    if (kind === "Viewpoint") {
        return specializationName(properties.Viewpoint || "SABSA A1 Viewpoint");
    }
    if (kind === "Layer") {
        return specializationName(properties.Layer || "SABSA A1 Layer");
    }
    if (kind === "Table") {
        return "SABSA A1 Catalogue Table";
    }
    if (kind === "TableRow") {
        return properties && properties.FieldName ? specializationName("SABSA A1 Field " + properties.FieldName) : "SABSA A1 Catalogue Row";
    }
    if (kind === "Sample") {
        return specializationName(properties.SabsaType || properties.TypeName || "SABSA A1 Sample");
    }
    if (kind === "Source") {
        return "SABSA A1 Source";
    }

    return specializationName(conceptType || "SABSA A1 Element");
}

function getOverlayKind(properties) {
    var kind = safeString(properties && properties.SabsaA1CatalogueKind);

    if (kind === "CoreType" || kind === "Layer" || kind === "Viewpoint") {
        return CONST.Kind.MetaType;
    }
    if (kind === "Relationship") {
        return CONST.Kind.MetaRelationship;
    }
    if (kind === "Sample") {
        return CONST.Kind.Sample;
    }
    if (kind === "Table") {
        return CONST.Kind.Table;
    }
    if (kind === "TableRow") {
        return CONST.Kind.TableRow;
    }
    if (kind === "Source") {
        return CONST.Kind.Source;
    }

    return CONST.Kind.MetaType;
}

function getOverlaySpecialization(typeName, overlayKind) {
    if (overlayKind === CONST.Kind.MetaType) {
        return "Overlay Type";
    }

    return typeName;
}

function applyOverlayStereotype(target, conceptType, properties) {
    var typeName = getOverlayTypeName(conceptType, properties);
    var overlayKind = getOverlayKind(properties);
    var specialization = getOverlaySpecialization(typeName, overlayKind);

    if (!target || !typeName || !specialization) {
        return;
    }

    tryCreateSpecialization(specialization, conceptType);
    try {
        target.specialization = specialization;
    } catch (error) {
        logger.debug("Could not apply specialization.", {
            specialization: specialization,
            concept_type: conceptType,
            error: String(error)
        }, "sabsa.a1.overlay.specialization.apply.skipped");
    }

    target.prop(CONST.Property.Namespace, CONST.Namespace);
    target.prop(CONST.Property.Kind, overlayKind);
    target.prop(CONST.Property.BaseType, conceptType);
    target.prop(CONST.Property.TypeName, typeName);
    target.prop(CONST.Property.ConceptType, conceptType);
    target.prop(CONST.Property.Stereotype, "«SABSA A1 " + specialization + "»");
    target.prop(CONST.Property.DefaultLabelExpression, CONST.LabelExpression.Stereotype);
}

function getRelationshipTypeName(relationshipType, properties) {
    if (properties && properties.RelationshipTypeName) {
        return specializationName(properties.RelationshipTypeName);
    }
    if (properties && properties.RelationshipLabel) {
        return specializationName(properties.RelationshipLabel);
    }
    if (properties && properties.SabsaA1CatalogueRelationKind) {
        return specializationName(properties.SabsaA1CatalogueRelationKind);
    }
    return specializationName(relationshipType || "SABSA A1 Relationship");
}

function applyRelationshipStereotype(relationship, relationshipType, properties) {
    var typeName = getRelationshipTypeName(relationshipType, properties);

    if (!relationship || !typeName) {
        return;
    }

    tryCreateSpecialization(typeName, relationshipType);
    try {
        relationship.specialization = typeName;
    } catch (error) {
        logger.debug("Could not apply relationship specialization.", {
            specialization: typeName,
            relationship_type: relationshipType,
            error: String(error)
        }, "sabsa.a1.overlay.relationship.specialization.skipped");
    }

    relationship.prop(CONST.Property.Namespace, CONST.Namespace);
    relationship.prop(CONST.Property.Kind, safeString(properties && properties.RelationshipKind) || CONST.Kind.MetaRelationship);
    relationship.prop(CONST.Property.BaseType, relationshipType);
    relationship.prop(CONST.Property.TypeName, typeName);
    relationship.prop(CONST.Property.ConceptType, relationshipType);
    relationship.prop(CONST.Property.Stereotype, "«SABSA A1 " + typeName + "»");
    relationship.prop(CONST.Property.DefaultLabelExpression, CONST.LabelExpression.Stereotype);
}

function setCommonSourceProperties(target, sourceKind) {
    target.prop("SourceMarkdown", CONST.SourceMarkdownPath);
    target.prop("SourceDocumentName", CONST.SourceDocumentName);
    target.prop("ExtractorScript", SCRIPT_NAME);
    if (sourceKind) {
        target.prop("SourceKind", sourceKind);
    }
}

function applyTableProperties(target, data) {
    Object.keys(data || {}).forEach(function (columnName) {
        target.prop("Table_" + slugify(columnName), data[columnName]);
    });
}

function isFieldCatalogueRow(data) {
    return !!(data && data.Field && data.Datatype && data.Required);
}

function getFieldPropertyPrefix(fieldName) {
    return "Field_" + propertyKey(fieldName);
}

function buildFieldDescriptor(data) {
    return [
        "datatype=" + safeString(data.Datatype),
        "required=" + safeString(data.Required),
        "keyRole=" + safeString(data["Key Role"]),
        "templateFamily=" + safeString(data["Template Family"]),
        "description=" + safeString(data.Note)
    ].join("; ");
}

function parseDescriptorValue(descriptor, key) {
    var wanted = safeString(key).toLowerCase();
    var value = "";

    safeString(descriptor).split(/\s*;\s*/).forEach(function (part) {
        var index = part.indexOf("=");
        var partKey;

        if (index < 0 || value) {
            return;
        }

        partKey = part.substring(0, index).toLowerCase();
        if (partKey === wanted) {
            value = part.substring(index + 1);
        }
    });

    return value;
}

function getFieldDescriptor(metaConcept, fieldName) {
    return safeString(metaConcept.prop(getFieldPropertyPrefix(fieldName)));
}

function getFieldDatatype(metaConcept, fieldName) {
    return parseDescriptorValue(getFieldDescriptor(metaConcept, fieldName), "datatype");
}

function getFieldKeyRole(metaConcept, fieldName) {
    return parseDescriptorValue(getFieldDescriptor(metaConcept, fieldName), "keyRole");
}

function getFieldDescription(metaConcept, fieldName) {
    return parseDescriptorValue(getFieldDescriptor(metaConcept, fieldName), "description");
}

function parseJsonObject(value) {
    try {
        return JSON.parse(safeString(value) || "{}");
    } catch (error) {
        return {};
    }
}

function isReferenceField(metaConcept, fieldName) {
    var keyRole = getFieldKeyRole(metaConcept, fieldName);

    return keyRole === "FK" || (keyRole !== "PK" && /(^|_)ids?$/.test(propertyKey(fieldName)));
}

function getFieldRoleLabel(data) {
    return stripMarkup(data && data["Key Role"]) || "Property";
}

function applyFieldCatalogueProperties(target, rows, sourceTableId) {
    var fieldNames = [];
    var requiredFieldNames = [];
    var primaryKeyFieldNames = [];
    var foreignKeyFieldNames = [];

    (rows || []).forEach(function (data) {
        var fieldName;
        var prefix;
        var keyRole;

        if (!isFieldCatalogueRow(data)) {
            return;
        }

        fieldName = stripMarkup(data.Field);
        prefix = getFieldPropertyPrefix(fieldName);
        keyRole = safeString(data["Key Role"]);
        fieldNames.push(fieldName);

        if (safeString(data.Required).toLowerCase() === "yes") {
            requiredFieldNames.push(fieldName);
        }
        if (keyRole === "PK") {
            primaryKeyFieldNames.push(fieldName);
        }
        if (keyRole === "FK") {
            foreignKeyFieldNames.push(fieldName);
        }

        target.prop(prefix, buildFieldDescriptor(data));
    });

    if (fieldNames.length) {
        target.prop("FieldCatalogueSourceTable", sourceTableId);
        target.prop("FieldCount", String(fieldNames.length));
        target.prop("FieldList", fieldNames.join("; "));
        target.prop("RequiredFieldList", requiredFieldNames.join("; "));
        target.prop("PrimaryKeyFieldList", primaryKeyFieldNames.join("; "));
        target.prop("ForeignKeyFieldList", foreignKeyFieldNames.join("; "));
    }
}

function copyFieldCatalogueProperties(source, target) {
    var fieldList = safeString(source.prop("FieldList")).split(/\s*;\s*/).filter(function (fieldName) {
        return !!fieldName;
    });

    [
        "FieldCatalogueSourceTable",
        "FieldCount",
        "FieldList",
        "RequiredFieldList",
        "PrimaryKeyFieldList",
        "ForeignKeyFieldList"
    ].forEach(function (propertyName) {
        target.prop(propertyName, source.prop(propertyName));
    });

    fieldList.forEach(function (fieldName) {
        var prefix = getFieldPropertyPrefix(fieldName);
        target.prop(prefix, source.prop(prefix));
    });
}

function applyCoreTypeSpecializationMetadata(coreTypeConcepts) {
    getCoreTypeSpecializations().forEach(function (entry) {
        var parent = coreTypeConcepts[entry.BaseType];
        var concept = coreTypeConcepts[entry.TypeName];

        if (!parent || !concept || !safeString(parent.prop("FieldList"))) {
            return;
        }

        copyFieldCatalogueProperties(parent, concept);

        concept.prop("DefaultValuesJson", JSON.stringify(entry.Defaults || {}));
    });
}

function getLayerFill(layerName) {
    var layer = trim(layerName);
    var prefix = layer.split(/\s+/)[0];
    return CONST.Style.LayerFillByPrefix[prefix] || CONST.Style.LayerFill;
}

function getCoreTypeFill(typeName, archimateType) {
    var type = safeString(typeName);
    var conceptType = safeString(archimateType);

    if (conceptType === "business-role" || type.indexOf("Authority") >= 0 || type === "Stakeholder") {
        return CONST.Style.ManagementFill;
    }
    if (conceptType === "business-event" || type.indexOf("Event") >= 0) {
        return CONST.Style.ColumnFill;
    }
    if (conceptType === "goal" || type.indexOf("Attribute") >= 0 || type.indexOf("Objective") >= 0) {
        return CONST.Style.ConceptualFill;
    }
    if (conceptType === "requirement" || conceptType === "constraint") {
        return CONST.Style.RepresentationFill;
    }
    if (conceptType === "course-of-action" || type.indexOf("Treatment") >= 0 || type.indexOf("Strategy") >= 0) {
        return CONST.Style.PhysicalFill;
    }
    if (conceptType === "assessment" || type.indexOf("Risk") >= 0 || type.indexOf("Assessment") >= 0 ||
        type.indexOf("Rating") >= 0 || type.indexOf("KRI") >= 0 || type.indexOf("Scorecard") >= 0) {
        return CONST.Style.CellFill;
    }
    if (conceptType === "capability") {
        return CONST.Style.ComponentFill;
    }
    if (conceptType === "outcome") {
        return CONST.Style.LogicalFill;
    }

    return CONST.Style.TypeFill;
}

function getConceptFill(concept, fallbackFill) {
    var kind = safeString(concept.prop("SabsaA1CatalogueKind"));
    var explicitFill = safeString(concept.prop("VisualFillColor"));

    if (explicitFill) {
        return explicitFill;
    }
    if (kind === "Layer") {
        return getLayerFill(concept.prop("Layer"));
    }
    if (kind === "CoreType") {
        return getCoreTypeFill(concept.prop("SabsaType"), concept.prop("RecommendedArchiMateType"));
    }
    if (kind === "Relationship") {
        return CONST.Style.RelationshipFill;
    }
    if (kind === "Viewpoint") {
        return CONST.Style.ViewpointFill;
    }

    return fallbackFill || CONST.Style.SupportFill;
}

function getColorRole(fillColor) {
    var roles = {
        "#ff9aff": "SABSA contextual architecture",
        "#ccccff": "SABSA conceptual architecture",
        "#ccffff": "SABSA logical architecture",
        "#ccff9a": "SABSA physical/treatment architecture",
        "#ffff9a": "SABSA component/workflow architecture",
        "#ffcc64": "SABSA management/relationship architecture",
        "#ff9a69": "SABSA column/event/validation marker",
        "#ffff64": "SABSA cell/risk-assessment marker",
        "#ffffcc": "SABSA representation/evidence marker",
        "#fff7cc": "source document",
        "#f3f3f3": "support/context"
    };
    return roles[safeString(fillColor)] || "SABSA A1 catalogue";
}

function truncate(value, maxLength) {
    var text = trim(value);
    if (text.length <= maxLength) {
        return text;
    }
    return text.substring(0, maxLength - 3) + "...";
}

function getRowPrimaryValue(data) {
    var keys = Object.keys(data || {});
    var i;

    for (i = 0; i < keys.length; i++) {
        if (trim(data[keys[i]])) {
            return stripMarkup(data[keys[i]]);
        }
    }

    return "Row";
}

function getRowFill(data) {
    var combined = stripMarkup(Object.keys(data || {}).map(function (key) {
        return data[key];
    }).join(" "));

    if (combined.indexOf("[PRIMARY]") >= 0) {
        return CONST.Style.PhysicalFill;
    }
    if (combined.indexOf("[SUPPORT]") >= 0) {
        return CONST.Style.LogicalFill;
    }
    if (combined.indexOf("[ASSUMPTION]") >= 0) {
        return CONST.Style.ManagementFill;
    }
    if (combined.indexOf("[CAUTION]") >= 0) {
        return CONST.Style.ColumnFill;
    }
    if (combined.indexOf("[TRACE]") >= 0) {
        return CONST.Style.ConceptualFill;
    }

    return CONST.Style.SupportFill;
}

function inferConceptTypeForSabsaType(typeName) {
    var type = safeString(typeName);

    if (type.indexOf("Authority") >= 0 || type === "Stakeholder") {
        return "business-role";
    }
    if (type === "Event" || type === "Implementation_Event") {
        return "business-event";
    }
    if (type.indexOf("Consequence") >= 0 || type === "Outcome") {
        return "outcome";
    }
    if (type.indexOf("Treatment") >= 0 || type.indexOf("Strategy") >= 0) {
        return "course-of-action";
    }
    if (type.indexOf("Objective") >= 0 || type === "Attribute" || type === "Business_Objective") {
        return "goal";
    }
    if (type.indexOf("Requirement") >= 0 || type.indexOf("Control_Objective") >= 0) {
        return "requirement";
    }
    if (type.indexOf("Criteria") >= 0 || type.indexOf("Rule") >= 0) {
        return "constraint";
    }
    if (type.indexOf("Risk") >= 0 || type.indexOf("Assessment") >= 0 || type.indexOf("Rating") >= 0 ||
        type.indexOf("Evaluation") >= 0 || type.indexOf("KRI") >= 0 || type.indexOf("Scorecard") >= 0 ||
        type.indexOf("Aggregation") >= 0 || type.indexOf("Evidence_Confidence") >= 0 ||
        type.indexOf("Finding") >= 0 || type.indexOf("Opinion") >= 0) {
        return "assessment";
    }
    if (type.indexOf("Capability") >= 0 || type.indexOf("Shared_Service") >= 0) {
        return "capability";
    }

    return "grouping";
}

function styleVisual(visual, fillColor) {
    visual.fillColor = fillColor;
    visual.lineColor = CONST.Style.LineColor;
    visual.fontColor = CONST.Style.FontColor;
    visual.opacity = 255;
    visual.outlineOpacity = 255;
    try {
        visual.labelExpression = "${name}";
        visual.textPosition = 1;
    } catch (error) {
        logger.debug("Could not apply label settings.", { error: String(error) }, "sabsa.a1.catalogue.visual.label.skipped");
    }
}

function addStyledVisual(container, concept, x, y, width, height, fillColor) {
    var visual = container.add(concept, x, y, width, height);
    styleVisual(visual, fillColor);
    try {
        visual.labelExpression = safeString(concept.prop(CONST.Property.DefaultLabelExpression)) || CONST.LabelExpression.Stereotype;
        visual.textPosition = 1;
    } catch (error) {
        logger.debug("Could not apply stereotype label expression.", { error: String(error) }, "sabsa.a1.catalogue.visual.stereotype.label.skipped");
    }
    return visual;
}

function styleLibraryShape(shape, fillColor) {
    shape.fillColor = fillColor;
    shape.lineColor = CONST.Style.LineColor;
    shape.fontColor = CONST.Style.FontColor;
    shape.opacity = 255;
    shape.outlineOpacity = 255;
}

function addLibraryNote(container, text, x, y, width, height, fillColor) {
    var note = container.createObject("note", x, y, width, height);
    note.text = text;
    styleLibraryShape(note, fillColor);
    return note;
}

function addLibraryGroup(view, name, x, y, width, height, fillColor) {
    var group = view.createObject("group", x, y, width, height);
    group.name = name;
    styleLibraryShape(group, fillColor);
    return group;
}

function calculateLibraryGroupHeight(itemCount) {
    var rows = Math.max(1, Math.ceil(itemCount / CONST.Layout.LibraryGroupColumns));
    return CONST.Layout.LibraryGroupInnerY +
        (rows * CONST.Layout.CardHeight) +
        ((rows - 1) * CONST.Layout.GapY) +
        CONST.Layout.LibraryGroupGapY;
}

function nextLibraryGroupY(currentY, groupHeight) {
    return currentY + groupHeight + CONST.Layout.LibraryGroupGapY;
}

function addLibraryConcept(group, concept, index, fillColor, labelExpression) {
    var row = Math.floor(index / CONST.Layout.LibraryGroupColumns);
    var col = index % CONST.Layout.LibraryGroupColumns;
    var x = CONST.Layout.LibraryGroupInnerX + (col * (CONST.Layout.CardWidth + CONST.Layout.GapX));
    var y = CONST.Layout.LibraryGroupInnerY + (row * (CONST.Layout.CardHeight + CONST.Layout.GapY));
    var visual = addStyledVisual(group, concept, x, y, CONST.Layout.CardWidth, CONST.Layout.CardHeight, fillColor);

    try {
        visual.labelExpression = labelExpression;
    } catch (error) {
        logger.debug("Could not apply library label expression.", { error: String(error) }, "sabsa.a1.overlay.library.label.skipped");
    }

    return visual;
}

function addConnection(view, relationship, sourceVisual, targetVisual) {
    var connection;

    if (!relationship || !sourceVisual || !targetVisual) {
        stats.viewConnectionsSkipped++;
        return null;
    }

    try {
        connection = view.add(relationship, sourceVisual, targetVisual);
    } catch (error) {
        logger.debug("Could not add relationship connection to view.", {
            relationship: safeString(relationship.name),
            error: String(error)
        }, "sabsa.a1.catalogue.connection.add.skipped");
        stats.viewConnectionsSkipped++;
        return null;
    }

    connection.lineColor = CONST.Style.LineColor;
    connection.fontColor = CONST.Style.FontColor;
    try {
        connection.labelExpression = CONST.LabelExpression.Stereotype;
    } catch (error) {
        logger.debug("Could not apply relationship label expression.", { error: String(error) }, "sabsa.a1.catalogue.connection.label.skipped");
    }
    stats.viewConnectionsCreated++;
    return connection;
}

function getConceptVisualKey(concept) {
    return safeString(concept && concept.prop("SabsaA1CatalogueKey")) || safeString(concept && concept.id);
}

function rememberVisual(visualsByConcept, concept, visual) {
    var key = getConceptVisualKey(concept);

    if (!concept || !visual) {
        return;
    }

    if (key) {
        visualsByConcept[key] = visual;
    }
    visualsByConcept[safeString(concept.name)] = visual;
    visualsByConcept[normalizeTypeName(concept.name)] = visual;
}

function getVisualForConcept(visualsByConcept, concept) {
    return visualsByConcept[getConceptVisualKey(concept)] ||
        visualsByConcept[safeString(concept && concept.name)] ||
        visualsByConcept[normalizeTypeName(safeString(concept && concept.name))] ||
        null;
}

function resolveVisualByTypeName(visualsByType, typeName) {
    var visual = visualsByType[typeName] || visualsByType[normalizeTypeName(typeName)];

    if (visual) {
        return visual;
    }

    Object.keys(visualsByType).forEach(function (key) {
        if (!visual && normalizeTypeName(key) === normalizeTypeName(typeName)) {
            visual = visualsByType[key];
        }
    });

    return visual || null;
}

function addVisibleRelationshipsByEndpoint(view, visualsByConcept, relationKinds) {
    var wanted = {};

    (relationKinds || []).forEach(function (kind) {
        wanted[kind] = true;
    });

    $("relationship").filter(function (relationship) {
        return !!wanted[safeString(relationship.prop("SabsaA1CatalogueRelationKind"))];
    }).each(function (relationship) {
        addConnection(
            view,
            relationship,
            getVisualForConcept(visualsByConcept, relationship.source),
            getVisualForConcept(visualsByConcept, relationship.target)
        );
    });
}

function gridPosition(index, columns, startX, startY, width, height) {
    return {
        x: startX + ((index % columns) * (width + CONST.Layout.GapX)),
        y: startY + (Math.floor(index / columns) * (height + CONST.Layout.GapY))
    };
}

function createSourceConcept(markdown) {
    var rows = extractTableAfterMarker(markdown, "Table 1-01 - Document Control");
    var props = {
        SabsaA1CatalogueKind: "Source",
        SourceSection: "Table 1-01",
        VisualFillColor: CONST.Style.SourceFill,
        VisualColorRole: getColorRole(CONST.Style.SourceFill)
    };

    rows.forEach(function (row) {
        var data = rowToObject(row);
        if (data.Field) {
            props["DocumentControl_" + slugify(data.Field)] = data.Value;
        }
    });

    return ensureConcept(
        "grouping",
        "Generic SABSA A1 Metamodel Field Catalogue",
        "catalogue:source:generic-sabsa-a1-metamodel-field-catalogue",
        props,
        buildDocumentation("Source markdown for the generic SABSA A1 metamodel field catalogue.", props)
    );
}

function createCompleteTableCatalogueConcepts(markdown, sourceConcept) {
    var blocks = parseMarkdownTableBlocks(markdown);
    var tableConcepts = [];
    var tablesById = {};
    var rowsByTableId = {};

    blocks.forEach(function (block) {
        var tableFill = CONST.Style.RepresentationFill;
        var tableKey = "catalogue:table:" + slugify(block.id);
        var tableConcept = ensureConcept("grouping", block.id + " - " + block.title, tableKey, {
            SabsaA1CatalogueKind: "Table",
            TableId: block.id,
            TableTitle: block.title,
            RowCount: String(block.rows.length),
            HeaderColumns: block.headers.join("; "),
            Caption: block.caption,
            SourceSection: "Table " + block.id,
            SourceLine: block.startLine,
            VisualFillColor: tableFill,
            VisualColorRole: getColorRole(tableFill)
        }, buildDocumentation("Markdown table extracted from the complete field catalogue.", {
            TableId: block.id,
            TableTitle: block.title,
            RowCount: String(block.rows.length),
            HeaderColumns: block.headers.join("; "),
            Caption: block.caption
        }));
        ensureRelationship("association-relationship", sourceConcept, tableConcept, "catalogue:source:table:" + slugify(block.id), "contains", {
            SabsaA1CatalogueRelationKind: "SourceTableTrace",
            SourceSection: "Table " + block.id
        });

        tableConcepts.push(tableConcept);
        tablesById[block.id] = tableConcept;
        rowsByTableId[block.id] = [];
        stats.genericTables++;

        block.rows.forEach(function (data, rowIndex) {
            var rowFill = getRowFill(data);
            var rowNumber = rowIndex + 1;
            var rowName = block.id + " row " + rowNumber + " - " + truncate(getRowPrimaryValue(data), 70);
            var rowConcept = ensureConcept("business-object", rowName, "catalogue:table-row:" + slugify(block.id) + ":" + rowNumber, {
                SabsaA1CatalogueKind: "TableRow",
                TableId: block.id,
                TableTitle: block.title,
                RowIndex: String(rowNumber),
                PrimaryValue: getRowPrimaryValue(data),
                SourceSection: "Table " + block.id,
                SourceLine: block.startLine,
                VisualFillColor: rowFill,
                VisualColorRole: getColorRole(rowFill)
            }, buildDocumentation("Markdown table row extracted from " + block.id + ".", data));

            applyTableProperties(rowConcept, data);
            if (isFieldCatalogueRow(data)) {
                rowConcept.prop("FieldName", stripMarkup(data.Field));
                rowConcept.prop("FieldDatatype", data.Datatype);
                rowConcept.prop("FieldRequired", data.Required);
                rowConcept.prop("FieldKeyRole", data["Key Role"]);
                rowConcept.prop("FieldTemplateFamily", data["Template Family"]);
                rowConcept.prop("FieldDescription", data.Note);
                rowConcept.prop("FieldDefinition", buildFieldDescriptor(data));
                stats.fieldDefinitions++;
            }
            ensureRelationship("composition-relationship", tableConcept, rowConcept, "catalogue:table:" + slugify(block.id) + ":row:" + rowNumber, "row", {
                SabsaA1CatalogueRelationKind: "TableRow",
                TableId: block.id,
                RowIndex: String(rowNumber),
                SourceSection: "Table " + block.id
            });
            rowsByTableId[block.id].push({
                concept: rowConcept,
                data: data,
                rowIndex: rowNumber
            });
            stats.genericRows++;
        });
    });

    return {
        tables: tableConcepts,
        tablesById: tablesById,
        rowsByTableId: rowsByTableId
    };
}

function createTableCatalogueReferenceData(markdown) {
    var blocks = parseMarkdownTableBlocks(markdown);
    var tableConcepts = [];
    var tablesById = {};
    var rowsByTableId = {};

    blocks.forEach(function (block) {
        var tableKey = "catalogue:table:" + slugify(block.id);
        var tableConcept = findConceptByKey("grouping", tableKey);

        if (tableConcept) {
            tableConcepts.push(tableConcept);
            tablesById[block.id] = tableConcept;
        }

        rowsByTableId[block.id] = [];
        stats.genericTables++;

        block.rows.forEach(function (data, rowIndex) {
            var rowNumber = rowIndex + 1;
            var rowConcept = findConceptByKey("business-object", "catalogue:table-row:" + slugify(block.id) + ":" + rowNumber);

            if (isFieldCatalogueRow(data)) {
                stats.fieldDefinitions++;
            }

            rowsByTableId[block.id].push({
                concept: rowConcept || null,
                data: data,
                rowIndex: rowNumber
            });
            stats.genericRows++;
        });
    });

    return {
        tables: tableConcepts,
        tablesById: tablesById,
        rowsByTableId: rowsByTableId
    };
}

function createLayerConcepts(markdown, sourceConcept) {
    var rows = extractTableAfterMarker(markdown, "Table 3-LA01 - SABSA Architecture Layer Alignment");
    var concepts = [];

    rows.forEach(function (row, index) {
        var data = rowToObject(row);
        var layer = data.Layer || ("Layer " + (index + 1));
        var fillColor = getLayerFill(layer);
        var concept = ensureConcept("grouping", layer + " - " + data.Purpose, "catalogue:layer:" + slugify(layer), {
            SabsaA1CatalogueKind: "Layer",
            Layer: layer,
            Purpose: data.Purpose,
            Content: data.Content,
            BoundaryRule: data["Boundary Rule"],
            VisualFillColor: fillColor,
            VisualColorRole: getColorRole(fillColor),
            SourceSection: "Table 3-LA01"
        }, buildDocumentation("SABSA architecture layer extracted from Table 3-LA01.", data));
        applyTableProperties(concept, data);

        ensureRelationship("association-relationship", sourceConcept, concept, "catalogue:source:layer:" + slugify(layer), "defines", {
            SabsaA1CatalogueRelationKind: "SourceTrace",
            SourceSection: "Table 3-LA01"
        });
        concepts.push(concept);
        stats.layers++;
    });

    return concepts;
}

function createCoreTypeConcepts(markdown, sourceConcept) {
    var rows = extractTableAfterMarker(markdown, "Table 6-01 - Core Type Inventory");
    var promotedRows = extractTableAfterMarker(markdown, "Table 6-02 - Core Type Promotion And Extension");
    var concepts = {};

    rows.forEach(function (row) {
        var data = rowToObject(row);
        var typeName = data.Type;
        var conceptType;
        var concept;

        if (!typeName || typeName === "Other support types") {
            return;
        }

        conceptType = inferConceptTypeForSabsaType(typeName);
        var fillColor = getCoreTypeFill(typeName, conceptType);
        concept = ensureConcept(conceptType, typeName, "catalogue:type:" + typeName, {
            SabsaA1CatalogueKind: "CoreType",
            SabsaType: typeName,
            Rows: data.Rows,
            MainUse: data["Main Use"],
            SourceSection: "Table 6-01",
            RecommendedArchiMateType: conceptType,
            VisualFillColor: fillColor,
            VisualColorRole: getColorRole(fillColor)
        }, buildDocumentation("Core type extracted from Table 6-01.", data));
        applyTableProperties(concept, data);

        ensureRelationship("association-relationship", sourceConcept, concept, "catalogue:source:type:" + typeName, "defines", {
            SabsaA1CatalogueRelationKind: "SourceTrace",
            SourceSection: "Table 6-01"
        });
        concepts[typeName] = concept;
        stats.coreTypes++;
    });

    promotedRows.forEach(function (row) {
        var data = rowToObject(row);
        var typeName = stripMarkup(data["Type / Pattern"]);
        var conceptType;
        var concept;

        if (!typeName || concepts[typeName]) {
            return;
        }

        conceptType = inferConceptTypeForSabsaType(typeName);
        var fillColor = getCoreTypeFill(typeName, conceptType);
        concept = ensureConcept(conceptType, typeName, "catalogue:type:" + typeName, {
            SabsaA1CatalogueKind: "CoreType",
            SabsaType: typeName,
            TypeName: typeName,
            PromotionStatus: stripMarkup(data["v1.6 Status"]),
            WhyItMatters: data["Why It Matters"],
            DownstreamImpact: data["Downstream Impact"],
            SourceSection: "Table 6-02",
            RecommendedArchiMateType: conceptType,
            VisualFillColor: fillColor,
            VisualColorRole: getColorRole(fillColor)
        }, buildDocumentation("Promoted or support type extracted from Table 6-02.", data));
        applyTableProperties(concept, data);

        ensureRelationship("association-relationship", sourceConcept, concept, "catalogue:source:type:" + typeName, "defines", {
            SabsaA1CatalogueRelationKind: "SourceTrace",
            SourceSection: "Table 6-02"
        });
        concepts[typeName] = concept;
        stats.coreTypes++;
    });

    createCoreTypeSpecializations(concepts, sourceConcept);

    return concepts;
}

function parseRelationshipExpression(expression) {
    var parts = safeString(expression).split("->").map(function (part) {
        return stripMarkup(part);
    });

    return {
        source: trim(parts[0] || ""),
        target: trim(parts[1] || ""),
        label: parts.length > 1 ? parts[0] + " -> " + parts[1] : expression
    };
}

function normalizeTypeName(value) {
    return stripMarkup(value).replace(/\s+/g, "_");
}

function getCoreTypeConcept(coreTypeConcepts, typeName) {
    var exact = stripMarkup(typeName);
    var normalized = normalizeTypeName(typeName);
    return coreTypeConcepts[exact] || coreTypeConcepts[normalized] || null;
}

function getCoreTypeConceptsForTitle(coreTypeConcepts, title) {
    var result = [];
    var seen = {};
    var parts = stripMarkup(title).split(/\s*\/\s*|\s+\band\b\s+/i);

    function add(typeName) {
        var concept = getCoreTypeConcept(coreTypeConcepts, typeName);
        var key;

        if (!concept) {
            return;
        }

        key = safeString(concept.prop("SabsaA1CatalogueKey"));
        if (!seen[key]) {
            result.push(concept);
            seen[key] = true;
        }
    }

    add(title);
    parts.forEach(add);
    return result;
}

function getCoreTypeSpecializations() {
    return [
        {
            TypeName: "Threat",
            BaseType: "Event_Attribute",
            Defaults: {
                direction: "Negative",
                classification: "Threat"
            },
            MainUse: "Event_Attribute specialization for negative SABSA risk classification."
        },
        {
            TypeName: "Opportunity",
            BaseType: "Event_Attribute",
            Defaults: {
                direction: "Positive",
                classification: "Opportunity"
            },
            MainUse: "Event_Attribute specialization for positive SABSA opportunity classification."
        },
        {
            TypeName: "Strength",
            BaseType: "State_Attribute",
            Defaults: {
                state_type: "Strength",
                state_effect: "Strength"
            },
            MainUse: "State_Attribute specialization for strengths that can exploit opportunities."
        },
        {
            TypeName: "Weakness",
            BaseType: "State_Attribute",
            Defaults: {
                state_type: "Weakness",
                state_effect: "Weakness"
            },
            MainUse: "State_Attribute specialization for weaknesses that can be exploited by threats."
        },
        {
            TypeName: "Impact",
            BaseType: "Consequence",
            Defaults: {
                direction: "Negative",
                consequence_type: "Impact"
            },
            MainUse: "Consequence specialization for negative impact on objectives or attribute performance."
        },
        {
            TypeName: "Benefit",
            BaseType: "Consequence",
            Defaults: {
                direction: "Positive",
                consequence_type: "Benefit"
            },
            MainUse: "Consequence specialization for positive benefit on objectives or attribute performance."
        },
        {
            TypeName: "Threat Risk",
            BaseType: "Risk",
            Defaults: {
                risk_direction: "Threat",
                risk_statement_template: "Threat"
            },
            MainUse: "Risk specialization for downside SABSA threat-risk chains."
        },
        {
            TypeName: "Opportunity Risk",
            BaseType: "Risk",
            Defaults: {
                risk_direction: "Opportunity",
                risk_statement_template: "Opportunity"
            },
            MainUse: "Risk specialization for upside SABSA opportunity-risk chains."
        },
        {
            TypeName: "Control",
            BaseType: "Risk_Treatment",
            Defaults: {
                treatment_type: "Control"
            },
            MainUse: "Risk_Treatment specialization for controls that reduce negative risk."
        },
        {
            TypeName: "Enabler",
            BaseType: "Risk_Treatment",
            Defaults: {
                treatment_type: "Enabler"
            },
            MainUse: "Risk_Treatment specialization for enablers that increase positive opportunity."
        },
        {
            TypeName: "Combined Treatment",
            BaseType: "Risk_Treatment",
            Defaults: {
                treatment_type: "Combined"
            },
            MainUse: "Risk_Treatment specialization for combined control and enablement treatments."
        }
    ];
}

function createCoreTypeSpecializations(coreTypeConcepts, sourceConcept) {
    getCoreTypeSpecializations().forEach(function (entry) {
        var parent = coreTypeConcepts[entry.BaseType];
        var typeName = entry.TypeName;
        var conceptType;
        var fillColor;
        var concept;

        if (!parent || coreTypeConcepts[typeName]) {
            return;
        }

        conceptType = safeString(parent.prop("RecommendedArchiMateType")) || parent.type || "grouping";
        fillColor = getConceptFill(parent, CONST.Style.TypeFill);
        concept = ensureConcept(conceptType, typeName, "catalogue:type:" + typeName, {
            SabsaA1CatalogueKind: "CoreType",
            SabsaType: typeName,
            TypeName: typeName,
            ParentType: entry.BaseType,
            SpecializesType: entry.BaseType,
            DefaultValuesJson: JSON.stringify(entry.Defaults || {}),
            MainUse: entry.MainUse,
            SourceSection: "Derived SABSA A1 overlay specialization",
            RecommendedArchiMateType: conceptType,
            VisualFillColor: fillColor,
            VisualColorRole: getColorRole(fillColor)
        }, buildDocumentation("Derived SABSA A1 overlay specialization of " + entry.BaseType + ".", entry));

        ensureRelationship("association-relationship", sourceConcept, concept, "catalogue:source:type:" + typeName, "defines derived type", {
            SabsaA1CatalogueRelationKind: "SourceTrace",
            SourceSection: "Derived SABSA A1 overlay specialization"
        });
        ensureRelationship("specialization-relationship", concept, parent, "catalogue:type-specialization:" + typeName + ":" + entry.BaseType, "specializes " + displayName(entry.BaseType), {
            SabsaA1CatalogueRelationKind: "CoreTypeSpecialization",
            RelationshipLabel: "specializes " + displayName(entry.BaseType),
            SourceType: typeName,
            TargetType: entry.BaseType,
            DefaultValuesJson: JSON.stringify(entry.Defaults || {}),
            SourceSection: "Derived SABSA A1 overlay specialization"
        });

        coreTypeConcepts[typeName] = concept;
        stats.coreTypes++;
    });
}

function splitCamelCase(value) {
    return safeString(value).replace(/([a-z0-9])([A-Z])/g, "$1_$2");
}

function addUniqueConcept(result, seen, concept) {
    var key;

    if (!concept) {
        return;
    }

    key = safeString(concept.prop("SabsaA1CatalogueKey"));
    if (!seen[key]) {
        result.push(concept);
        seen[key] = true;
    }
}

