    },
    Kind: {
        Source: "SourceDocument",
        MetaType: "SabsaA1OverlayMetaType",
        MetaRelationship: "SabsaA1OverlayMetaRelationship",
        Sample: "SabsaA1OverlaySample",
        SampleRelationship: "SabsaA1OverlaySampleRelationship",
