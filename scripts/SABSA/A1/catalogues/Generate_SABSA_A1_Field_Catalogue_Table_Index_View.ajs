/*
===============================================================================
Generate SABSA A1 Field Catalogue Table Index View
===============================================================================

Runs the shared Generic SABSA A1 Metamodel Field Catalogue generator in table
index mode. This creates or reuses source, table and table-row catalogue
elements and generates only the table index view.
===============================================================================
*/

var File = Java.type("java.io.File");

var SABSA_A1_FIELD_CATALOGUE_MODE = "tables";
var SABSA_A1_FIELD_CATALOGUE_SCRIPT_NAME = "Generate_SABSA_A1_Field_Catalogue_Table_Index_View";
var SABSA_A1_FIELD_CATALOGUE_DIALOG_TITLE = "SABSA A1 Field Catalogue - Table Index View";

load(new File(__DIR__ + "../core/Run_SABSA_A1_Field_Catalogue_Mode.ajs").getCanonicalPath());
