/*
===============================================================================
Generate SABSA A1 Metamodel Field Catalogue Meta Views
===============================================================================

Compatibility entry point for the shared Generic SABSA A1 Metamodel Field
Catalogue generator. Prefer Generate_SABSA_A1_Metamodel_Architecture_Views.ajs.
This mode generates only the metamodel architecture views.

Archived because the focused replacement entry point has a clearer name.
===============================================================================
*/

var File = Java.type("java.io.File");

var SABSA_A1_FIELD_CATALOGUE_MODE = "metamodel";
var SABSA_A1_FIELD_CATALOGUE_SCRIPT_NAME = "Generate_SABSA_A1_Metamodel_Field_Catalogue_Meta_Views";
var SABSA_A1_FIELD_CATALOGUE_DIALOG_TITLE = "SABSA A1 Metamodel - Architecture Views";

load(new File(__DIR__ + "../core/Run_SABSA_A1_Field_Catalogue_Mode.ajs").getCanonicalPath());
