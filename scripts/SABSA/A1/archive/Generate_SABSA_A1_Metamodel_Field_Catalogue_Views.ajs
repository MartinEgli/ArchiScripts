/*
===============================================================================
Generate SABSA A1 Metamodel Field Catalogue Views
===============================================================================

Archived compatibility entry point for the old combined field-catalogue
generator. Prefer the focused scripts in the parent A1 folder.
===============================================================================
*/

var File = Java.type("java.io.File");

var SABSA_A1_FIELD_CATALOGUE_MODE = "combined";
var SABSA_A1_FIELD_CATALOGUE_SCRIPT_NAME = "Generate_SABSA_A1_Metamodel_Field_Catalogue_Views";
var SABSA_A1_FIELD_CATALOGUE_DIALOG_TITLE = "SABSA A1 Metamodel Field Catalogue - Combined";

load(new File(__DIR__ + "../core/Run_SABSA_A1_Field_Catalogue_Mode.ajs").getCanonicalPath());
