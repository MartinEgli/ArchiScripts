/*
===============================================================================
Generate SABSA A1 Metamodel Architecture Views
===============================================================================

Runs the shared Generic SABSA A1 Metamodel Field Catalogue generator in
metamodel view mode. This creates or reuses the metamodel catalogue elements and
generates only the metamodel architecture views: layer alignment, core type
inventory, FK relations, relationship catalogue and viewpoint catalogue.
===============================================================================
*/

var File = Java.type("java.io.File");

var SABSA_A1_FIELD_CATALOGUE_MODE = "metamodel";
var SABSA_A1_FIELD_CATALOGUE_SCRIPT_NAME = "Generate_SABSA_A1_Metamodel_Architecture_Views";
var SABSA_A1_FIELD_CATALOGUE_DIALOG_TITLE = "SABSA A1 Metamodel - Architecture Views";

load(new File(__DIR__ + "core/Generate_SABSA_A1_Field_Catalogue_Core.ajs").getCanonicalPath());
