/*
===============================================================================
Cleanup SABSA A1 Field Metadata From Explicit Elements
===============================================================================

Removes verbose Field_* metadata properties and concrete ID-style reference
field values from SABSA A1 explicit/generated elements.

Rule:
- Compact Field_<field> metadata belongs only to SABSA A1 CoreType metamodel elements.
- Redundant Field_<field>_Datatype / _Description style metadata is removed from CoreType elements.
- Explicit/template/applied elements keep concrete field values except ID-style reference fields; FK semantics remain represented by relationships.
===============================================================================
*/

console.show();
console.clear();

var CONST = {
    Namespace: "SabsaA1Overlay",
    Property: {
        Namespace: "Namespace",
        Kind: "Kind",
        MetaElementKey: "MetaElementKey"
    },
    Dialog: {
        Title: "SABSA A1 Field Metadata Cleanup",
        ErrorTitle: "SABSA A1 Field Metadata Cleanup - Error"
    }
};

var stats = {
    conceptsScanned: 0,
    conceptsCleaned: 0,
    relationshipsScanned: 0,
    relationshipsCleaned: 0,
    propertiesRemoved: 0,
    metaConceptsCleaned: 0,
    referenceIdFieldValuesRemoved: 0
};

function safeString(value) {
    return value === null || typeof value === "undefined" ? "" : String(value);
}

function isFieldMetadataProperty(propertyName) {
    return /^Field_/.test(safeString(propertyName)) || /^FieldDefault_/.test(safeString(propertyName));
}

function isRedundantFieldMetadataProperty(propertyName) {
    return /^Field_.*_(Name|Datatype|Required|KeyRole|TemplateFamily|Description|SourceTable|DefaultValue)$/.test(safeString(propertyName)) ||
        /^FieldDefault_/.test(safeString(propertyName));
}

function propertyKey(value) {
    return safeString(value)
        .replace(/<[^>]+>/g, "")
        .replace(/`/g, "")
        .replace(/\*\*/g, "")
        .toLowerCase()
        .replace(/&/g, "and")
        .replace(/[^a-z0-9]+/g, "_")
        .replace(/^_+|_+$/g, "");
}

function getFieldPropertyPrefix(fieldName) {
    return "Field_" + propertyKey(fieldName);
}

function parseDescriptorValue(descriptor, key) {
    var wanted = safeString(key).toLowerCase();
    var value = "";

    safeString(descriptor).split(/\s*;\s*/).forEach(function (part) {
        var index = part.indexOf("=");
        var partKey;

        if (index < 0 || value) {
            return;
        }

        partKey = part.substring(0, index).toLowerCase();
        if (partKey === wanted) {
            value = part.substring(index + 1);
        }
    });

    return value;
}

function getFieldKeyRole(metaElement, fieldName) {
    return parseDescriptorValue(metaElement.prop(getFieldPropertyPrefix(fieldName)), "keyRole");
}

function isReferenceIdField(metaElement, fieldName) {
    var keyRole = getFieldKeyRole(metaElement, fieldName);

    return keyRole !== "PK" && /(^|_)ids?$/.test(propertyKey(fieldName));
}

function isSabsaA1Object(object) {
    return safeString(object.prop("SabsaA1CatalogueKind")) !== "" ||
        safeString(object.prop("SabsaA1CatalogueRelationKind")) !== "" ||
        safeString(object.prop(CONST.Property.Namespace)) === CONST.Namespace ||
        safeString(object.prop(CONST.Property.MetaElementKey)) !== "";
}

function canOwnFieldMetadata(object) {
    return safeString(object.prop("SabsaA1CatalogueKind")) === "CoreType";
}

function removeFieldMetadataProperties(object) {
    var removed = 0;

    object.prop().forEach(function (propertyName) {
        if (isFieldMetadataProperty(propertyName)) {
            object.removeProp(propertyName);
            removed++;
        }
    });

    return removed;
}

function removeRedundantFieldMetadataProperties(object) {
    var removed = 0;

    object.prop().forEach(function (propertyName) {
        if (isRedundantFieldMetadataProperty(propertyName)) {
            object.removeProp(propertyName);
            removed++;
        }
    });

    return removed;
}

function findMetaElement(object) {
    var metaKey = safeString(object.prop(CONST.Property.MetaElementKey));

    if (!metaKey) {
        return null;
    }

    return $("element").filter(function (candidate) {
        return safeString(candidate.prop("SabsaA1CatalogueKey")) === metaKey;
    }).first();
}

function removeReferenceIdFieldValues(object) {
    var metaElement = findMetaElement(object);
    var removed = 0;
    var fieldList;

    if (!metaElement) {
        return removed;
    }

    fieldList = safeString(metaElement.prop("FieldList")).split(/\s*;\s*/).filter(function (fieldName) {
        return !!fieldName;
    });

    fieldList.forEach(function (fieldName) {
        if (isReferenceIdField(metaElement, fieldName) && safeString(object.prop(fieldName))) {
            object.removeProp(fieldName);
            removed++;
        }
    });

    return removed;
}

function showMessage(title, message, level) {
    try {
        var JOptionPane = Java.type("javax.swing.JOptionPane");
        var iconType = JOptionPane.INFORMATION_MESSAGE;

        if (level === "ERROR") {
            iconType = JOptionPane.ERROR_MESSAGE;
        } else if (level === "WARNING") {
            iconType = JOptionPane.WARNING_MESSAGE;
        }

        JOptionPane.showMessageDialog(null, message, title, iconType);
    } catch (error) {
        console.log("[" + title + "] " + message);
    }
}

function confirmExecution() {
    try {
        return window.confirm(
            "Remove Field_* metadata properties from SABSA A1 explicit/generated elements?\n\n" +
            "CoreType metamodel elements keep compact Field_<field> descriptors.\n" +
            "Verbose Field_* metadata and ID-style reference field values are removed."
        );
    } catch (error) {
        return true;
    }
}

function cleanConcepts() {
    $("element").each(function (concept) {
        var removed;
        var referenceRemoved;

        if (!isSabsaA1Object(concept)) {
            return;
        }

        stats.conceptsScanned++;
        if (canOwnFieldMetadata(concept)) {
            removed = removeRedundantFieldMetadataProperties(concept);
            if (removed > 0) {
                stats.metaConceptsCleaned++;
                stats.propertiesRemoved += removed;
                console.log("[CLEANED] " + concept.name + " removed redundant Field_* metadata: " + removed);
            }
            return;
        }

        removed = removeFieldMetadataProperties(concept);
        referenceRemoved = removeReferenceIdFieldValues(concept);
        if (removed + referenceRemoved > 0) {
            stats.conceptsCleaned++;
            stats.propertiesRemoved += removed + referenceRemoved;
            stats.referenceIdFieldValuesRemoved += referenceRemoved;
            console.log("[CLEANED] " + concept.name + " removed Field_* properties: " + removed + ", ID-style reference fields: " + referenceRemoved);
        }
    });
}

function cleanRelationships() {
    $("relationship").each(function (relationship) {
        var removed;

        if (!isSabsaA1Object(relationship)) {
            return;
        }

        stats.relationshipsScanned++;
        removed = removeFieldMetadataProperties(relationship);
        if (removed > 0) {
            stats.relationshipsCleaned++;
            stats.propertiesRemoved += removed;
            console.log("[CLEANED] " + relationship.name + " removed Field_* properties: " + removed);
        }
    });
}

function main() {
    if (!model) {
        throw new Error("No active model is open.");
    }

    if (!confirmExecution()) {
        console.log("[INFO] Cleanup cancelled by user.");
        return;
    }

    cleanConcepts();
    cleanRelationships();

    showMessage(
        CONST.Dialog.Title,
        "Field_* metadata cleanup finished." +
        "\nConcepts scanned: " + stats.conceptsScanned +
        "\nConcepts cleaned: " + stats.conceptsCleaned +
        "\nRelationships scanned: " + stats.relationshipsScanned +
        "\nRelationships cleaned: " + stats.relationshipsCleaned +
        "\nMeta CoreType concepts cleaned: " + stats.metaConceptsCleaned +
        "\nID-style reference field values removed: " + stats.referenceIdFieldValuesRemoved +
        "\nProperties removed total: " + stats.propertiesRemoved,
        "INFO"
    );
}

try {
    main();
} catch (error) {
    showMessage(CONST.Dialog.ErrorTitle, String(error), "ERROR");
    throw error;
}
