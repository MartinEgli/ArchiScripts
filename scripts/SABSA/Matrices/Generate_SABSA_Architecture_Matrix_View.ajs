var File = Java.type("java.io.File");
var Files = Java.type("java.nio.file.Files");
var Paths = Java.type("java.nio.file.Paths");
var StandardCharsets = Java.type("java.nio.charset.StandardCharsets");
var BufferedImage = Java.type("java.awt.image.BufferedImage");
var Font = Java.type("java.awt.Font");

load(new File(__DIR__ + "../../lib/logging/Logger.js").getCanonicalPath());
load(new File(__DIR__ + "../../lib/ui/DialogHelpers.js").getCanonicalPath());
load(new File(__DIR__ + "../lib/overview/SABSA_Overview_Registry.js").getCanonicalPath());

var SCRIPT_NAME = "Generate_SABSA_Architecture_Matrix_View";
var LOG_LEVEL = "WARN";
var logger = ArchiLogging.createLogger(SCRIPT_NAME, {
    clearConsole: true,
    minimumLevel: LOG_LEVEL
});
var dialogs = ArchiDialogs.createDialogService(logger, {
    title: "SABSA Architecture Matrix View"
});

var CONST = {
    SourceJsonPath: new File(__DIR__ + "../../../data/sabsa/sabsa-architecture-matrix-data.json").getCanonicalPath(),
    ViewName: "SABSA Architecture Matrix",
    Folder: {
        Root: "SABSA",
        Matrices: "Matrices",
        MatrixName: "Architecture Matrix",
        Columns: "Columns",
        Rows: "Rows",
        Scopes: "Scopes",
        WorkPackages: "Work Packages",
        Representations: "Representations",
        Relations: {
            RowToWorkPackages: "Row to Work Packages",
            ColumnToWorkPackages: "Column to Work Packages",
            CellToRepresentations: "Cell to Representations",
            ScopeToRows: "Scope to Rows"
        }
    },
    Layout: {
        StartX: 54,
        StartY: 42,
        ScopeWidth: 132,
        ScopeGap: 12,
        ColumnY: 42,
        ColumnHeight: 42,
        ColumnWidth: 212,
        ColumnGap: 12,
        RowStartY: 90,
        RowGap: 12,
        RowHeaderWidth: 0,
        RowHeaderGap: 10,
        RowHeaderReserve: 22,
        CellHeaderMinReserve: 28,
        CellHeaderGap: 8,
        RowInsetX: 2,
        RowRightInset: 12,
        RowInsetY: 6,
        RowBottomPadding: 8,
        CellWidth: 212,
        CellMinHeight: 90,
        CellInnerX: 8,
        CellInnerY: 4,
        CellInnerRight: 8,
        CellInnerBottom: 8,
        RepresentationMinHeight: 26,
        RepresentationGap: 6,
        RepresentationBottomReserve: 4
    },
    Style: {
        ColumnFill: "#ff9a69",
        CellFill: "#ffff64",
        RepresentationFill: "#ffffcc",
        ScopeStrategyFill: "#16464d",
        ScopeDesignFill: "#006033",
        ScopeFontColor: "#ffffff",
        RowFillById: {
            "contextual-architecture": "#ff9aff",
            "conceptual-architecture": "#ccccff",
            "logical-architecture": "#ccffff",
            "physical-architecture": "#ccff9a",
            "component-architecture": "#ffff9a",
            "management-architecture": "#ffcc64"
        },
        LineColor: "#111111",
        FontColor: "#111111"
    }
};

var stats = {
    rows: 0,
    columns: 0,
    cells: 0,
    representations: 0,
    relationships: 0,
    conceptsCreated: 0,
    conceptsReused: 0,
    relationshipsCreated: 0,
    relationshipsReused: 0
};

var measurementGraphics = (function () {
    var image = new BufferedImage(1, 1, BufferedImage.TYPE_INT_ARGB);
    return image.createGraphics();
})();

var measurementFont = new Font("SansSerif", Font.PLAIN, 11);
measurementGraphics.setFont(measurementFont);

function safeString(value) {
    return value === null || typeof value === "undefined" ? "" : String(value);
}

function trim(value) {
    return safeString(value).replace(/^\s+|\s+$/g, "");
}

function slugify(value) {
    return trim(value)
        .toLowerCase()
        .replace(/&/g, "and")
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/^-+|-+$/g, "");
}

function decodeEntities(value) {
    return safeString(value)
        .replace(/&amp;/g, "&")
        .replace(/&lt;/g, "<")
        .replace(/&gt;/g, ">")
        .replace(/&nbsp;/g, " ");
}

function normalizeFolderName(folderName) {
    return safeString(folderName)
        .toLowerCase()
        .replace(/&/g, "and")
        .replace(/[^a-z0-9]+/g, " ")
        .replace(/\s+/g, " ")
        .trim();
}

function getTopLevelFolder(rootName) {
    var aliasesByFolderName = {
        "Business": ["Business"],
        "Other": ["Other", "Connectors"],
        "Views": ["Views"],
        "Relations": ["Relations", "Relations/Connectors", "Connectors"],
        "Implementation & Migration": ["Implementation & Migration", "Implementation and Migration"]
    };
    var candidateNames = aliasesByFolderName[rootName] || [rootName];
    var wantedNames = candidateNames.map(normalizeFolderName);
    var foundFolder = null;

    $(model).children("folder").each(function (folder) {
        if (foundFolder) {
            return;
        }

        if (wantedNames.indexOf(normalizeFolderName(folder.name)) >= 0) {
            foundFolder = folder;
        }
    });

    return foundFolder;
}

function ensureChildFolder(parentFolder, childName) {
    var childFolder = $(parentFolder).children("folder").filter(function (folder) {
        return safeString(folder.name) === safeString(childName);
    }).first();

    if (childFolder) {
        return childFolder;
    }

    return parentFolder.createFolder(childName);
}

function ensureFolderPath(rootName, pathSegments) {
    var currentFolder = getTopLevelFolder(rootName);

    if (!currentFolder) {
        throw new Error("Top-level folder not found: " + rootName);
    }

    (pathSegments || []).forEach(function (segment) {
        currentFolder = ensureChildFolder(currentFolder, segment);
    });

    return currentFolder;
}

function moveObjectToFolder(rootName, pathSegments, objectToMove) {
    var targetFolder;

    if (!objectToMove) {
        return null;
    }

    targetFolder = ensureFolderPath(rootName, pathSegments);
    targetFolder.add(objectToMove);
    return targetFolder;
}

function getMatrixFolderSegments(extraSegments) {
    var segments = [CONST.Folder.Root, CONST.Folder.Matrices, CONST.Folder.MatrixName];

    (extraSegments || []).forEach(function (segment) {
        segments.push(segment);
    });

    return segments;
}

function resolveConceptFolderPlacement(conceptType, properties) {
    var kind = safeString(properties && properties.SabsaMatrixKind);

    if (conceptType === "representation") {
        return {
            rootName: "Business",
            pathSegments: getMatrixFolderSegments([CONST.Folder.Representations])
        };
    }

    if (conceptType === "work-package") {
        return {
            rootName: "Implementation & Migration",
            pathSegments: getMatrixFolderSegments([CONST.Folder.WorkPackages])
        };
    }

    if (conceptType === "grouping") {
        if (kind === "Column") {
            return {
                rootName: "Other",
                pathSegments: getMatrixFolderSegments([CONST.Folder.Columns])
            };
        }

        if (kind === "Row") {
            return {
                rootName: "Other",
                pathSegments: getMatrixFolderSegments([CONST.Folder.Rows])
            };
        }

        if (kind === "Scope") {
            return {
                rootName: "Other",
                pathSegments: getMatrixFolderSegments([CONST.Folder.Scopes])
            };
        }

    }

    return null;
}

function moveConceptToSabsaFolder(concept, conceptType, properties) {
    var placement = resolveConceptFolderPlacement(conceptType, properties);

    if (!placement) {
        return null;
    }

    return moveObjectToFolder(placement.rootName, placement.pathSegments, concept);
}

function moveViewToSabsaFolder(viewObject) {
    return moveObjectToFolder("Views", getMatrixFolderSegments(), viewObject);
}

function getRelationFolderSegments(extraSegments) {
    return getMatrixFolderSegments(extraSegments);
}

function resolveRelationshipFolderPlacement(properties) {
    var kind = safeString(properties && properties.SabsaMatrixKind);

    if (kind === "RowToWorkPackage") {
        return {
            rootName: "Relations",
            pathSegments: getRelationFolderSegments([CONST.Folder.Relations.RowToWorkPackages])
        };
    }

    if (kind === "ColumnToWorkPackage") {
        return {
            rootName: "Relations",
            pathSegments: getRelationFolderSegments([CONST.Folder.Relations.ColumnToWorkPackages])
        };
    }

    if (kind === "CellToRepresentation") {
        return {
            rootName: "Relations",
            pathSegments: getRelationFolderSegments([CONST.Folder.Relations.CellToRepresentations])
        };
    }

    if (kind === "ScopeToRow") {
        return {
            rootName: "Relations",
            pathSegments: getRelationFolderSegments([CONST.Folder.Relations.ScopeToRows])
        };
    }

    return null;
}

function moveRelationshipToSabsaFolder(relationship, properties) {
    var placement = resolveRelationshipFolderPlacement(properties);

    if (!placement) {
        return null;
    }

    return moveObjectToFolder(placement.rootName, placement.pathSegments, relationship);
}

function readUtf8Text(absolutePath) {
    return String(new java.lang.String(
        Files.readAllBytes(Paths.get(absolutePath)),
        StandardCharsets.UTF_8
    ));
}

function parseMatrixFromJson(jsonText) {
    var data = JSON.parse(jsonText);
    var generationNamespace = safeString(
        (data.source && data.source.generation_namespace) ||
        data.generation_namespace
    );
    logger.info("Parsed SABSA matrix JSON source.", {
        columns: (data.columns || []).length,
        rows: (data.rows || []).length,
        generation_namespace: generationNamespace
    }, "sabsa.matrix.source.parsed");

    return {
        generationNamespace: generationNamespace,
        columns: (data.columns || []).map(function (column) {
            return {
                id: safeString(column.id),
                title: safeString(column.english_title || column.title),
                conceptKey: safeString(column.concept_id || column.conceptKey || column.archimate_key || column.concept_key || ("column:" + safeString(column.id)))
            };
        }),
        rows: (data.rows || []).map(function (row) {
            return {
                id: safeString(row.id || slugify(row.english_title || row.title)),
                title: safeString(row.english_title || row.title),
                conceptKey: safeString(row.concept_id || row.conceptKey || row.archimate_key || row.concept_key || ("row:" + safeString(row.id || slugify(row.english_title || row.title)))),
                cells: (row.cells || []).map(function (cell) {
                    var cellKey = safeString(cell.key || slugify((row.english_title || row.title) + "-" + (cell.english_title || cell.title)));
                    var cellId = safeString(cell.id || cellKey);
                    return {
                        key: cellKey,
                        id: cellId,
                        columnId: safeString(cell.column_id || cell.columnId),
                        columnTitle: "",
                        title: safeString(cell.english_title || cell.title),
                        conceptKey: safeString(
                            cell.concept_id ||
                            cell.conceptKey ||
                            cell.archimate_key ||
                            cell.concept_key ||
                            ("cell:" + cellId)
                        ),
                        items: (cell.items || []).map(function (item) {
                            if (typeof item === "string") {
                                return {
                                    id: "",
                                    text: safeString(item)
                                };
                            }

                            return {
                                id: safeString(item.id || item.archimate_key || item.concept_key),
                                text: safeString(item.english_text || item.text || item.name)
                            };
                        })
                    };
                })
            };
        })
    };
}

function buildUniqueViewName(baseName) {
    var candidate = baseName;
    var suffix = 2;

    while ($("view").filter(function (viewObject) {
        return safeString(viewObject.name) === candidate;
    }).first()) {
        candidate = baseName + " (" + suffix + ")";
        suffix++;
    }

    return candidate;
}

function findConceptByTypeAndKey(conceptType, key) {
    return $(conceptType).filter(function (concept) {
        return safeString(concept.prop("SabsaMatrixKey")) === safeString(key);
    }).first();
}

function findConceptByTypeAndPropertyId(conceptType, propertyId) {
    var normalizedId = safeString(propertyId);

    if (!normalizedId) {
        return null;
    }

    return $(conceptType).filter(function (concept) {
        return safeString(concept.prop("id")) === normalizedId;
    }).first();
}

function findConceptByTypeAndAnyPropertyId(conceptType, propertyIds) {
    var ids = (propertyIds || []).map(function (propertyId) {
        return safeString(propertyId);
    }).filter(function (propertyId, index, allIds) {
        return !!propertyId && allIds.indexOf(propertyId) === index;
    });
    var concept;

    if (!ids.length) {
        return null;
    }

    for (var index = 0; index < ids.length; index++) {
        concept = findConceptByTypeAndPropertyId(conceptType, ids[index]);

        if (concept) {
            return concept;
        }
    }

    return null;
}

function ensureConcept(conceptType, name, key, properties, documentation, fallbackFinder) {
    var conceptId = safeString(properties && properties.id);
    var legacyPropertyId = safeString(key);
    var extraLegacyPropertyIds = properties && properties.__legacyPropertyIds;
    var concept = findConceptByTypeAndKey(conceptType, key);
    var reuseReason = "key";
    var placement = resolveConceptFolderPlacement(conceptType, properties);
    var conceptCreated = false;

    if (!concept && conceptId) {
        concept = findConceptByTypeAndPropertyId(conceptType, conceptId);
        reuseReason = concept ? "property-id" : reuseReason;
    }

    if (!concept && legacyPropertyId && legacyPropertyId !== conceptId) {
        concept = findConceptByTypeAndPropertyId(conceptType, legacyPropertyId);
        reuseReason = concept ? "legacy-property-id" : reuseReason;
    }

    if (!concept && extraLegacyPropertyIds && extraLegacyPropertyIds.length) {
        concept = findConceptByTypeAndAnyPropertyId(conceptType, extraLegacyPropertyIds);
        reuseReason = concept ? "legacy-property-id-list" : reuseReason;
    }

    if (!concept && typeof fallbackFinder === "function") {
        concept = fallbackFinder();
        reuseReason = concept ? "fallback" : reuseReason;
    }

    if (!concept) {
        if (placement) {
            concept = model.createElement(conceptType, name, ensureFolderPath(placement.rootName, placement.pathSegments));
        } else {
            concept = model.createElement(conceptType, name);
        }
        conceptCreated = true;
        stats.conceptsCreated++;
        logger.debug("Created concept.", {
            concept_type: conceptType,
            key: key,
            name: name
        }, "sabsa.matrix.concept.created");
    } else {
        stats.conceptsReused++;
        logger.debug("Reused concept.", {
            concept_type: conceptType,
            key: key,
            name: safeString(concept.name),
            reason: reuseReason
        }, "sabsa.matrix.concept.reused");
    }

    concept.name = name;
    concept.documentation = documentation || "";
    concept.prop("SabsaMatrixKey", key);
    if (conceptId || legacyPropertyId) {
        concept.prop("id", conceptId || legacyPropertyId);
    }

    Object.keys(properties || {}).forEach(function (propertyName) {
        if (propertyName === "__legacyPropertyIds") {
            return;
        }
        concept.prop(propertyName, safeString(properties[propertyName]));
    });

    if (conceptCreated) {
        moveConceptToSabsaFolder(concept, conceptType, properties);
    }

    return concept;
}

function findRepresentationConcept(rowData, cellData, itemData, index) {
    var itemOrder = String(index + 1);
    var itemId = safeString(itemData && itemData.id);
    var itemText = safeString(itemData && itemData.text);

    if (itemId) {
        return $("representation").filter(function (concept) {
            return safeString(concept.prop("ItemId")) === itemId;
        }).first();
    }

    return $("representation").filter(function (concept) {
        var sameKeyData =
            safeString(concept.prop("SabsaMatrixKind")) === "Representation" &&
            safeString(concept.prop("RowId")) === safeString(rowData.id) &&
            safeString(concept.prop("ColumnId")) === safeString(cellData.columnId) &&
            safeString(concept.prop("CellTitle")) === safeString(cellData.title) &&
            safeString(concept.prop("ItemOrder")) === itemOrder;

        if (sameKeyData) {
            return true;
        }

        return safeString(concept.name) === safeString(itemText) &&
            safeString(concept.prop("RowId")) === safeString(rowData.id) &&
            safeString(concept.prop("ColumnId")) === safeString(cellData.columnId);
    }).first();
}

function ensureRelationship(preferredType, source, target, key, properties) {
    var relationship = $("relationship").filter(function (candidate) {
        return safeString(candidate.prop("SabsaMatrixKey")) === safeString(key);
    }).first();
    var relationshipCreated = false;

    if (!relationship) {
        try {
            relationship = model.createRelationship(preferredType, "", source, target);
            relationshipCreated = true;
            stats.relationshipsCreated++;
            logger.debug("Created relationship.", {
                relationship_type: preferredType,
                key: key,
                source_name: safeString(source && source.name),
                target_name: safeString(target && target.name)
            }, "sabsa.matrix.relationship.created");
        } catch (error) {
            relationship = model.createRelationship("association-relationship", "", source, target);
            relationshipCreated = true;
            stats.relationshipsCreated++;
            logger.debug("Preferred relationship type is not valid. Falling back.", {
                preferred_type: preferredType,
                fallback_type: "association-relationship",
                key: key,
                error: String(error)
            }, "sabsa.matrix.relationship.fallback");
        }
    } else {
        stats.relationshipsReused++;
        logger.debug("Reused relationship.", {
            key: key,
            source_name: safeString(source && source.name),
            target_name: safeString(target && target.name)
        }, "sabsa.matrix.relationship.reused");
    }

    relationship.name = "";
    relationship.prop("SabsaMatrixKey", key);

    Object.keys(properties || {}).forEach(function (propertyName) {
        relationship.prop(propertyName, safeString(properties[propertyName]));
    });

    if (relationshipCreated) {
        moveRelationshipToSabsaFolder(relationship, properties);
    }

    return relationship;
}

function styleVisual(visual, fillColor) {
    visual.fillColor = fillColor;
    visual.lineColor = CONST.Style.LineColor;
    visual.fontColor = CONST.Style.FontColor;
    visual.opacity = 255;
    visual.outlineOpacity = 255;
}

function tryApplyLabelExpression(visual, expression) {
    try {
        visual.labelExpression = expression;
    } catch (error) {
        logger.debug("Could not apply label expression.", {
            expression: expression,
            error: String(error)
        }, "sabsa.matrix.label_expression.skipped");
    }
}

function tryApplyTextPosition(visual, position) {
    try {
        visual.textPosition = position;
    } catch (error) {
        logger.debug("Could not apply text position.", {
            position: position,
            error: String(error)
        }, "sabsa.matrix.text_position.skipped");
    }
}

function addStyledVisual(container, concept, x, y, width, height, fillColor) {
    var visual = container.add(concept, x, y, width, height);
    styleVisual(visual, fillColor);
    return visual;
}

function addNoteVisual(container, text, x, y, width, height, fillColor) {
    var note = container.createObject("note", x, y, width, height);
    note.text = text;
    styleVisual(note, fillColor);
    tryApplyLabelExpression(note, "${content}");
    tryApplyTextPosition(note, 1);
    return note;
}

function getRowFill(rowId) {
    return CONST.Style.RowFillById[rowId] || "#f0f0f0";
}

function estimateTextHeight(text, width, minHeight, charactersPerLine, lineHeight, verticalPadding) {
    var rawText = trim(text);
    var usableWidth = Math.max(24, width - 6);
    var logicalLines = 0;
    var fontMetrics = measurementGraphics.getFontMetrics(measurementFont);
    var computedLineHeight = Math.max(lineHeight, fontMetrics.getHeight());
    var paragraphs;

    if (!rawText) {
        return Math.max(minHeight, verticalPadding + computedLineHeight);
    }

    paragraphs = rawText.split(/\r?\n/);

    paragraphs.forEach(function (paragraph) {
        var words = trim(paragraph).split(/\s+/).filter(function (word) {
            return !!word;
        });
        var currentLine = "";

        if (!words.length) {
            logicalLines += 1;
            return;
        }

        words.forEach(function (word) {
            var candidateLine = currentLine ? currentLine + " " + word : word;
            var candidateWidth = fontMetrics.stringWidth(candidateLine);

            if (candidateWidth <= usableWidth) {
                currentLine = candidateLine;
                return;
            }

            if (currentLine) {
                logicalLines += 1;
                currentLine = word;
                return;
            }

            logicalLines += Math.max(1, Math.ceil(fontMetrics.stringWidth(word) / usableWidth));
            currentLine = "";
        });

        if (currentLine) {
            logicalLines += 1;
        }
    });

    return Math.max(minHeight, verticalPadding + (logicalLines * computedLineHeight));
}

function estimateRepresentationHeight(text, width) {
    return estimateTextHeight(text, width, 36, 5.4, 18, 18);
}

function estimateCellHeaderHeight(text) {
    var availableWidth = CONST.Layout.CellWidth - CONST.Layout.CellInnerX - CONST.Layout.CellInnerRight;

    return estimateTextHeight(
        text,
        availableWidth,
        CONST.Layout.CellHeaderMinReserve,
        6.5,
        16,
        10
    );
}

function getCellContentStartY(cellData) {
    return estimateCellHeaderHeight(cellData.title) + CONST.Layout.CellHeaderGap;
}

function getCellHeight(cellData) {
    var availableWidth = CONST.Layout.CellWidth - CONST.Layout.CellInnerX - CONST.Layout.CellInnerRight;
    var contentHeight = getCellContentStartY(cellData) + CONST.Layout.CellInnerY;

    cellData.items.forEach(function (itemData, index) {
        contentHeight += estimateRepresentationHeight(itemData.text, availableWidth);

        if (index < cellData.items.length - 1) {
            contentHeight += CONST.Layout.RepresentationGap;
        }
    });

    contentHeight += CONST.Layout.CellInnerBottom + CONST.Layout.RepresentationBottomReserve;

    return Math.max(CONST.Layout.CellMinHeight, contentHeight);
}

function getLegacyRowNamespace(matrixData, rowId) {
    if (safeString(matrixData.generationNamespace) === "sabsa-management-matrix" &&
        safeString(rowId) === "management-architecture") {
        return "sabsa-architecture-matrix";
    }

    return safeString(matrixData.generationNamespace);
}

function buildLegacyColumnPropertyId(matrixData, columnId) {
    return [safeString(matrixData.generationNamespace), "column", safeString(columnId)].join(":");
}

function buildLegacyRowPropertyId(matrixData, rowId) {
    return [getLegacyRowNamespace(matrixData, rowId), "row", safeString(rowId)].join(":");
}

function buildLegacyCellPropertyId(matrixData, rowId, columnId) {
    return [getLegacyRowNamespace(matrixData, rowId), "cell", safeString(rowId), safeString(columnId)].join(":");
}

function getCellConceptType() {
    return "work-package";
}

function getCellKind() {
    return "WorkPackage";
}

function getMatrixStartX() {
    return CONST.Layout.StartX + CONST.Layout.ScopeWidth + CONST.Layout.ScopeGap;
}

function getRowScopeKey(rowData) {
    var rowId = safeString(rowData && rowData.id);

    if (rowId === "contextual-architecture" || rowId === "conceptual-architecture") {
        return "strategy";
    }
    if (rowId === "logical-architecture" || rowId === "physical-architecture" || rowId === "component-architecture") {
        return "design";
    }
    return "";
}

function getScopeText(scopeKey) {
    if (scopeKey === "strategy") {
        return "Strategy & Planning Phase";
    }
    if (scopeKey === "design") {
        return "Design Phase";
    }
    return "";
}

function getScopeFill(scopeKey) {
    return scopeKey === "strategy"
        ? CONST.Style.ScopeStrategyFill
        : CONST.Style.ScopeDesignFill;
}

function addScopeBand(view, matrixData, scopeRows, scopeKey) {
    var firstRow = scopeRows && scopeRows.length ? scopeRows[0] : null;
    var lastRow = scopeRows && scopeRows.length ? scopeRows[scopeRows.length - 1] : null;
    var scopeText = getScopeText(scopeKey);
    var scopeKeyValue = [safeString(matrixData.generationNamespace), "scope", scopeKey].join(":");
    var scopeConcept;
    var scopeVisual;

    if (!firstRow || !lastRow || !scopeText) {
        return;
    }

    scopeConcept = ensureConcept("grouping", scopeText, scopeKeyValue, {
        id: scopeKeyValue,
        SabsaMatrixKind: "Scope",
        ConceptId: scopeKeyValue,
        ScopeKey: scopeKey,
        ScopeTitle: scopeText
    }, scopeText);

    scopeVisual = addStyledVisual(
        view,
        scopeConcept,
        CONST.Layout.StartX,
        firstRow.y,
        CONST.Layout.ScopeWidth,
        (lastRow.y + lastRow.height) - firstRow.y,
        getScopeFill(scopeKey)
    );
    scopeVisual.fontColor = CONST.Style.ScopeFontColor;
    tryApplyLabelExpression(scopeVisual, "${name}");
    tryApplyTextPosition(scopeVisual, 1);

    scopeRows.forEach(function (rowBound) {
        ensureRelationship("aggregation-relationship", scopeConcept, rowBound.concept, [
            "aggregation",
            scopeKeyValue,
            rowBound.key
        ].join(":"), {
            SabsaMatrixKind: "ScopeToRow",
            ScopeKey: scopeKey,
            ScopeTitle: scopeText,
            RowId: rowBound.data.id
        });
        stats.relationships++;
    });
}

function addScopeBands(view, matrixData, rowBounds) {
    var activeScope = "";
    var scopeRows = [];

    function flushScope() {
        addScopeBand(view, matrixData, scopeRows, activeScope);
        activeScope = "";
        scopeRows = [];
    }

    (rowBounds || []).forEach(function (rowBound) {
        var scopeKey = getRowScopeKey(rowBound.data);

        if (!scopeKey) {
            flushScope();
            return;
        }

        if (activeScope && activeScope !== scopeKey) {
            flushScope();
        }

        if (!activeScope) {
            activeScope = scopeKey;
        }

        scopeRows.push(rowBound);
    });

    flushScope();
}

function createRepresentationVisuals(cellVisual, rowData, cellData, startY) {
    var availableWidth = CONST.Layout.CellWidth - CONST.Layout.CellInnerX - CONST.Layout.CellInnerRight;
    var currentY = startY;

    cellData.items.forEach(function (itemData, index) {
        var itemText = itemData.text;
        var representationKey = safeString(itemData.id) || [
            "representation",
            rowData.id,
            cellData.columnId,
            index + 1
        ].join(":");
        var representationConcept = ensureConcept("representation", itemText, representationKey, {
            id: safeString(itemData.id) || representationKey,
            SabsaMatrixKind: "Representation",
            ItemId: safeString(itemData.id) || representationKey,
            RowId: rowData.id,
            RowTitle: rowData.title,
            ColumnId: cellData.columnId,
            ColumnTitle: cellData.columnTitle,
            CellTitle: cellData.title,
            ItemOrder: String(index + 1)
        }, itemText, function () {
            return findRepresentationConcept(rowData, cellData, itemData, index);
        });
        var representationHeight = estimateRepresentationHeight(itemText, availableWidth);

        ensureRelationship("aggregation-relationship", cellData.concept, representationConcept, [
            "aggregation",
            cellData.key,
            representationKey
        ].join(":"), {
            SabsaMatrixKind: "CellToRepresentation",
            RowId: rowData.id,
            ColumnId: cellData.columnId
        });

        var representationVisual = addStyledVisual(
            cellVisual,
            representationConcept,
            CONST.Layout.CellInnerX,
            currentY,
            availableWidth,
            representationHeight,
            CONST.Style.RepresentationFill
        );
        tryApplyLabelExpression(representationVisual, "${name}");
        tryApplyTextPosition(representationVisual, 1);

        representationConcept.documentation = itemText;
        currentY += representationHeight + CONST.Layout.RepresentationGap;
        stats.representations++;
        stats.relationships++;
    });

    logger.debug("Prepared cell representations.", {
        row_id: rowData.id,
        column_id: cellData.columnId,
        cell_title: cellData.title,
        representation_count: cellData.items.length
    }, "sabsa.matrix.cell.representations");
}

function createMatrixView(matrixData) {
    var totalColumnsWidth = (matrixData.columns.length * CONST.Layout.ColumnWidth) +
        ((matrixData.columns.length - 1) * CONST.Layout.ColumnGap);
    var matrixStartX = getMatrixStartX();
    var cellAreaStartX = matrixStartX + CONST.Layout.RowHeaderWidth + CONST.Layout.RowHeaderGap;
    var viewName = buildUniqueViewName(CONST.ViewName);
    var view = model.createArchimateView(viewName);
    var rowY = CONST.Layout.RowStartY;
    var rowBounds = [];

    view.documentation = "Generated from sabsa-architecture-matrix-data.json. English labels only. Cell work packages contain representation elements for each bullet item.";
    moveViewToSabsaFolder(view);

    matrixData.columns.forEach(function (column, index) {
        var columnKey = safeString(column.conceptKey) || ("column:" + column.id);
        var columnConcept = ensureConcept("grouping", column.title, columnKey, {
            id: column.id,
            __legacyPropertyIds: [buildLegacyColumnPropertyId(matrixData, column.id)],
            SabsaMatrixKind: "Column",
            ConceptId: columnKey,
            ColumnId: column.id,
            ColumnTitle: column.title
        }, column.title);
        var x = cellAreaStartX + (index * (CONST.Layout.ColumnWidth + CONST.Layout.ColumnGap));

        var columnVisual = addStyledVisual(
            view,
            columnConcept,
            x,
            CONST.Layout.ColumnY,
            CONST.Layout.ColumnWidth,
            CONST.Layout.ColumnHeight,
            CONST.Style.ColumnFill
        );
        tryApplyLabelExpression(columnVisual, "${name}");
        tryApplyTextPosition(columnVisual, 1);

        stats.columns++;
    });

    matrixData.rows.forEach(function (rowData) {
        var rowKey = safeString(rowData.conceptKey) || ("row:" + rowData.id);
        var rowConcept = ensureConcept("grouping", rowData.title, rowKey, {
            id: rowData.id,
            __legacyPropertyIds: [buildLegacyRowPropertyId(matrixData, rowData.id)],
            SabsaMatrixKind: "Row",
            ConceptId: rowKey,
            RowId: rowData.id,
            RowTitle: rowData.title
        }, rowData.title);
        var rowCellHeight = Math.max.apply(null, rowData.cells.map(getCellHeight));
        var rowHeight = CONST.Layout.RowHeaderReserve +
            CONST.Layout.RowInsetY +
            rowCellHeight +
            CONST.Layout.RowBottomPadding;
        var rowVisual = addStyledVisual(
            view,
            rowConcept,
            matrixStartX,
            rowY,
            CONST.Layout.RowHeaderWidth + CONST.Layout.RowHeaderGap + totalColumnsWidth + CONST.Layout.RowInsetX + CONST.Layout.RowRightInset,
            rowHeight,
            getRowFill(rowData.id)
        );
        tryApplyLabelExpression(rowVisual, "${name}");
        tryApplyTextPosition(rowVisual, 0);

        stats.rows++;
        rowBounds.push({
            key: rowKey,
            concept: rowConcept,
            data: rowData,
            y: rowY,
            height: rowHeight
        });
        logger.info("Rendering row.", {
            row_id: rowData.id,
            row_title: rowData.title,
            row_height: rowHeight,
            cell_count: rowData.cells.length
        }, "sabsa.matrix.row.render");

        rowData.cells.forEach(function (cellData, columnIndex) {
            var cellKey = safeString(cellData.conceptKey) || ("cell:" + rowData.id + ":" + cellData.columnId);
            var columnKey = safeString(cellData.columnConceptKey) || ("column:" + cellData.columnId);
            var columnConcept = findConceptByTypeAndKey("grouping", columnKey);
            var cellConceptType = getCellConceptType(rowData);
            var cellKind = getCellKind(rowData);
            var cellConcept = ensureConcept(cellConceptType, cellData.title, cellKey, {
                id: safeString(cellData.id || cellData.key),
                __legacyPropertyIds: [buildLegacyCellPropertyId(matrixData, rowData.id, cellData.columnId)],
                SabsaMatrixKind: cellKind,
                ConceptId: cellKey,
                RowId: rowData.id,
                RowTitle: rowData.title,
                ColumnId: cellData.columnId,
                ColumnTitle: cellData.columnTitle,
                CellTitle: cellData.title
            }, cellData.title);
            var cellVisual = addStyledVisual(
                rowVisual,
                cellConcept,
                CONST.Layout.RowHeaderWidth + CONST.Layout.RowHeaderGap + CONST.Layout.RowInsetX + (columnIndex * (CONST.Layout.CellWidth + CONST.Layout.ColumnGap)),
                CONST.Layout.RowHeaderReserve + CONST.Layout.RowInsetY,
                CONST.Layout.CellWidth,
                rowCellHeight,
                CONST.Style.CellFill
            );
            tryApplyLabelExpression(cellVisual, "${name}");
            tryApplyTextPosition(cellVisual, 0);

            cellData.concept = cellConcept;

            ensureRelationship("aggregation-relationship", rowConcept, cellConcept, [
                "aggregation",
                rowKey,
                cellKey
            ].join(":"), {
                SabsaMatrixKind: "RowToWorkPackage",
                RowId: rowData.id
            });
            stats.relationships++;

            if (columnConcept) {
                ensureRelationship("aggregation-relationship", columnConcept, cellConcept, [
                    "aggregation",
                    columnKey,
                    cellKey
                ].join(":"), {
                    SabsaMatrixKind: "ColumnToWorkPackage",
                    RowId: rowData.id,
                    ColumnId: cellData.columnId
                });
                stats.relationships++;
            }

            createRepresentationVisuals(
                cellVisual,
                rowData,
                cellData,
                getCellContentStartY(cellData) + CONST.Layout.CellInnerY
            );
            stats.cells++;
            logger.debug("Rendered cell.", {
                row_id: rowData.id,
                column_id: cellData.columnId,
                cell_key: cellKey,
                cell_title: cellData.title,
                cell_height: rowCellHeight
            }, "sabsa.matrix.cell.render");
        });

        rowY += rowHeight + CONST.Layout.RowGap;
    });

    addScopeBands(view, matrixData, rowBounds);

    return view;
}

function validateMatrixData(matrixData) {
    if (!matrixData.columns.length || !matrixData.rows.length) {
        throw new Error("The SABSA matrix source did not yield any rows or columns.");
    }

    matrixData.rows.forEach(function (rowData) {
        if (rowData.cells.length !== matrixData.columns.length) {
            throw new Error("Row '" + rowData.title + "' has " + rowData.cells.length +
                " cells, but " + matrixData.columns.length + " columns were expected.");
        }
    });

    matrixData.rows.forEach(function (rowData) {
        rowData.cells.forEach(function (cellData) {
            var matchingColumn = matrixData.columns.filter(function (column) {
                return safeString(column.id) === safeString(cellData.columnId);
            })[0];

            if (!matchingColumn) {
                throw new Error("Cell '" + cellData.key + "' references unknown column id '" + cellData.columnId + "'.");
            }

            cellData.columnTitle = matchingColumn.title;
            cellData.columnConceptKey = matchingColumn.conceptKey;
        });
    });

    logger.info("Validated SABSA matrix data.", {
        columns: matrixData.columns.length,
        rows: matrixData.rows.length
    }, "sabsa.matrix.source.validated");
}

function confirmExecution(matrixData) {
    return dialogs.confirmInfo(
        "This script will generate or update the SABSA Architecture Matrix view." +
        "\n\nSource JSON: " + CONST.SourceJsonPath +
        "\nColumns: " + matrixData.columns.length +
        "\nRows: " + matrixData.rows.length +
        "\n\nThe script will create or reuse folders, concepts, relationships, and the target view in the open Archi model." +
        "\n\nDo you want to continue?",
        "Run SABSA Architecture Matrix Generator"
    );
}

function buildResultMessage(view) {
    return "Generated view: " + view.name +
        "\nRows: " + stats.rows +
        "\nColumns: " + stats.columns +
        "\nCells: " + stats.cells +
        "\nRepresentations: " + stats.representations +
        "\nRelationships: " + stats.relationships +
        "\nConcepts created: " + stats.conceptsCreated +
        "\nConcepts reused: " + stats.conceptsReused +
        "\nRelationships created: " + stats.relationshipsCreated +
        "\nRelationships reused: " + stats.relationshipsReused;
}

function registerSabsaOverview(view) {
    SabsaOverview.register({
        key: "matrices:architecture-matrix",
        title: "SABSA Architecture Matrix",
        level: "Matrices",
        family: "Architecture Matrix",
        area: "SABSA Matrix",
        description: "Generated Architecture Matrix with rows, columns and cell representations.",
        viewNames: [view.name],
        scriptPath: "scripts/SABSA/Matrices/Generate_SABSA_Architecture_Matrix_View.ajs",
        sourcePath: CONST.SourceJsonPath,
        sortKey: "02-matrices:01-architecture"
    });
}

function main() {
    var sourceText;
    var matrixData;
    var view;

    if (!model) {
        throw new Error("No active model is open.");
    }

    logger.start("SABSA architecture matrix view generation started.", {
        source_json: CONST.SourceJsonPath
    });

    sourceText = readUtf8Text(CONST.SourceJsonPath);
    matrixData = parseMatrixFromJson(sourceText);
    validateMatrixData(matrixData);

    if (!confirmExecution(matrixData)) {
        logger.info("SABSA architecture matrix generation cancelled by user.", {
            source_json: CONST.SourceJsonPath
        }, "sabsa.matrix.generation.cancelled");
        return;
    }

    view = createMatrixView(matrixData);
    registerSabsaOverview(view);

    logger.finish("SABSA architecture matrix view generation finished.", {
        view_name: view.name,
        rows_created_or_reused: stats.rows,
        columns_created_or_reused: stats.columns,
        cells_created_or_reused: stats.cells,
        representations_created_or_reused: stats.representations,
        relationships_created_or_reused: stats.relationships,
        concepts_created: stats.conceptsCreated,
        concepts_reused: stats.conceptsReused,
        relationships_created: stats.relationshipsCreated,
        relationships_reused: stats.relationshipsReused
    });

    dialogs.showInfo(buildResultMessage(view), "SABSA Architecture Matrix View");
}

main();
