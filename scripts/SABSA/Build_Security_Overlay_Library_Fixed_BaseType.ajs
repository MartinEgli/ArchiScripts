/*
===============================================================================
Build Security Overlay Library
===============================================================================

Creates:
- Overview
- Overlay Type Model
- Overlay Template Library

Also writes:
- template index JSON to a model property
- relationship type index JSON to a model property

Conceptual split:
- Overlay Type Model = types, no specialization
- Overlay Template Library = templates, with specialization
===============================================================================
*/

console.show();
console.clear();

/* ============================================================================
 * Constants
 * ========================================================================== */

var CONST = {
    ScriptName: "Build Security Overlay Library",
    Namespace: "SecurityOverlay",
    Kind: {
        OverlayType: "OverlayType",
        RelationshipType: "RelationshipType",
        Template: "Template",
        TypedElement: "TypedElement"
    },
    Property: {
        Namespace: "Namespace",
        Kind: "Kind",
        BaseType: "BaseType",
        Category: "Category",
        TypeName: "TypeName",
        ConceptType: "ConceptType",
        Stereotype: "Stereotype",
        DefaultLabelExpression: "DefaultLabelExpression",
        TemplateIndexJson: "SecurityOverlayTemplateIndexJson",
        RelationshipIndexJson: "SecurityOverlayRelationshipIndexJson"
    },
    LabelExpression: {
        OverlayType: "«Overlay Type»\n${name}",
        Template: "«${specialization}»\n${name}",
        TemplateLibrary: "«${specialization}»\n${name}\n${property:BaseType}"
    },
    View: {
        Overview: "Overview",
        OverlayTypeModel: "Overlay Type Model",
        OverlayTemplateLibrary: "Overlay Template Library"
    },
    Layout: {
        Margin: 20,
        HeaderX: 20,
        HeaderY: 20,
        HeaderWidth: 980,
        HeaderHeight: 90,
        GroupX: 20,
        GroupY: 130,
        GroupWidth: 1450,
        GroupInnerX: 20,
        GroupInnerY: 30,
        CardWidth: 250,
        CardHeight: 90,
        CardGapX: 20,
        CardGapY: 20,
        GroupColumns: 4,
        OverviewCardWidth: 620,
        OverviewCardHeight: 100,
        OverviewGapX: 700,
        OverviewGapY: 170
    },
    Color: {
        Header: "#EEF5FF",
        Group: "#F9F9F9",
        TypeGroup: "#EAF0FF",
        TemplateGroup: "#F8F5EA",
        Element: "#FFFFFF",
        Line: "#666666",
        Font: "#000000"
    },
    Message: {
        SuccessTitle: "Security Overlay Library",
        ErrorTitle: "Security Overlay Library - Error"
    }
};

/* ============================================================================
 * Definitions
 * ========================================================================== */

var OVERLAY_ELEMENT_TYPES = [
    { category: "Motivation And Compliance", name: "Loss", baseType: "Value", conceptTypes: ["value"], description: "Loss as the counterpart to value.", defaults: {} },
    { category: "Motivation And Compliance", name: "Value Chain", baseType: "Value", conceptTypes: ["value"], description: "Value chain decomposition.", defaults: {} },
    { category: "Motivation And Compliance", name: "SABSA Attribute", baseType: "Principle", conceptTypes: ["principle"], description: "SABSA business attribute.", defaults: {} },
    { category: "Motivation And Compliance", name: "Business Policy", baseType: "Principle", conceptTypes: ["principle"], description: "Business policy principle.", defaults: {} },
    { category: "Motivation And Compliance", name: "Trust", baseType: "Principle", conceptTypes: ["principle"], description: "Explicit trust statement.", defaults: { Directionality: "Forward" } },
    { category: "Motivation And Compliance", name: "Article", baseType: "Principle", conceptTypes: ["principle"], description: "Article from a law or regulation.", defaults: {} },
    { category: "Motivation And Compliance", name: "Mandate", baseType: "Principle", conceptTypes: ["principle"], description: "Mandate from a standard or framework.", defaults: {} },
    { category: "Motivation And Compliance", name: "Risk", baseType: "Assessment", conceptTypes: ["assessment"], description: "Evaluated risk.", defaults: {} },
    { category: "Motivation And Compliance", name: "Vulnerability", baseType: "Assessment", conceptTypes: ["assessment"], description: "Evaluated vulnerability.", defaults: {} },
    { category: "Motivation And Compliance", name: "Control Objective", baseType: "Goal", conceptTypes: ["goal"], description: "Security control objective.", defaults: {} },
    { category: "Motivation And Compliance", name: "Compliance Objective", baseType: "Goal", conceptTypes: ["goal"], description: "Compliance objective.", defaults: {} },
    { category: "Motivation And Compliance", name: "Control Measure", baseType: "Requirement", conceptTypes: ["requirement"], description: "Required control measure.", defaults: {} },
    { category: "Motivation And Compliance", name: "Exception", baseType: "Requirement", conceptTypes: ["requirement"], description: "Approved exception.", defaults: {} },

    { category: "Context And Domains", name: "Threat Agent", baseType: "Business Actor", conceptTypes: ["business-actor"], description: "Threat actor.", defaults: { Type: "Human" } },
    { category: "Context And Domains", name: "Threat Event", baseType: "Business Event", conceptTypes: ["business-event"], description: "Threat event.", defaults: {} },
    { category: "Context And Domains", name: "Loss Event", baseType: "Business Event", conceptTypes: ["business-event"], description: "Loss event.", defaults: {} },
    { category: "Context And Domains", name: "SecurityDomain", baseType: "Grouping", conceptTypes: ["grouping"], description: "Explicit security domain.", defaults: { IsSecurityDomain: "True" } },

    { category: "Conceptual Security Architecture", name: "Principal", baseType: "Business Actor", conceptTypes: ["business-actor"], description: "Conceptual principal.", defaults: { IdentityAssurance: "" } },
    { category: "Conceptual Security Architecture", name: "Authorisation", baseType: "Business Role", conceptTypes: ["business-role"], description: "Conceptual authorisation.", defaults: { RecertificationPeriod: "", Owner: "" } },
    { category: "Conceptual Security Architecture", name: "Credential", baseType: "Business Object", conceptTypes: ["business-object"], description: "Conceptual credential.", defaults: { AuthenticationAssurance: "", ValidityPeriod: "" } },
    { category: "Conceptual Security Architecture", name: "SecurityEvent", baseType: "Business Event | Application Event | Technology Event", conceptTypes: ["business-event", "application-event", "technology-event"], description: "Security-relevant event across layers.", defaults: { Security: "True", Criticality: "" } },

    { category: "Logical Security Architecture", name: "Security Configuration", baseType: "Data Object", conceptTypes: ["data-object"], description: "Security configuration profile or setting.", defaults: { ExampleSetting: "Enabled" } },
    { category: "Logical Security Architecture", name: "Malware", baseType: "Application Component", conceptTypes: ["application-component"], description: "Malicious software component.", defaults: { Type: "Trojan" } },

    { category: "Technical And Physical Security Architecture", name: "Executable", baseType: "Artefact", conceptTypes: ["artifact"], description: "Executable artefact.", defaults: { Type: "File" } },
    { category: "Technical And Physical Security Architecture", name: "Data", baseType: "Artefact", conceptTypes: ["artifact"], description: "Technical data artefact.", defaults: { Type: "DatabaseTable" } },
    { category: "Technical And Physical Security Architecture", name: "Defect", baseType: "Assessment", conceptTypes: ["assessment"], description: "Concrete defect or finding.", defaults: {} },
    { category: "Technical And Physical Security Architecture", name: "HSM", baseType: "Node", conceptTypes: ["node"], description: "Hardware security module.", defaults: {} },
    { category: "Technical And Physical Security Architecture", name: "VPN Gateway", baseType: "Node", conceptTypes: ["node"], description: "Virtual private network gateway.", defaults: {} },

    { category: "Control Polymorphism", name: "Control", baseType: "Principle | Business Process | Application Service | Node", conceptTypes: ["principle", "business-process", "application-service", "node"], description: "Polymorphic control concept.", defaults: {} }
];

var OVERLAY_RELATIONSHIP_TYPES = [
    { category: "Relationship Types", name: "Conceptualisation", baseType: "Association Relationship", conceptTypes: ["association-relationship"], description: "From a business concept to a conceptual security concept." },
    { category: "Relationship Types", name: "Realisation", baseType: "Association Relationship", conceptTypes: ["association-relationship"], description: "From a conceptual concept to a logical or technical concept." },
    { category: "Relationship Types", name: "RACI", baseType: "Association Relationship", conceptTypes: ["association-relationship"], description: "Responsibility assignment relationship." },
    { category: "Relationship Types", name: "exploits", baseType: "Association Relationship", conceptTypes: ["association-relationship"], description: "Threat or actor exploits a vulnerability." },
    { category: "Relationship Types", name: "materialises", baseType: "Association Relationship", conceptTypes: ["association-relationship"], description: "Loss event materialises risk." },
    { category: "Relationship Types", name: "trusts", baseType: "Flow Relationship", conceptTypes: ["flow-relationship"], description: "Trust flow between parties." }
];

/* ============================================================================
 * Logging and Messages
 * ========================================================================== */

function logInfo(message) {
    console.log("[INFO] " + message);
}

function logWarn(message) {
    console.log("[WARNING] " + message);
}

function logError(message) {
    console.log("[ERROR] " + message);
}

function showMessage(title, message, level) {
    try {
        var JOptionPane = Java.type("javax.swing.JOptionPane");
        var iconType = JOptionPane.INFORMATION_MESSAGE;

        if (level === "ERROR") {
            iconType = JOptionPane.ERROR_MESSAGE;
        }

        JOptionPane.showMessageDialog(null, message, title, iconType);
    } catch (error) {
        console.log("[" + title + "] " + message);
    }
}

/* ============================================================================
 * Helpers
 * ========================================================================== */

function ensureModelAvailable() {
    if (!model) {
        throw new Error("No active model is open.");
    }
}

function pad(value) {
    return value < 10 ? "0" + value : "" + value;
}

function timestamp() {
    var now = new Date();
    return now.getFullYear()
        + "-" + pad(now.getMonth() + 1)
        + "-" + pad(now.getDate())
        + " "
        + pad(now.getHours())
        + "-" + pad(now.getMinutes())
        + "-" + pad(now.getSeconds());
}

function setProperties(concept, properties) {
    for (var key in properties) {
        if (properties.hasOwnProperty(key)) {
            concept.prop(key, String(properties[key]));
        }
    }
}

function styleVisual(visual, fillColor) {
    if (fillColor) {
        visual.fillColor = fillColor;
    }
    visual.lineColor = CONST.Color.Line;
    visual.fontColor = CONST.Color.Font;
}

function tryApplyLabelExpression(visual, expression) {
    try {
        visual.labelExpression = expression;
    } catch (error) {
        logWarn("Could not apply label expression: " + expression);
    }
}

function createView(name, documentation) {
    var view = model.createArchimateView(name);
    view.documentation = documentation || "";
    return view;
}

function addNote(container, text, x, y, width, height, fillColor) {
    var note = container.createObject("note", x, y, width, height);
    note.text = text;
    styleVisual(note, fillColor);
    return note;
}

function addGroup(view, name, x, y, width, height, fillColor) {
    var group = view.createObject("group", x, y, width, height);
    group.name = name;
    styleVisual(group, fillColor);
    return group;
}

function addConcept(container, concept, x, y, width, height, fillColor, labelExpression) {
    var visual = container.add(concept, x, y, width, height);
    styleVisual(visual, fillColor);
    if (labelExpression) {
        tryApplyLabelExpression(visual, labelExpression);
    }
    return visual;
}

function distinctCategories(definitions) {
    var seen = {};
    var result = [];

    definitions.forEach(function (definition) {
        if (!seen[definition.category]) {
            seen[definition.category] = true;
            result.push(definition.category);
        }
    });

    return result;
}

function byCategory(definitions, category) {
    return definitions.filter(function (definition) {
        return definition.category === category;
    });
}

function calculateGroupHeight(itemCount, columns) {
    var rows = Math.max(1, Math.ceil(itemCount / columns));
    return CONST.Layout.GroupInnerY
        + (rows * CONST.Layout.CardHeight)
        + ((rows - 1) * CONST.Layout.CardGapY)
        + CONST.Layout.Margin;
}

function calculateGroupY(previousY, previousHeight) {
    return previousY + previousHeight + CONST.Layout.Margin;
}

/* ============================================================================
 * Specializations
 * ========================================================================== */

function tryCreateSpecialization(name, conceptType) {
    try {
        model.createSpecialization(name, conceptType);
        logInfo("Created specialization: " + name + " for type " + conceptType);
    } catch (error) {
        logWarn("Skipped specialization " + name + " for type " + conceptType + ". It may already exist.");
    }
}

function ensureSpecializations() {
    OVERLAY_ELEMENT_TYPES.forEach(function (definition) {
        definition.conceptTypes.forEach(function (conceptType) {
            tryCreateSpecialization(definition.name, conceptType);
        });
    });

    OVERLAY_RELATIONSHIP_TYPES.forEach(function (definition) {
        definition.conceptTypes.forEach(function (conceptType) {
            tryCreateSpecialization(definition.name, conceptType);
        });
    });
}

/* ============================================================================
 * Builders
 * ========================================================================== */

function normalizeBaseTypeToConceptType(baseType) {
    if (!baseType) {
        return null;
    }

    var firstBaseType = String(baseType).split("|")[0].trim();

    var aliases = {
        "Artefact": "artifact"
    };

    if (aliases[firstBaseType]) {
        return aliases[firstBaseType];
    }

    return firstBaseType.toLowerCase().replace(/\s+/g, "-");
}

function resolveTypeCardConceptType(definition) {
    var normalizedBaseType = normalizeBaseTypeToConceptType(definition.baseType);

    if (normalizedBaseType) {
        return normalizedBaseType;
    }

    if (definition.conceptTypes && definition.conceptTypes.length > 0) {
        return definition.conceptTypes[0];
    }

    return "grouping";
}

function createTypeCard(definition, kindValue) {
    var conceptType = resolveTypeCardConceptType(definition);
    var concept = model.createElement(conceptType, definition.name);
    concept.documentation = definition.description;

    setProperties(concept, {
        Namespace: CONST.Namespace,
        Kind: kindValue,
        BaseType: definition.baseType,
        Category: definition.category,
        TypeName: definition.name
    });

    if (definition.conceptTypes && definition.conceptTypes.length > 1) {
        concept.prop("ConceptTypeOptions", definition.conceptTypes.join(" | "));
    }

    return concept;
}

function createTemplateCard(definition, conceptType) {
    var concept = model.createElement(conceptType, definition.name);
    concept.specialization = definition.name;
    concept.documentation = definition.description;

    var properties = {
        Namespace: CONST.Namespace,
        Kind: CONST.Kind.Template,
        BaseType: definition.baseType,
        Category: definition.category,
        TypeName: definition.name,
        ConceptType: conceptType,
        Stereotype: "«" + definition.name + "»",
        DefaultLabelExpression: CONST.LabelExpression.Template
    };

    for (var key in definition.defaults) {
        if (definition.defaults.hasOwnProperty(key)) {
            properties[key] = definition.defaults[key];
        }
    }

    setProperties(concept, properties);
    return concept;
}

function buildOverview(viewPrefix) {
    var view = createView(viewPrefix + CONST.View.Overview, "Overview for the Security Overlay structure.");

    addNote(
        view,
        "Security Overlay Overview\n" +
        "This script creates an Overlay Type Model and an Overlay Template Library.\n" +
        "Important note: specializations remain model-wide in the same model.",
        CONST.Layout.HeaderX,
        CONST.Layout.HeaderY,
        CONST.Layout.HeaderWidth,
        CONST.Layout.HeaderHeight,
        CONST.Color.Header
    );

    var group = addGroup(
        view,
        "Created Views",
        CONST.Layout.GroupX,
        CONST.Layout.GroupY,
        CONST.Layout.GroupWidth,
        300,
        CONST.Color.Group
    );

    [CONST.View.OverlayTypeModel, CONST.View.OverlayTemplateLibrary].forEach(function (name, index) {
        var row = Math.floor(index / 2);
        var col = index % 2;
        var x = CONST.Layout.GroupInnerX + (col * CONST.Layout.OverviewGapX);
        var y = CONST.Layout.GroupInnerY + (row * CONST.Layout.OverviewGapY);

        addNote(
            group,
            name,
            x,
            y,
            CONST.Layout.OverviewCardWidth,
            CONST.Layout.OverviewCardHeight,
            CONST.Color.Element
        );
    });
}

function buildOverlayTypeModel(viewPrefix) {
    var view = createView(viewPrefix + CONST.View.OverlayTypeModel, "Overlay type model. Types are not specialized.");

    addNote(
        view,
        "Overlay Type Model\nType elements are not specialized.\nRelationship types are included here as type cards.",
        CONST.Layout.HeaderX,
        CONST.Layout.HeaderY,
        CONST.Layout.HeaderWidth,
        CONST.Layout.HeaderHeight,
        CONST.Color.Header
    );

    var combined = OVERLAY_ELEMENT_TYPES.concat(OVERLAY_RELATIONSHIP_TYPES);
    var categories = distinctCategories(combined);

    var currentY = CONST.Layout.GroupY;

    categories.forEach(function (category) {
        var definitions = byCategory(combined, category);
        var groupHeight = calculateGroupHeight(definitions.length, CONST.Layout.GroupColumns);

        var group = addGroup(
            view,
            category,
            CONST.Layout.GroupX,
            currentY,
            CONST.Layout.GroupWidth,
            groupHeight,
            CONST.Color.TypeGroup
        );

        definitions.forEach(function (definition, index) {
            var row = Math.floor(index / CONST.Layout.GroupColumns);
            var col = index % CONST.Layout.GroupColumns;
            var x = CONST.Layout.GroupInnerX + (col * (CONST.Layout.CardWidth + CONST.Layout.CardGapX));
            var y = CONST.Layout.GroupInnerY + (row * (CONST.Layout.CardHeight + CONST.Layout.CardGapY));

            var kindValue = category === "Relationship Types"
                ? CONST.Kind.RelationshipType
                : CONST.Kind.OverlayType;

            var concept = createTypeCard(definition, kindValue);

            addConcept(
                group,
                concept,
                x,
                y,
                CONST.Layout.CardWidth,
                CONST.Layout.CardHeight,
                CONST.Color.Element,
                CONST.LabelExpression.OverlayType
            );
        });

        currentY = calculateGroupY(currentY, groupHeight);
    });
}

function buildOverlayTemplateLibrary(viewPrefix) {
    var view = createView(viewPrefix + CONST.View.OverlayTemplateLibrary, "Overlay template library. Templates are specialized.");

    addNote(
        view,
        "Overlay Template Library\nTemplate elements are specialized and carry the properties used by the apply script.",
        CONST.Layout.HeaderX,
        CONST.Layout.HeaderY,
        CONST.Layout.HeaderWidth,
        CONST.Layout.HeaderHeight,
        CONST.Color.Header
    );

    var categories = distinctCategories(OVERLAY_ELEMENT_TYPES);
    var currentY = CONST.Layout.GroupY;

    categories.forEach(function (category) {
        var definitions = byCategory(OVERLAY_ELEMENT_TYPES, category);

        var templateCount = 0;
        definitions.forEach(function (definition) {
            templateCount += definition.conceptTypes.length;
        });

        var groupHeight = calculateGroupHeight(templateCount, CONST.Layout.GroupColumns);

        var group = addGroup(
            view,
            category,
            CONST.Layout.GroupX,
            currentY,
            CONST.Layout.GroupWidth,
            groupHeight,
            CONST.Color.TemplateGroup
        );

        var visualIndex = 0;

        definitions.forEach(function (definition) {
            definition.conceptTypes.forEach(function (conceptType) {
                var row = Math.floor(visualIndex / CONST.Layout.GroupColumns);
                var col = visualIndex % CONST.Layout.GroupColumns;
                var x = CONST.Layout.GroupInnerX + (col * (CONST.Layout.CardWidth + CONST.Layout.CardGapX));
                var y = CONST.Layout.GroupInnerY + (row * (CONST.Layout.CardHeight + CONST.Layout.CardGapY));

                var concept = createTemplateCard(definition, conceptType);

                addConcept(
                    group,
                    concept,
                    x,
                    y,
                    CONST.Layout.CardWidth,
                    CONST.Layout.CardHeight,
                    CONST.Color.Element,
                    CONST.LabelExpression.TemplateLibrary
                );

                visualIndex++;
            });
        });

        currentY = calculateGroupY(currentY, groupHeight);
    });
}

/* ============================================================================
 * Persistent Index
 * ========================================================================== */

function buildTemplateIndex() {
    var entries = [];

    OVERLAY_ELEMENT_TYPES.forEach(function (definition) {
        definition.conceptTypes.forEach(function (conceptType) {
            entries.push({
                Namespace: CONST.Namespace,
                Kind: CONST.Kind.Template,
                TypeName: definition.name,
                BaseType: definition.baseType,
                Category: definition.category,
                ConceptType: conceptType,
                DefaultLabelExpression: CONST.LabelExpression.Template,
                DefaultProperties: definition.defaults || {}
            });
        });
    });

    return entries;
}

function buildRelationshipIndex() {
    var entries = [];

    OVERLAY_RELATIONSHIP_TYPES.forEach(function (definition) {
        definition.conceptTypes.forEach(function (conceptType) {
            entries.push({
                Namespace: CONST.Namespace,
                Kind: CONST.Kind.RelationshipType,
                TypeName: definition.name,
                BaseType: definition.baseType,
                Category: definition.category,
                ConceptType: conceptType
            });
        });
    });

    return entries;
}

function persistIndexes() {
    var templateIndexJson = JSON.stringify(buildTemplateIndex(), null, 2);
    var relationshipIndexJson = JSON.stringify(buildRelationshipIndex(), null, 2);

    model.prop(CONST.Property.TemplateIndexJson, templateIndexJson);
    model.prop(CONST.Property.RelationshipIndexJson, relationshipIndexJson);

    logInfo("Persisted template and relationship indexes to model properties.");
}

/* ============================================================================
 * Main
 * ========================================================================== */

try {
    ensureModelAvailable();

    var viewPrefix = "Security Overlay " + timestamp() + " - ";

    logInfo("Starting " + CONST.ScriptName + ".");
    logInfo("Target model: " + model.name);

    ensureSpecializations();
    buildOverview(viewPrefix);
    buildOverlayTypeModel(viewPrefix);
    buildOverlayTemplateLibrary(viewPrefix);
    persistIndexes();

    showMessage(
        CONST.Message.SuccessTitle,
        "Security Overlay library created successfully.\n\n" +
        "Views created:\n" +
        "- Overview\n" +
        "- Overlay Type Model\n" +
        "- Overlay Template Library\n\n" +
        "Model properties written:\n" +
        "- " + CONST.Property.TemplateIndexJson + "\n" +
        "- " + CONST.Property.RelationshipIndexJson,
        "INFO"
    );

    logInfo("Finished " + CONST.ScriptName + " successfully.");

} catch (error) {
    var message = "The script failed.\n\n" + (error && error.message ? error.message : String(error));
    logError(message);
    showMessage(CONST.Message.ErrorTitle, message, "ERROR");
    throw error;
}
