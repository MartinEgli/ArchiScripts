/*
 * jArchi Script
 * Security Overlay Metamodel - One Page Builder
 *
 * Was das Skript macht:
 * - erstellt Spezialisierungen fuer die Security Overlay
 * - erzeugt eine neue View
 * - baut visuelle Gruppen fuer die Overlay-Bereiche
 * - legt Beispiel-Elemente mit PascalCase-Properties an
 * - erzeugt einige Beispiel-Beziehungen fuer das Metamodel
 *
 * Wichtige Hinweise:
 * - Das Skript erzeugt bei jedem Lauf neue Elemente und eine neue View.
 * - Es nutzt absichtlich keine Abkuerzungen.
 * - Die Darstellung erfolgt mit <<Stereotyp>>-Notation im Namen.
 * - Fuer <<Control>> werden mehrere Basistypen verwendet, weil Control
 *   laut T100 keinen einzelnen Basistyp hat.
 */

console.show();
console.clear();

if (!model) {
    throw "Kein aktives Modell vorhanden.";
}

function pad(value) {
    return value < 10 ? "0" + value : "" + value;
}

function buildTimestamp() {
    var now = new Date();
    return now.getFullYear()
        + "-" + pad(now.getMonth() + 1)
        + "-" + pad(now.getDate())
        + " "
        + pad(now.getHours())
        + "-" + pad(now.getMinutes())
        + "-" + pad(now.getSeconds());
}

var viewName = "Security Overlay Metamodel " + buildTimestamp();
var view = model.createArchimateView(viewName);
view.documentation = "Automatisch erzeugte Metamodel-View fuer die SABSA Security Overlay.";

function ensureSpecialization(name, conceptType) {
    var existing = null;
    try {
        existing = model.findSpecialization(name, conceptType);
    } catch (error) {
        existing = null;
    }
    if (existing) {
        return existing;
    }
    return model.createSpecialization(name, conceptType);
}

function ensureSpecializations() {
    var specs = [
        // Motivation und Compliance
        { name: "Loss", conceptTypes: ["value"] },
        { name: "Value Chain", conceptTypes: ["value"] },
        { name: "SABSA Attribute", conceptTypes: ["principle"] },
        { name: "Business Policy", conceptTypes: ["principle"] },
        { name: "Trust", conceptTypes: ["principle"] },
        { name: "Article", conceptTypes: ["principle"] },
        { name: "Mandate", conceptTypes: ["principle"] },
        { name: "Risk", conceptTypes: ["assessment"] },
        { name: "Vulnerability", conceptTypes: ["assessment"] },
        { name: "Control Objective", conceptTypes: ["goal"] },
        { name: "Compliance Objective", conceptTypes: ["goal"] },
        { name: "Control Measure", conceptTypes: ["requirement"] },
        { name: "Exception", conceptTypes: ["requirement"] },

        // Kontext
        { name: "Threat Agent", conceptTypes: ["business-actor"] },
        { name: "Threat Event", conceptTypes: ["business-event"] },
        { name: "Loss Event", conceptTypes: ["business-event"] },
        { name: "SecurityDomain", conceptTypes: ["grouping"] },

        // Konzeptuell
        { name: "Principal", conceptTypes: ["business-actor"] },
        { name: "Authorisation", conceptTypes: ["business-role"] },
        { name: "Credential", conceptTypes: ["business-object"] },

        // SecurityEvent in mehreren Basistypen
        { name: "SecurityEvent", conceptTypes: ["business-event", "application-event", "technology-event", "implementation-event"] },

        // Logisch und technisch
        { name: "Security Configuration", conceptTypes: ["data-object"] },
        { name: "Malware", conceptTypes: ["application-component"] },
        { name: "Executable", conceptTypes: ["artifact"] },
        { name: "Data", conceptTypes: ["artifact"] },
        { name: "Defect", conceptTypes: ["assessment"] },
        { name: "HSM", conceptTypes: ["node"] },
        { name: "VPN Gateway", conceptTypes: ["node"] },

        // Control auf mehreren Basistypen
        { name: "Control", conceptTypes: ["principle", "business-process", "application-service", "node"] },

        // Beziehungen
        { name: "Conceptualisation", conceptTypes: ["association-relationship"] },
        { name: "Realisation", conceptTypes: ["association-relationship"] },
        { name: "RACI", conceptTypes: ["association-relationship"] },
        { name: "exploits", conceptTypes: ["association-relationship"] },
        { name: "materialises", conceptTypes: ["association-relationship"] },
        { name: "trusts", conceptTypes: ["flow-relationship"] }
    ];

    for (var i = 0; i < specs.length; i++) {
        var spec = specs[i];
        for (var j = 0; j < spec.conceptTypes.length; j++) {
            ensureSpecialization(spec.name, spec.conceptTypes[j]);
        }
    }
}

ensureSpecializations();

function setProperties(concept, properties) {
    if (!properties) {
        return;
    }
    for (var key in properties) {
        if (properties.hasOwnProperty(key)) {
            concept.prop(key, String(properties[key]));
        }
    }
}

function createElement(type, stereotype, displayName, baseTypeLabel, documentation, properties) {
    var element = model.createElement(type, displayName);
    if (stereotype) {
        element.specialization = stereotype;
        element.prop("Stereotype", "<<" + stereotype + ">>");
    }
    element.prop("BaseType", baseTypeLabel);
    element.documentation = documentation || "";
    setProperties(element, properties);
    return element;
}

function createAssociation(name, stereotype, source, target, properties, directed) {
    var relation = model.createRelationship("association-relationship", name, source, target);
    relation.specialization = stereotype;
    relation.prop("Stereotype", "<<" + stereotype + ">>");
    if (directed) {
        relation.associationDirected = true;
        relation.prop("IsDirected", "True");
    }
    setProperties(relation, properties);
    return relation;
}

function createFlow(name, stereotype, source, target, properties) {
    var relation = model.createRelationship("flow-relationship", name, source, target);
    relation.specialization = stereotype;
    relation.prop("Stereotype", "<<" + stereotype + ">>");
    setProperties(relation, properties);
    return relation;
}

function styleVisual(visual, fillColor, lineColor, fontColor) {
    if (fillColor) {
        visual.fillColor = fillColor;
    }
    if (lineColor) {
        visual.lineColor = lineColor;
    }
    if (fontColor) {
        visual.fontColor = fontColor;
    }
    visual.opacity = 255;
    visual.outlineOpacity = 255;
}

function createGroup(name, x, y, width, height, fillColor) {
    var group = view.createObject("group", x, y, width, height, true);
    group.name = name;
    group.borderType = BORDER.TABBED;
    styleVisual(group, fillColor, "#666666", "#000000");
    return group;
}

function createNote(parent, text, x, y, width, height, fillColor) {
    var note = parent.createObject("note", x, y, width, height, false);
    note.text = text;
    styleVisual(note, fillColor || "#FFF9CC", "#999999", "#000000");
    return note;
}

function addElementToGroup(group, element, x, y, width, height, fillColor) {
    var visual = group.add(element, x, y, width, height);
    styleVisual(visual, fillColor || "#FFFFFF", "#555555", "#000000");
    return visual;
}

function createGrid(group, definitions, startX, startY, columns, boxWidth, boxHeight, gapX, gapY, fillColor) {
    var result = {};
    for (var i = 0; i < definitions.length; i++) {
        var row = Math.floor(i / columns);
        var column = i % columns;
        var x = startX + (column * (boxWidth + gapX));
        var y = startY + (row * (boxHeight + gapY));

        var def = definitions[i];
        var element = createElement(
            def.type,
            def.stereotype,
            def.label,
            def.baseTypeLabel,
            def.documentation,
            def.properties
        );

        result[def.key] = {
            element: element,
            visual: addElementToGroup(group, element, x, y, boxWidth, boxHeight, fillColor)
        };
    }
    return result;
}

